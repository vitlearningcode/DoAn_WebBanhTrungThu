@model WebBanhTrungThu.ViewModels.NhapKhoAdminViewModel

<div class="modal fade" id="modalTaoSuaPhieuNhap" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content kv-modal-content">
            <form id="frmLuuPhieuNhap" asp-area="Admin" asp-controller="NhapKhoAdmin" asp-action="LuuPhieuNhap" method="post" onsubmit="return chuanBiSubmitPhieuNhap();">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaPn" id="pn_MaPn" value="0" />
                <input type="hidden" name="HoanThanhNhapKho" id="pn_HoanThanhNhapKho" value="true" />
                <input type="hidden" name="ChiTietJson" id="pn_ChiTietJson" value="[]" />

                <div class="kv-modal-header pb-2 border-bottom">
                    <div>
                        <h5 class="kv-modal-title" id="pn_ModalTitle">Tạo phiếu nhập hàng (Đa sản phẩm)</h5>
                        <div class="small text-muted" id="pn_ModalSub">Tự động sinh lô FEFO và cập nhật giá vốn, tồn kho sau khi hoàn thành nhập.</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="kv-modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-5">
                            <label class="kv-field-label">Nhà cung cấp / Hãng sản xuất <span class="text-danger">*</span></label>
                            <input type="text" name="NhaCungCap" id="pn_NhaCungCap" list="dlNhaCungCapNhap" class="kv-form-control" required
                                   placeholder="Chọn hoặc nhập tên hãng: Kinh Đô, Như Lan, Brodard..." />
                            <datalist id="dlNhaCungCapNhap">
                                @foreach (var ncc in Model.DanhSachNhaCungCap)
                                {
                                    <option value="@ncc"></option>
                                }
                            </datalist>
                        </div>
                        <div class="col-md-7">
                            <label class="kv-field-label">Ghi chú phiếu nhập</label>
                            <input type="text" name="GhiChu" id="pn_GhiChu" class="kv-form-control" maxlength="500"
                                   placeholder="VD: Nhập lô bánh đợt rằm tháng 8, kiểm đủ số lượng..." />
                        </div>
                    </div>

                    <div id="pn_BoxChonSanPham" class="p-3 rounded mb-3" style="background: #F8FAFC; border: 1px solid #E5E7EB;">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold mb-1">Thêm sản phẩm vào phiếu nhập</label>
                                <select id="pn_ChonSpSelect" class="form-select form-select-sm">
                                    <option value="">-- Chọn bánh trung thu cần nhập --</option>
                                    @foreach (var sp in Model.DanhSachSanPham)
                                    {
                                        <option value="@sp.MaBanh">[@sp.MaSku] @sp.TenBanh (Giá vốn: @sp.GiaVon.ToString("N0") đ | Tồn: @sp.TonKhoHeThong)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn-kv-blue w-100" onclick="themDongTuSelectNhap()">
                                    <i class="bi bi-plus-circle"></i> Thêm dòng hàng
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive mb-3">
                        <table class="kv-comp-table table table-bordered align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 40px;">#</th>
                                    <th>Sản phẩm bánh</th>
                                    <th style="width: 105px;" class="text-center">Số lượng</th>
                                    <th style="width: 140px;" class="text-end">Đơn giá nhập (đ)</th>
                                    <th style="width: 140px;" class="text-center">Ngày SX</th>
                                    <th style="width: 140px;" class="text-center">Hạn sử dụng</th>
                                    <th style="width: 135px;" class="text-end">Thành tiền</th>
                                    <th style="width: 45px;"></th>
                                </tr>
                            </thead>
                            <tbody id="pn_TbodyDongNhap"></tbody>
                        </table>
                    </div>

                    <div class="row g-3 align-items-end pt-2 border-top">
                        <div class="col-md-3">
                            <label class="kv-field-label">Giảm giá hóa đơn (đ)</label>
                            <input type="number" name="GiamGia" id="pn_GiamGia" value="0" min="0" step="1000"
                                   class="kv-form-control text-end fw-semibold" oninput="tinhTongPhieuNhap()" />
                        </div>
                        <div class="col-md-3" id="pn_WrapTraNgay">
                            <label class="kv-field-label">Thanh toán ngay khi nhập (đ)</label>
                            <input type="number" name="SoTienThanhToanNgay" id="pn_TraNgay" value="0" min="0" step="1000"
                                   class="kv-form-control text-end fw-semibold text-success" />
                        </div>
                        <div class="col-md-3" id="pn_WrapPhuongThuc">
                            <label class="kv-field-label">Phương thức chi</label>
                            <select name="PhuongThucThanhToan" id="pn_PhuongThuc" class="form-select">
                                <option value="CHUYEN_KHOAN">Chuyển khoản</option>
                                <option value="TIEN_MAT">Tiền mặt</option>
                            </select>
                        </div>
                        <div class="col-md-3 text-end">
                            <div class="small text-muted">Tổng tiền hàng: <strong id="pn_LblTongTienHang">0 đ</strong></div>
                            <div class="fs-6 fw-bold text-primary mt-1">Phải trả NCC: <span id="pn_LblTongPhaiTra">0 đ</span></div>
                        </div>
                    </div>
                </div>

                <div class="kv-modal-footer">
                    <button type="button" class="btn-kv-outline" data-bs-dismiss="modal">Đóng</button>
                    <div class="d-flex align-items-center gap-2">
                        <button type="submit" id="pn_BtnLuuTam" class="btn-kv-outline" onclick="datCheDoLuuPhieuNhap(false)">
                            <i class="bi bi-save"></i> Lưu phiếu tạm
                        </button>
                        <button type="submit" id="pn_BtnHoanThanh" class="btn-kv-green" onclick="datCheDoLuuPhieuNhap(true)">
                            <i class="bi bi-check2-circle"></i> Hoàn thành nhập kho
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
