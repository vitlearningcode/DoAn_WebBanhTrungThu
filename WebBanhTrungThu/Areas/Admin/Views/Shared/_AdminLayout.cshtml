<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị Đại lý Nguyệt Cát</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/admin-layout.css" asp-append-version="true" />

    <script>
        // Chặn đứng 100% vòng lặp vô tận onerror trên mọi thẻ <img> trong phân khu Admin bằng SVG Data URI nội tuyến
        window.KV_FALLBACK_SVG = "data:image/svg+xml;utf8," + encodeURIComponent(
            '<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 80 80">' +
            '<rect width="80" height="80" rx="6" fill="#F3F4F6"/>' +
            '<circle cx="40" cy="36" r="16" fill="#0070F4" opacity="0.18"/>' +
            '<text x="40" y="64" font-family="sans-serif" font-size="9" fill="#6B7280" text-anchor="middle">Nguyệt Cát</text>' +
            '</svg>'
        );

        window.kvImgFallback = function (img) {
            if (!img) return;
            if (img.dataset.fallbackApplied === "true") {
                if (!img.src.startsWith("data:image/svg+xml")) {
                    img.src = window.KV_FALLBACK_SVG;
                }
                return;
            }
            img.dataset.fallbackApplied = "true";
            img.src = window.KV_FALLBACK_SVG;
        };

        window.addEventListener('error', function (e) {
            if (e.target && e.target.tagName === 'IMG') {
                window.kvImgFallback(e.target);
            }
        }, true);
    </script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- THANH ĐIỀU HƯỚNG TOPBAR & NAVBAR NGUYETCAT_ERP -->
    @await Html.PartialAsync("~/Areas/Admin/Views/Shared/ThanhPhan/_ThanhDieuHuongQuanTri.cshtml")

    <!-- NỘI DUNG CHÍNH -->
    <main class="kv-page-container">
        @if (TempData["ThongBaoAdmin"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show py-2 px-3 mb-3 border-0 shadow-sm d-flex align-items-center justify-content-between"
                 style="background: #ECFDF5; color: #065F46; border-left: 4px solid #10B981 !important; font-size: 13.5px;">
                <div>
                    <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["ThongBaoAdmin"]
                </div>
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["LoiAdmin"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show py-2 px-3 mb-3 border-0 shadow-sm d-flex align-items-center justify-content-between"
                 style="background: #FEF2F2; color: #991B1B; border-left: 4px solid #DC2626 !important; font-size: 13.5px;">
                <div>
                    <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>@TempData["LoiAdmin"]
                </div>
                <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleKvDetailRow(rowId, masterTr) {
            const detailRow = document.getElementById(rowId);
            if (!detailRow) return;
            const isOpen = detailRow.classList.contains('open') && !detailRow.classList.contains('d-none');

            document.querySelectorAll('.kv-detail-row').forEach(r => {
                if (r.classList.contains('open')) {
                    r.classList.remove('open');
                    r.classList.add('d-none');
                }
            });
            document.querySelectorAll('.kv-master-row.active-row').forEach(r => r.classList.remove('active-row'));

            if (!isOpen) {
                detailRow.classList.remove('d-none');
                detailRow.classList.add('open');
                if (masterTr) masterTr.classList.add('active-row');
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
