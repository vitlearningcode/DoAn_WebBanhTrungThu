@inject WebBanhTrungThu.Services.DichVuKiotVietMetadata KiotMeta
@{
    var cauHinhQr = KiotMeta.LayCauHinhQr();
}

<!-- MODAL CẤU HÌNH TÀI KHOẢN QR MOMO / VIETQR NHẬN TIỀN TOÀN HỆ THỐNG -->
<div class="modal fade" id="modalCauHinhMoMoQuanTri" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content kv-modal-content">
            <form asp-area="Admin" asp-controller="SoQuyAdmin" asp-action="CapNhatCauHinhQrMoMo" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                <div class="kv-modal-header border-bottom pb-3">
                    <h5 class="kv-modal-title d-flex align-items-center gap-2">
                        <i class="bi bi-qr-code-scan text-primary"></i>
                        <span>Cấu hình Tài khoản nhận tiền QR MoMo</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="kv-modal-body">
                    <div class="mb-3">
                        <label class="kv-field-label">Số điện thoại / Tài khoản Ví MoMo</label>
                        <input type="text" name="soTaiKhoanMoMo" class="kv-form-control"
                               value="@cauHinhQr.SoTaiKhoanMoMo" placeholder="0814585526" required />
                    </div>
                    <div class="mb-3">
                        <label class="kv-field-label">Tên chủ tài khoản (In hoa không dấu)</label>
                        <input type="text" name="tenChuTaiKhoan" class="kv-form-control"
                               value="@cauHinhQr.TenChuTaiKhoan" placeholder="LE MINH DUC" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="kv-field-label">Mã cổng / Ngân hàng</label>
                            <input type="text" name="maNganHang" class="kv-form-control"
                                   value="@cauHinhQr.MaNganHang" placeholder="MOMO" />
                        </div>
                        <div class="col-6">
                            <label class="kv-field-label">Mã BIN VietQR</label>
                            <input type="text" name="maBinVietQr" class="kv-form-control"
                                   value="@cauHinhQr.MaBinVietQr" placeholder="970422" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="kv-field-label">Mẫu nội dung chuyển khoản tự động</label>
                        <input type="text" name="mauNoiDungCk" class="kv-form-control"
                               value="@cauHinhQr.MauNoiDungCk" placeholder="NGUYETCAT {MaTraCuuDh}" />
                    </div>
                </div>

                <div class="kv-modal-footer">
                    <button type="button" class="btn-kv-outline" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn-kv-blue">
                        <i class="bi bi-check2-circle me-1"></i> Lưu cấu hình QR MoMo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
