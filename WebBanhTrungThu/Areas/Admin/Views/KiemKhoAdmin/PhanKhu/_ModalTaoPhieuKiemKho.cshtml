@model WebBanhTrungThu.ViewModels.KiemKhoAdminViewModel

<div class="modal fade" id="modalTaoPhieuKiemKho" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content kv-modal-content">
            <form id="frmLuuPhieuKiemKho" asp-area="Admin" asp-controller="KiemKhoAdmin" asp-action="LuuPhieuKiemKho" method="post" onsubmit="return chuanBiSubmitPhieuKiemKho();">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaPkk" id="kk_MaPkk" value="0" />
                <input type="hidden" name="CanBangNgay" id="kk_CanBangNgay" value="false" />
                <input type="hidden" name="ChiTietJson" id="kk_ChiTietJson" value="[]" />

                <div class="kv-modal-header pb-2 border-bottom">
                    <div>
                        <h5 class="kv-modal-title" id="kk_ModalTitle">Tạo phiếu kiểm kho đối soát thực tế</h5>
                        <div class="small text-muted">Tự động tính số lượng &amp; giá trị lệch; cân bằng sẽ trừ FEFO &amp; sinh phiếu xuất cho phần thiếu hụt.</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="kv-modal-body">
                    <div class="mb-3">
                        <label class="kv-field-label">Ghi chú đợt kiểm kho</label>
                        <input type="text" name="GhiChu" id="kk_GhiChu" class="kv-form-control" maxlength="500"
                               placeholder="VD: Kiểm kho cuối tuần quầy bánh nướng Kinh Đô..." />
                    </div>

                    <div class="p-3 rounded mb-3" style="background: #F8FAFC; border: 1px solid #E5E7EB;">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-5">
                                <label class="form-label small fw-bold mb-1">Thêm sản phẩm vào bảng kiểm</label>
                                <select id="kk_ChonSpSelect" class="form-select form-select-sm">
                                    <option value="">-- Chọn bánh trung thu cần kiểm --</option>
                                    @foreach (var sp in Model.DanhSachSanPham)
                                    {
                                        <option value="@sp.MaBanh">[@sp.MaSku] @sp.TenBanh (Tồn hệ thống: @sp.TonKhoHeThong)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn-kv-blue w-100" onclick="themDongTuSelectKiemKho()">
                                    <i class="bi bi-plus-circle"></i> Thêm dòng kiểm
                                </button>
                            </div>
                            <div class="col-md-4 text-md-end">
                                <button type="button" class="btn-kv-outline w-100" onclick="napTatCaSanPhamVaoBangKiem()">
                                    <i class="bi bi-list-check"></i> Nạp tất cả sản phẩm hiện có
                                </button>
                            </div>
                        </div>
                    </div>

                    <datalist id="dlLyDoLechKiemKho">
                        <option value="Nhân viên lấy nhầm sản phẩm"></option>
                        <option value="Hư bể chưa ghi nhận"></option>
                        <option value="Thất thoát"></option>
                        <option value="Kiểm đếm thừa thực tế"></option>
                    </datalist>

                    <div class="table-responsive mb-3">
                        <table class="kv-comp-table table table-bordered align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 38px;">#</th>
                                    <th>Sản phẩm bánh</th>
                                    <th style="width: 110px;" class="text-end">Tồn hệ thống</th>
                                    <th style="width: 120px;" class="text-center">Tồn thực tế</th>
                                    <th style="width: 105px;" class="text-end">SL lệch</th>
                                    <th style="width: 135px;" class="text-end">Giá trị lệch</th>
                                    <th style="width: 240px;">Lý do lệch</th>
                                    <th style="width: 42px;"></th>
                                </tr>
                            </thead>
                            <tbody id="kk_TbodyDongKiem"></tbody>
                        </table>
                    </div>

                    <div class="d-flex flex-wrap justify-content-end gap-4 pt-2 border-top small">
                        <span>Lệch tăng: <strong class="text-success fs-6 so-tien" id="kk_LblLechTang">+0</strong></span>
                        <span>Lệch giảm: <strong class="text-danger fs-6 so-tien" id="kk_LblLechGiam">-0</strong></span>
                        <span>Tổng giá trị lệch: <strong class="fs-6 so-tien" id="kk_LblTongGiaTriLech">0 đ</strong></span>
                    </div>
                </div>

                <div class="kv-modal-footer">
                    <button type="button" class="btn-kv-outline" data-bs-dismiss="modal">Đóng</button>
                    <div class="d-flex align-items-center gap-2">
                        <button type="submit" class="btn-kv-outline" onclick="datCheDoCanBangKiemKho(false)">
                            <i class="bi bi-save"></i> Lưu phiếu tạm
                        </button>
                        <button type="submit" class="btn-kv-green" onclick="datCheDoCanBangKiemKho(true)">
                            <i class="bi bi-check2-all"></i> Hoàn thành &amp; Cân bằng kho
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
