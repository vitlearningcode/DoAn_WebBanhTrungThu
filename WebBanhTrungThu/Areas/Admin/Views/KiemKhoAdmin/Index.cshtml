@model WebBanhTrungThu.ViewModels.KiemKhoAdminViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Kiểm kho đối soát & Cân bằng tự động - Nguyệt Cát ERP";
    var jsonSp = JsonSerializer.Serialize(Model.DanhSachSanPham.Select(sp => new
    {
        maBanh = sp.MaBanh, maSku = sp.MaSku, tenBanh = sp.TenBanh,
        giaVon = sp.GiaVon, tonHeThong = sp.TonKhoHeThong
    }));
}

@await Html.PartialAsync("~/Areas/Admin/Views/KiemKhoAdmin/PhanKhu/_KpiKiemKho.cshtml", Model)

<div class="kv-layout-2col">
    <aside class="kv-sidebar-filter">
        <h1 class="kv-page-heading">Kiểm kho</h1>
        <div class="kv-filter-box">
            <div class="kv-filter-title"><span>Trạng thái phiếu kiểm</span></div>
            <div class="d-flex flex-column gap-2" style="font-size: 13px;">
                <label class="d-flex align-items-center gap-2"><input type="radio" name="radKkTrangThai" value="ALL" checked onchange="locPhieuKiemClient()" /> Tất cả (@Model.TongSoPhieu)</label>
                <label class="d-flex align-items-center gap-2"><input type="radio" name="radKkTrangThai" value="PHIEU_TAM" onchange="locPhieuKiemClient()" /> Phiếu tạm (@Model.SoPhieuTam)</label>
                <label class="d-flex align-items-center gap-2"><input type="radio" name="radKkTrangThai" value="DA_CAN_BANG" onchange="locPhieuKiemClient()" /> Đã cân bằng (@Model.SoPhieuDaCanBang)</label>
                <label class="d-flex align-items-center gap-2"><input type="radio" name="radKkTrangThai" value="DA_HUY" onchange="locPhieuKiemClient()" /> Đã hủy</label>
            </div>
        </div>
        <div class="kv-filter-box">
            <div class="kv-filter-title"><span>File mẫu kiểm đếm</span></div>
            <p class="small text-muted mb-2">Xuất sẵn danh sách bánh &amp; tồn kho hệ thống để nhân viên đi đếm thực tế.</p>
            <a href="/Admin/KiemKhoAdmin/TaiFileMauExcel?dinhDang=xlsx" class="btn-kv-outline w-100 d-inline-flex justify-content-center align-items-center gap-1 text-decoration-none mb-2">
                <i class="bi bi-file-earmark-excel text-success"></i> Tải mẫu Excel (.xlsx)
            </a>
            <a href="/Admin/KiemKhoAdmin/TaiFileMauExcel?dinhDang=csv" class="btn-kv-outline w-100 d-inline-flex justify-content-center align-items-center gap-1 text-decoration-none">
                <i class="bi bi-filetype-csv text-primary"></i> Tải mẫu CSV
            </a>
        </div>
    </aside>

    <div class="kv-main-table-area">
        <div class="kv-toolbar">
            <div class="kv-search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="txtTimPhieuKiem" value="@Model.TuKhoa" placeholder="Tìm theo mã KK-, mã PX-, người kiểm, tên bánh..." oninput="locPhieuKiemClient()" />
            </div>
            <div class="kv-toolbar-actions">
                <button type="button" class="kv-btn-tool" data-bs-toggle="modal" data-bs-target="#modalImportKiemKho">
                    <i class="bi bi-file-earmark-arrow-up"></i> Nhập file Excel kiểm kho
                </button>
                <button type="button" class="kv-btn-primary" onclick="moModalTaoPhieuKiemKho()">
                    <i class="bi bi-plus-lg"></i> Tạo phiếu kiểm kho
                </button>
            </div>
        </div>

        @await Html.PartialAsync("~/Areas/Admin/Views/KiemKhoAdmin/PhanKhu/_BangPhieuKiemKho.cshtml", Model)
    </div>
</div>

@await Html.PartialAsync("~/Areas/Admin/Views/KiemKhoAdmin/PhanKhu/_ModalTaoPhieuKiemKho.cshtml", Model)
@await Html.PartialAsync("~/Areas/Admin/Views/KiemKhoAdmin/PhanKhu/_ModalImportKiemKho.cshtml")

@section Scripts {
    <script>window.NGUYETCAT_DS_SP_KIEM = @Html.Raw(jsonSp);</script>
    <script src="~/js/admin-kiem-kho.js" asp-append-version="true"></script>
}
