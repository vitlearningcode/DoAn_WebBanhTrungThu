@model WebBanhTrungThu.ViewModels.XuatKhoAdminViewModel

<div class="modal fade" id="modalTaoPhieuXuat" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content kv-modal-content">
            <form id="frmTaoPhieuXuat" asp-area="Admin" asp-controller="XuatKhoAdmin" asp-action="TaoPhieuXuat" method="post" onsubmit="return chuanBiSubmitPhieuXuat();">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ChiTietJson" id="px_ChiTietJson" value="[]" />

                <div class="kv-modal-header pb-2 border-bottom">
                    <div>
                        <h5 class="kv-modal-title">Tạo phiếu xuất kho</h5>
                        <div class="small text-muted">Hỗ trợ xuất hủy hàng lỗi, trả nhà sản xuất hoặc xuất tiêu dùng nội bộ (trừ lô trực tiếp hoặc FEFO).</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="kv-modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="kv-field-label">Nhóm lý do xuất kho <span class="text-danger">*</span></label>
                            <select name="LoaiXuat" id="px_LoaiXuat" class="form-select" onchange="capNhatNhanLoaiXuat()">
                                <option value="XUAT_HUY_LOI">Xuất hủy hàng lỗi / hư bể</option>
                                <option value="TRA_NHA_SAN_XUAT">Xuất trả nhà sản xuất / hãng</option>
                                <option value="TIEU_DUNG_NOI_BO">Xuất tiêu dùng nội bộ</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="kv-field-label" id="px_LblDoiTuong">Nhân viên / Nguyên nhân liên quan <span class="text-danger">*</span></label>
                            <input type="text" name="DoiTuongLienQuan" id="px_DoiTuong" class="kv-form-control" maxlength="250" required
                                   placeholder="VD: Nhân viên A làm bể, hàng quá hạn..." />
                        </div>
                        <div class="col-md-4">
                            <label class="kv-field-label" id="px_LblGhiChu">Ghi chú chi tiết</label>
                            <input type="text" name="GhiChu" id="px_GhiChu" class="kv-form-control" maxlength="500"
                                   placeholder="Mô tả lý do chi tiết..." />
                        </div>
                    </div>

                    <div class="p-3 rounded mb-3" style="background: #F8FAFC; border: 1px solid #E5E7EB;">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold mb-1">Thêm sản phẩm cần xuất kho</label>
                                <select id="px_ChonSpSelect" class="form-select form-select-sm">
                                    <option value="">-- Chọn sản phẩm bánh --</option>
                                    @foreach (var sp in Model.DanhSachSanPham.Where(x => x.TonKhoHeThong > 0))
                                    {
                                        <option value="@sp.MaBanh">[@sp.MaSku] @sp.TenBanh (Tồn khả dụng: @sp.TonKhoHeThong | Vốn: @sp.GiaVon.ToString("N0") đ)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="button" class="btn-kv-blue w-100" onclick="themDongTuSelectXuat()">
                                    <i class="bi bi-plus-circle"></i> Thêm dòng xuất
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive mb-3">
                        <table class="kv-comp-table table table-bordered align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 40px;">#</th>
                                    <th>Sản phẩm bánh</th>
                                    <th style="width: 240px;">Chọn lô trừ kho</th>
                                    <th style="width: 110px;" class="text-center">SL xuất</th>
                                    <th style="width: 120px;" class="text-end">Giá vốn</th>
                                    <th style="width: 135px;" class="text-end">Thành tiền vốn</th>
                                    <th style="width: 180px;">Ghi chú dòng</th>
                                    <th style="width: 45px;"></th>
                                </tr>
                            </thead>
                            <tbody id="px_TbodyDongXuat"></tbody>
                        </table>
                    </div>

                    <div class="text-end pt-2 border-top">
                        <span class="text-muted me-2">Tổng giá trị vốn xuất dự kiến:</span>
                        <strong class="fs-5 text-danger so-tien" id="px_LblTongVon">0 đ</strong>
                    </div>
                </div>

                <div class="kv-modal-footer">
                    <button type="button" class="btn-kv-outline" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn-kv-green"><i class="bi bi-check2-circle"></i> Hoàn thành phiếu xuất &amp; Trừ kho</button>
                </div>
            </form>
        </div>
    </div>
</div>
