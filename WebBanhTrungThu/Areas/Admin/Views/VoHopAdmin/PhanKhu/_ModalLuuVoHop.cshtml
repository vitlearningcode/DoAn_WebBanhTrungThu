@model WebBanhTrungThu.ViewModels.VoHopAdminIndexViewModel

<div class="modal fade" id="modalLuuVoHop" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content kv-modal-content">
            <form asp-area="Admin" asp-controller="VoHopAdmin" asp-action="LuuMauVoHop" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaVh" id="vh_MaVh" value="0" />

                <div class="kv-modal-header pb-2 border-bottom">
                    <div>
                        <h5 class="kv-modal-title" id="vh_ModalTitle">Thêm mẫu vỏ hộp mới</h5>
                        <div class="small text-muted">Thiết lập quy cách khay hộp, giá bán riêng và hình ảnh đại diện (KHAY_HOP_RONG).</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="kv-modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="kv-field-label">Mã vỏ hộp (MaCodeVH)</label>
                            <input type="text" name="MaCodeVh" id="vh_MaCodeVh" class="kv-form-control" maxlength="30"
                                   placeholder="Để trống tự sinh (VD: VH-05)" />
                        </div>
                        <div class="col-md-8">
                            <label class="kv-field-label">Tên mẫu vỏ hộp <span class="text-danger">*</span></label>
                            <input type="text" name="TenVoHop" id="vh_TenVoHop" class="kv-form-control" maxlength="200" required
                                   placeholder="VD: Hộp Sơn Mài Hoàng Gia 6 Bánh" />
                        </div>

                        <div class="col-md-3">
                            <label class="kv-field-label">Sức chứa (bánh) <span class="text-danger">*</span></label>
                            <input type="number" name="SucChuaBanh" id="vh_SucChuaBanh" class="kv-form-control" min="2" max="16" step="1" value="4" required />
                        </div>
                        <div class="col-md-3">
                            <label class="kv-field-label">Bố cục lưới</label>
                            <select name="KieuBoCucLuoi" id="vh_KieuBoCucLuoi" class="form-select" style="height: 34px;">
                                <option value="grid-2x2">Lưới 2x2 (4 bánh)</option>
                                <option value="grid-3x2">Lưới 3x2 (6 bánh)</option>
                                <option value="grid-1x2">Lưới 1x2 (2 bánh)</option>
                                <option value="grid-2x4">Lưới 2x4 (8 bánh)</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="kv-field-label">Giá bán riêng (đ) <span class="text-danger">*</span></label>
                            <input type="number" name="GiaVoHopRieng" id="vh_GiaVoHopRieng" class="kv-form-control text-end fw-bold"
                                   min="0" step="1" value="150000" required />
                        </div>
                        <div class="col-md-3">
                            <label class="kv-field-label">SL bánh VIP tối thiểu</label>
                            <input type="number" name="SlbanhThuongHangToiThieu" id="vh_SlVip" class="kv-form-control text-end"
                                   min="0" max="16" step="1" value="0" />
                        </div>

                        <div class="col-md-6">
                            <label class="kv-field-label">Chọn ảnh từ Kho Hình Ảnh</label>
                            <select name="MaAnhChinh" id="vh_MaAnhChinh" class="form-select" style="height: 34px;">
                                <option value="">-- Giữ ảnh hiện tại / mặc định --</option>
                                @foreach (var anh in Model.DanhSachHinhAnh)
                                {
                                    <option value="@anh.MaHa">@anh.TenTepGoc (@anh.UrlHienThi)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="kv-field-label">Hoặc tải tệp ảnh mới</label>
                            <input type="file" name="FileAnhTaiLen" id="vh_FileAnhTaiLen" class="form-control form-control-sm" accept="image/*" />
                        </div>

                        <div class="col-md-8">
                            <label class="kv-field-label">Hoặc nhập đường dẫn ảnh nhanh</label>
                            <input type="text" name="UrlAnhNhapTay" id="vh_UrlAnhNhapTay" class="kv-form-control" maxlength="500"
                                   placeholder="VD: /images/vohop/khay-6-o-rong.png" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="d-flex align-items-center gap-2">
                                <img id="vh_PreviewImg" src="/images/vohop/khay-4-o-rong.png" alt="Xem trước ảnh vỏ hộp"
                                     class="kv-thumb-36" onerror="window.kvImgFallback(this)" />
                                <span class="small text-muted">Xem trước ảnh vỏ hộp</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="kv-field-label">Mô tả chất liệu &amp; quy cách</label>
                            <textarea name="MoTaChatLieu" id="vh_MoTaChatLieu" class="form-control" rows="2" maxlength="500"
                                      placeholder="Gỗ sơn mài / giấy mỹ thuật ép kim nhũ vàng, túi giấy đi kèm..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="KemTraOlong" id="vh_KemTraOlong" value="true" />
                                <label class="form-check-label fw-medium" for="vh_KemTraOlong">Kèm hộp Trà Ô Long thưởng nguyệt</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="TrangThai" id="vh_TrangThai" value="true" checked />
                                <label class="form-check-label fw-medium" for="vh_TrangThai">Đang sử dụng (Hiển thị Studio &amp; POS)</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="kv-modal-footer">
                    <button type="button" class="btn-kv-outline" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn-kv-blue"><i class="bi bi-check2-circle"></i> Lưu mẫu vỏ hộp</button>
                </div>
            </form>
        </div>
    </div>
</div>
