@model WebBanhTrungThu.ViewModels.VoHopAdminIndexViewModel

<div class="kv-card p-3">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h6 class="fw-bold text-dark mb-0">
            <i class="bi bi-clock-history text-primary me-1"></i> Lịch sử Nhập kho &amp; Xuất hủy Vỏ hộp (SQL-First)
        </h6>
        <span class="small text-muted">@Model.LichSuKhoVoHop.Count phiếu gần nhất</span>
    </div>

    <div class="kv-kh-history-scroll">
        <table class="kv-table kv-kh-history-table align-middle mb-0" style="font-size: 12.5px;">
            <thead>
                <tr>
                    <th>Số phiếu</th>
                    <th>Thời gian</th>
                    <th>Mẫu vỏ hộp</th>
                    <th class="text-center">Giao dịch</th>
                    <th class="text-end">Số lượng</th>
                    <th class="text-end">Đơn giá / Thành tiền</th>
                    <th>NCC &amp; Phiếu chi Sổ quỹ</th>
                    <th>Người lập &amp; Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.LichSuKhoVoHop)
                {
                    bool laNhap = p.LoaiGiaoDich == "NHAP_VO_HOP";
                    <tr>
                        <td class="fw-bold text-nowrap @(laNhap ? "text-primary" : "text-danger")">@p.SoPhieu</td>
                        <td class="text-nowrap">@p.NgayGiaoDich.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <div class="fw-semibold text-dark">@(p.MaVhNavigation?.TenVoHop ?? $"Vỏ #{p.MaVh}")</div>
                            <small class="text-muted">@p.MaVhNavigation?.MaCodeVh</small>
                        </td>
                        <td class="text-center text-nowrap">
                            @if (laNhap)
                            {
                                <span class="badge" style="background: #DCFCE7; color: #166534; border: 1px solid #BBF7D0;">Nhập vỏ hộp</span>
                            }
                            else
                            {
                                <span class="badge" style="background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA;">Xuất hủy vỏ</span>
                            }
                        </td>
                        <td class="text-end fw-bold so-tien text-nowrap @(laNhap ? "text-success" : "text-danger")">
                            @(laNhap ? "+" : "-")@p.SoLuong.ToString("N0")
                        </td>
                        <td class="text-end so-tien text-nowrap">
                            @if (laNhap)
                            {
                                <div class="fw-semibold text-dark">@p.ThanhTien.ToString("N0") đ</div>
                                <small class="text-muted">@p.DonGiaNhap.ToString("N0") đ/vỏ</small>
                            }
                            else
                            {
                                <span class="text-muted">---</span>
                            }
                        </td>
                        <td>
                            @if (p.MaNccNavigation != null)
                            {
                                <div class="fw-medium text-dark">@p.MaNccNavigation.TenNcc</div>
                            }
                            @if (p.MaPhieuChiNavigation != null)
                            {
                                <a href="/Admin/SoQuyAdmin/Index?tuKhoa=@p.MaPhieuChiNavigation.MaPhieuHienThi"
                                   class="badge text-decoration-none mt-1"
                                   style="background: #EBF5FF; color: #005AC3; border: 1px solid #BFDBFE;">
                                    @p.MaPhieuChiNavigation.MaPhieuHienThi
                                </a>
                            }
                            else if (p.MaNccNavigation == null)
                            {
                                <span class="text-muted small">Nội bộ</span>
                            }
                        </td>
                        <td>
                            <div class="fw-medium text-dark">@p.NguoiLap</div>
                            @if (!string.IsNullOrWhiteSpace(p.GhiChu))
                            {
                                <small class="text-muted">@p.GhiChu</small>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.LichSuKhoVoHop.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            Chưa có giao dịch nhập kho hoặc xuất hủy vỏ hộp nào được ghi nhận.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
