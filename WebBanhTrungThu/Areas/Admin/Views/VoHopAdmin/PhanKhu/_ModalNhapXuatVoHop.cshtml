@model WebBanhTrungThu.ViewModels.VoHopAdminIndexViewModel

<div class="modal fade" id="modalNhapXuatVoHop" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content kv-modal-content">
            <form asp-area="Admin" asp-controller="VoHopAdmin" asp-action="NhapXuatKhoVoHop" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaVh" id="nx_MaVh" value="0" />

                <div class="kv-modal-header pb-2 border-bottom">
                    <div>
                        <h5 class="kv-modal-title" id="nx_ModalTitle">Nhập / Xuất hủy kho vỏ hộp</h5>
                        <div class="small text-muted" id="nx_VoHopSub">Cập nhật tồn kho thực tế và đồng bộ Sổ quỹ.</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="kv-modal-body">
                    <div class="p-2 px-3 rounded mb-3 d-flex justify-content-between align-items-center"
                         style="background: #F8FAFC; border: 1px solid #E5E7EB;">
                        <div>
                            <span class="small text-muted">Mẫu vỏ đang chọn:</span>
                            <div class="fw-bold text-dark" id="nx_TenVoHopDisplay">---</div>
                        </div>
                        <div class="text-end">
                            <span class="small text-muted">Tồn hiện tại</span>
                            <div class="fw-bold text-primary so-tien" id="nx_TonHienTaiDisplay">0</div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="kv-field-label">Loại giao dịch <span class="text-danger">*</span></label>
                            <select name="LoaiGiaoDich" id="nx_LoaiGiaoDich" class="form-select" style="height: 34px;" onchange="capNhatCheDoNhapXuatVoHop()">
                                <option value="NHAP_VO_HOP">Nhập thêm vỏ hộp</option>
                                <option value="XUAT_HUY_VO_HOP">Xuất hủy vỏ hộp hỏng</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="kv-field-label">Số lượng vỏ <span class="text-danger">*</span></label>
                            <input type="number" name="SoLuong" id="nx_SoLuong" class="kv-form-control text-end fw-bold"
                                   min="1" step="1" value="10" required oninput="capNhatThanhTienVoHop()" />
                        </div>

                        <div class="col-md-6 nx-chi-nhap">
                            <label class="kv-field-label">Đơn giá nhập (đ/vỏ)</label>
                            <input type="number" name="DonGiaNhap" id="nx_DonGiaNhap" class="kv-form-control text-end fw-bold"
                                   min="0" step="1" value="50000" oninput="capNhatThanhTienVoHop()" />
                        </div>
                        <div class="col-md-6 nx-chi-nhap">
                            <label class="kv-field-label">Thành tiền tạm tính</label>
                            <div id="nx_ThanhTienDisplay" class="kv-form-control d-flex align-items-center justify-content-end fw-bold text-success so-tien"
                                 style="background: #F9FAFB;">500.000 đ</div>
                        </div>

                        <div class="col-12 nx-chi-nhap">
                            <label class="kv-field-label">Nhà cung cấp vỏ hộp</label>
                            <select name="MaNcc" id="nx_MaNcc" class="form-select" style="height: 34px;">
                                <option value="">-- Nhập lẻ / Không gắn NCC --</option>
                                @foreach (var ncc in Model.DanhSachNhaCungCap)
                                {
                                    <option value="@ncc.MaNcc">@ncc.MaCodeNcc - @ncc.TenNcc</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6 nx-chi-nhap d-flex align-items-center">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="ThanhToanNgay" id="nx_ThanhToanNgay" value="true" checked />
                                <label class="form-check-label fw-medium" for="nx_ThanhToanNgay">Chi tiền ngay (Ghi Sổ quỹ)</label>
                            </div>
                        </div>
                        <div class="col-md-6 nx-chi-nhap">
                            <label class="kv-field-label">Phương thức chi</label>
                            <select name="PhuongThucTt" id="nx_PhuongThucTt" class="form-select" style="height: 34px;">
                                <option value="CHUYEN_KHOAN">Chuyển khoản ngân hàng</option>
                                <option value="TIEN_MAT">Tiền mặt tại quầy</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="kv-field-label">Ghi chú chứng từ</label>
                            <textarea name="GhiChu" id="nx_GhiChu" class="form-control" rows="2" maxlength="500"
                                      placeholder="VD: Nhập bổ sung lô vỏ hộp đợt cao điểm rằm tháng 8..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="kv-modal-footer">
                    <button type="button" class="btn-kv-outline" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" id="nx_BtnSubmit" class="btn-kv-green"><i class="bi bi-check2-circle"></i> Xác nhận nhập kho</button>
                </div>
            </form>
        </div>
    </div>
</div>
