@model WebBanhTrungThu.ViewModels.KhuyenMaiAdminViewModel
@{
    ViewData["Title"] = "Quản Lý Mã Khuyến Mãi / Voucher (Guest & Member)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h5 class="fw-bold mb-0 text-dark">Chương Trình Khuyến Mãi & Mã Voucher (@Model.DanhSachKhuyenMai.Count mã)</h5>
        <small class="text-muted">Cấu hình mã giảm giá theo % hoặc tiền mặt, giới hạn số lượt và quyền sử dụng cho Khách vãng lai (Guest)</small>
    </div>
    <button type="button" class="btn btn-kv-green" data-bs-toggle="modal" data-bs-target="#modalThemVoucher">
        <i class="bi bi-plus-lg me-1"></i>+ Thêm mã khuyến mãi mới
    </button>
</div>

<div class="kv-card p-3">
    <div class="table-responsive">
        <table class="kv-table">
            <thead>
                <tr>
                    <th>Mã CodeKM</th>
                    <th>Tên Chương Trình</th>
                    <th>Mức Giảm & Đơn Tối Thiểu</th>
                    <th class="text-center">Đã Dùng</th>
                    <th>Cấu Hình Lượt Tối Đa • Hạn Dùng • Cho Phép Guest KVL</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var km in Model.DanhSachKhuyenMai)
                {
                    <tr class="border-bottom">
                        <td><span class="badge bg-primary fs-6">@km.CodeKm</span></td>
                        <td>
                            <div class="fw-bold text-dark">@km.TenChuongTrinh</div>
                            <small class="text-muted">Loại: @km.LoaiGiam</small>
                        </td>
                        <td>
                            @if (km.LoaiGiam == "PHAN_TRAM")
                            {
                                <strong class="text-danger">Giảm @km.GiaTriGiam%</strong>
                                <span class="text-muted small">(Tối đa @km.GiamToiDa.ToString("N0") đ)</span>
                            }
                            else
                            {
                                <strong class="text-danger">Giảm @km.GiaTriGiam.ToString("N0") đ</strong>
                            }
                            <div class="small text-muted">Đơn tối thiểu: @km.DonToiThieu.ToString("N0") đ</div>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-info text-dark">@km.SldaDung / @km.SltoiDa</span>
                        </td>
                        <td>
                            <form asp-area="Admin" asp-controller="KhachHangAdmin" asp-action="CapNhatVoucher" method="post" class="row g-2 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maKm" value="@km.MaKm" />
                                <div class="col-md-3">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">Tối đa:</span>
                                        <input type="number" name="slToiDa" value="@km.SltoiDa" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <input type="date" name="ngayKetThuc" value="@km.NgayKetThuc.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check m-0">
                                        <input class="form-check-input" type="checkbox" name="choPhepKhachVangLai" value="true" id="g_@km.MaKm" @(km.ChoPhepKhachVangLai ? "checked" : "") />
                                        <label class="form-check-label small fw-semibold" for="g_@km.MaKm">Cho phép Guest</label>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-kv-green btn-sm w-100">Lưu</button>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL THÊM MÃ KHUYẾN MÃI MỚI -->
<div class="modal fade" id="modalThemVoucher" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title fw-bold mb-0"><i class="bi bi-ticket-perforated me-2"></i>Tạo Mã Khuyến Mãi / Voucher Mới</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-area="Admin" asp-controller="KhachHangAdmin" asp-action="ThemVoucherMoi" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <label class="form-label small fw-semibold">Mã CodeKM (*)</label>
                            <input type="text" name="CodeKm" required class="form-control form-control-sm text-uppercase" placeholder="VD: DOANVIEN50K" />
                        </div>
                        <div class="col-md-7">
                            <label class="form-label small fw-semibold">Tên chương trình (*)</label>
                            <input type="text" name="TenChuongTrinh" required class="form-control form-control-sm" placeholder="VD: Ưu đãi Đoàn Viên giảm 50K" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Loại giảm giá</label>
                            <select name="LoaiGiam" class="form-select form-select-sm">
                                <option value="PHAN_TRAM">PHAN_TRAM (Theo %)</option>
                                <option value="TIEN_MAT">TIEN_MAT (Trừ tiền trực tiếp)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Giá trị giảm (% hoặc VNĐ)</label>
                            <input type="number" name="GiaTriGiam" value="10" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Giảm tối đa (VNĐ)</label>
                            <input type="number" step="10000" name="GiamToiDa" value="150000" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Đơn hàng tối thiểu (VNĐ)</label>
                            <input type="number" step="50000" name="DonToiThieu" value="300000" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Số lượt tối đa</label>
                            <input type="number" name="SltoiDa" value="100" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Hạn sử dụng</label>
                            <input type="date" name="NgayKetThuc" value="@DateTime.Now.AddDays(45).ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
                        </div>
                        <div class="col-12 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="ChoPhepKhachVangLai" value="true" id="chkGuestNew" checked />
                                <label class="form-check-label small fw-semibold text-primary" for="chkGuestNew">
                                    Cho phép cả Khách vãng lai (Guest KVL) áp dụng mã này
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-kv-green">Lưu mã khuyến mãi</button>
                </div>
            </form>
        </div>
    </div>
</div>

