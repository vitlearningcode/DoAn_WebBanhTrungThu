@model WebBanhTrungThu.ViewModels.KhachHangAdminViewModel
@{
    ViewData["Title"] = "Khách hàng - KiotViet";
}

<style>
    .kv-page-heading {
        font-size: 20px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 14px 0;
    }

    .kv-select, .kv-input {
        width: 100%;
        height: 34px;
        border: 1px solid #D1D5DA;
        border-radius: 6px;
        padding: 0 10px;
        font-size: 13px;
        color: #1F2937;
        background-color: #FFFFFF;
        outline: none;
    }

    .kv-select:focus, .kv-input:focus {
        border-color: #0070F4;
        box-shadow: 0 0 0 2px rgba(0, 112, 244, 0.12);
    }

    .kv-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

    .kv-search-box {
        position: relative;
        width: 340px;
        max-width: 100%;
    }

    .kv-search-box i {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        color: #6B7280;
        font-size: 14px;
    }

    .kv-search-box input {
        width: 100%;
        height: 36px;
        padding: 0 12px 0 34px;
        border: 1px solid #D1D5DA;
        border-radius: 6px;
        background: #FFFFFF;
        font-size: 13.5px;
        color: #1F2937;
        outline: none;
    }

    .kv-detail-tabs {
        display: flex;
        gap: 20px;
        border-bottom: 1px solid #E5E7EB;
        margin-bottom: 14px;
    }

    .kv-detail-tab {
        padding: 8px 4px;
        font-size: 13.5px;
        font-weight: 600;
        color: #6B7280;
        border: none;
        border-bottom: 2px solid transparent;
        background: transparent;
        cursor: pointer;
    }

    .kv-detail-tab.active {
        color: #0070F4;
        border-bottom-color: #0070F4;
    }
</style>

<div class="kv-layout-2col">
    <!-- ========================================================================= -->
    <!-- CỘT TRÁI (250PX): BỘ LỌC KHÁCH HÀNG & PHIÊN GUEST CHUẨN KIOTVIET          -->
    <!-- ========================================================================= -->
    <aside class="kv-sidebar-filter">
        <h1 class="kv-page-heading">Khách hàng</h1>

        <div>
            <!-- 1. Nhóm khách hàng / Hạng thành viên -->
            <div class="kv-filter-box">
                <div class="kv-filter-title">
                    <span>Nhóm khách hàng / Hạng TV</span>
                    <i class="bi bi-chevron-up text-muted" style="font-size: 11px;"></i>
                </div>
                <select id="fltKhHangTv" class="kv-select" onchange="locKhachHangClient()">
                    <option value="ALL">Tất cả nhóm khách</option>
                    <option value="Đồng">Hạng Đồng</option>
                    <option value="Bạc">Hạng Bạc</option>
                    <option value="Vàng">Hạng Vàng</option>
                    <option value="Kim Cương">Hạng Kim Cương</option>
                    <option value="DoanhNghiep">Khách sỉ DoanhNghiep (B2B)</option>
                </select>
            </div>

            <!-- 2. Phiên khách vãng lai (Guest) -->
            <div class="kv-filter-box">
                <div class="kv-filter-title">
                    <span>Phiên khách vãng lai (Guest)</span>
                    <i class="bi bi-chevron-up text-muted" style="font-size: 11px;"></i>
                </div>
                <div class="d-flex flex-column gap-1">
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="fltGuestGop" value="ALL" checked onchange="locPhienGuestClient()" />
                        <span>Tất cả phiên Guest</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="fltGuestGop" value="DA_GOP" onchange="locPhienGuestClient()" />
                        <span>Đã gộp giỏ (Member)</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="fltGuestGop" value="CHUA_GOP" onchange="locPhienGuestClient()" />
                        <span>Chưa gộp giỏ (Độc lập)</span>
                    </label>
                </div>
            </div>
        </div>
    </aside>

    <!-- ========================================================================= -->
    <!-- CỘT PHẢI: DANH SÁCH KHÁCH HÀNG & GIÁM SÁT PHIÊN GUEST                     -->
    <!-- ========================================================================= -->
    <div class="kv-main-table-area">
        <div class="kv-toolbar">
            <div class="kv-search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="txtTimKhachHang" value="@Model.TuKhoa"
                       placeholder="Theo mã, tên, số điện thoại, email"
                       oninput="locKhachHangClient()" />
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="/Admin/KhachHangAdmin/KhuyenMai" class="btn-kv-blue text-decoration-none">
                    <i class="bi bi-ticket-perforated me-1"></i> Chương trình Khuyến mãi
                </a>
                <button type="button" class="btn-kv-outline" onclick="window.print();">
                    <i class="bi bi-download"></i> Xuất file
                </button>
            </div>
        </div>

        <!-- BẢNG 1: KHÁCH HÀNG THÀNH VIÊN -->
        <div class="kv-card overflow-hidden mb-3">
            <div class="table-responsive">
                <table class="kv-table">
                    <thead>
                        <tr>
                            <th style="width: 34px;" class="text-center">
                                <input type="checkbox" class="form-check-input" onclick="event.stopPropagation(); document.querySelectorAll('.chk-row-kh').forEach(c => c.checked = this.checked)" />
                            </th>
                            <th>Mã KH</th>
                            <th>Tên khách hàng</th>
                            <th>Điện thoại</th>
                            <th>Email</th>
                            <th>Hạng thẻ</th>
                            <th class="text-end">Điểm tích lũy</th>
                            <th class="text-end">Tổng bán</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyKhachHang">
                        @for (int i = 0; i < Model.DanhSachThanhVien.Count; i++)
                        {
                            var nd = Model.DanhSachThanhVien[i];
                            decimal tongBan = Math.Round(nd.DonHangs.Where(d => d.TrangThaiDh != "DA_HUY").Sum(d => d.TongThanhToanCuoi), 0);
                            bool laDoanhNghiep = nd.DonHangs.Any(d => d.LaDonDoanhNghiepB2b) || nd.HangTv == "DoanhNghiep";
                            string searchKey = $"KH{nd.MaNd:D4} {nd.HoTen} {nd.Sdt} {nd.Email} {nd.HangTv}".ToLowerInvariant();
                            bool moMacDinh = (i == 0);

                            <tr class="kv-master-row @(moMacDinh ? "active-row" : "")"
                                data-detail-id="detail-nd-@nd.MaNd"
                                data-search="@searchKey"
                                data-hangtv="@nd.HangTv"
                                data-b2b="@(laDoanhNghiep ? "1" : "0")"
                                onclick="toggleKvDetailRow('detail-nd-@nd.MaNd', this)">
                                <td class="text-center" onclick="event.stopPropagation();">
                                    <input type="checkbox" class="form-check-input chk-row-kh" />
                                </td>
                                <td class="fw-medium" style="color: #0070F4;">KH@(nd.MaNd.ToString("D4"))</td>
                                <td class="fw-medium text-dark">@nd.HoTen</td>
                                <td>@nd.Sdt</td>
                                <td class="text-muted">@nd.Email</td>
                                <td>
                                    <span class="fw-medium text-dark">@nd.HangTv</span>
                                </td>
                                <td class="text-end">@nd.DiemTichLuy.ToString("N0")</td>
                                <td class="text-end fw-semibold" style="color: #0070F4;">@tongBan.ToString("N0")</td>
                            </tr>

                            <!-- DÒNG MỞ RỘNG: LỊCH SỬ MUA HÀNG & SỔ ĐỊA CHỈ ĐA ĐIỂM NHẬN -->
                            <tr id="detail-nd-@nd.MaNd" class="kv-detail-row @(moMacDinh ? "open" : "")" onclick="event.stopPropagation();">
                                <td colspan="8" class="p-0">
                                    <div class="kv-detail-box">
                                        <div class="kv-detail-tabs">
                                            <button type="button" class="kv-detail-tab active"
                                                    id="btnTabKh1_@nd.MaNd"
                                                    onclick="chuyenTabKhachHang(@nd.MaNd, 1)">
                                                Lịch sử mua hàng (@nd.DonHangs.Count đơn)
                                            </button>
                                            <button type="button" class="kv-detail-tab"
                                                    id="btnTabKh2_@nd.MaNd"
                                                    onclick="chuyenTabKhachHang(@nd.MaNd, 2)">
                                                Sổ địa chỉ đa điểm nhận (@nd.SoDiaChis.Count địa chỉ)
                                            </button>
                                        </div>

                                        <!-- TAB 1: LỊCH SỬ MUA HÀNG -->
                                        <div id="paneTabKh1_@nd.MaNd">
                                            @if (nd.DonHangs.Any())
                                            {
                                                <div class="table-responsive">
                                                    <table class="table table-sm table-bordered align-middle mb-0" style="font-size: 13px;">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Mã hóa đơn</th>
                                                                <th>Thời gian</th>
                                                                <th>Loại đơn</th>
                                                                <th>Phương thức TT</th>
                                                                <th class="text-end">Tổng cộng</th>
                                                                <th>Trạng thái</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var dh in nd.DonHangs.OrderByDescending(x => x.NgayDat))
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <a href="/Admin/DonHangAdmin/Index?tuKhoa=@dh.MaTraCuuDh" class="fw-medium text-decoration-none" style="color: #0070F4;">
                                                                            @dh.MaTraCuuDh
                                                                        </a>
                                                                    </td>
                                                                    <td>@dh.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                                                                    <td>@(dh.LaDonDoanhNghiepB2b ? "Doanh nghiệp B2B" : "Bán lẻ B2C")</td>
                                                                    <td>@dh.PhuongThucTt</td>
                                                                    <td class="text-end fw-semibold">@dh.TongThanhToanCuoi.ToString("N0")</td>
                                                                    <td>@dh.TrangThaiDh</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted small py-2">Khách hàng chưa có hóa đơn nào.</div>
                                            }
                                        </div>

                                        <!-- TAB 2: SỔ ĐỊA CHỈ ĐA ĐIỂM NHẬN -->
                                        <div id="paneTabKh2_@nd.MaNd" style="display: none;">
                                            @if (nd.SoDiaChis.Any())
                                            {
                                                <div class="row g-2">
                                                    @foreach (var dc in nd.SoDiaChis)
                                                    {
                                                        <div class="col-md-6">
                                                            <div class="p-2 rounded border bg-light" style="font-size: 13px;">
                                                                <strong class="text-dark">📍 @(dc.NhanDiaChi ?? "Địa chỉ nhận quà"): @dc.TenNguoiNhan (@dc.SdtnguoiNhan)</strong>
                                                                <div class="text-muted mt-1">@dc.DiaChiCuThe, @dc.PhuongXa, @dc.QuanHuyen, @dc.TinhThanh</div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted small py-2">Khách hàng chưa lưu sổ địa chỉ đa điểm nhận.</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- BẢNG 2: PHIÊN KHÁCH VÃNG LAI (GUEST SESSION & GOPGIOHANGASYNC) -->
        <div class="kv-card overflow-hidden">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark" style="font-size: 13.5px;">
                    Phiên khách vãng lai (Guest Session & Hợp nhất giỏ hàng GopGioHangAsync)
                </span>
                <span class="text-muted small">@Model.DanhSachPhienGuest.Count phiên gần nhất</span>
            </div>

            <div class="table-responsive">
                <table class="kv-table">
                    <thead>
                        <tr>
                            <th>Mã phiên Guest (Cookie)</th>
                            <th>IP / Thiết bị</th>
                            <th>Ngày khởi tạo</th>
                            <th class="text-center">Số đơn đặt</th>
                            <th>Trạng thái hợp nhất giỏ hàng</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyPhienGuest">
                        @foreach (var p in Model.DanhSachPhienGuest)
                        {
                            <tr class="border-bottom" data-dagop="@(p.DaGopGioHang ? "DA_GOP" : "CHUA_GOP")">
                                <td class="fw-medium" style="color: #0070F4;">@p.MaPhienKvl</td>
                                <td>
                                    <div>@p.DiaChiIp</div>
                                    <small class="text-muted text-truncate d-block" style="max-width: 240px;">@p.ThongTinTrinhDuyet</small>
                                </td>
                                <td>@p.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">@p.DonHangs.Count.ToString("N0")</td>
                                <td>
                                    @if (p.DaGopGioHang)
                                    {
                                        <span class="text-success fw-medium">
                                            Đã gộp giỏ vào Member: @(p.MaNdDaGopNavigation?.HoTen ?? $"#{p.MaNdDaGop}")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Chưa gộp giỏ (Khách vãng lai độc lập)
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function chuyenTabKhachHang(maNd, tabIdx) {
            const p1 = document.getElementById('paneTabKh1_' + maNd);
            const p2 = document.getElementById('paneTabKh2_' + maNd);
            const b1 = document.getElementById('btnTabKh1_' + maNd);
            const b2 = document.getElementById('btnTabKh2_' + maNd);
            if (!p1 || !p2) return;

            p1.style.display = (tabIdx === 1) ? 'block' : 'none';
            p2.style.display = (tabIdx === 2) ? 'block' : 'none';
            if (b1) b1.classList.toggle('active', tabIdx === 1);
            if (b2) b2.classList.toggle('active', tabIdx === 2);
        }

        function locKhachHangClient() {
            const tk = (document.getElementById('txtTimKhachHang')?.value || '').trim().toLowerCase();
            const hang = document.getElementById('fltKhHangTv')?.value || 'ALL';

            document.querySelectorAll('#tbodyKhachHang tr.kv-master-row').forEach(tr => {
                let hien = true;
                if (tk !== '') {
                    const s = tr.getAttribute('data-search') || '';
                    if (!s.includes(tk)) hien = false;
                }
                if (hien && hang !== 'ALL') {
                    if (hang === 'DoanhNghiep') {
                        if (tr.getAttribute('data-b2b') !== '1') hien = false;
                    } else if (tr.getAttribute('data-hangtv') !== hang) {
                        hien = false;
                    }
                }
                tr.style.display = hien ? '' : 'none';
                if (!hien) {
                    tr.classList.remove('active-row');
                    const dId = tr.getAttribute('data-detail-id');
                    if (dId) {
                        const dRow = document.getElementById(dId);
                        if (dRow) dRow.classList.remove('open');
                    }
                }
            });
        }

        function locPhienGuestClient() {
            const val = document.querySelector('input[name="fltGuestGop"]:checked')?.value || 'ALL';
            document.querySelectorAll('#tbodyPhienGuest tr').forEach(tr => {
                if (val === 'ALL') {
                    tr.style.display = '';
                } else {
                    tr.style.display = (tr.getAttribute('data-dagop') === val) ? '' : 'none';
                }
            });
        }
    </script>
}
