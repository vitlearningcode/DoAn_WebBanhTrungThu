@model WebBanhTrungThu.ViewModels.NhanVienAdminViewModel
@{
    ViewData["Title"] = "Quản lý Nhân viên - Nguyệt Cát ERP";
}

<div class="kv-card p-3 mb-3">
    <div class="row g-3 text-end align-items-center">
        <div class="col-6 col-md-3 border-end pe-3 pe-md-4">
            <div class="text-muted small">Tổng nhân sự</div>
            <div class="fs-5 fw-bold text-dark so-tien">@Model.TongNhanSu nhân sự</div>
            <small class="text-muted">Chủ cửa hàng &amp; Bán hàng</small>
        </div>
        <div class="col-6 col-md-3 border-end pe-3 pe-md-4">
            <div class="text-muted small">Đang làm việc</div>
            <div class="fs-5 fw-bold text-success so-tien">@Model.SoDangLamViec tài khoản</div>
        </div>
        <div class="col-6 col-md-3 border-end pe-3 pe-md-4">
            <div class="text-muted small">Nhân viên Bán hàng</div>
            <div class="fs-5 fw-bold text-primary so-tien">@Model.SoNhanVienBanHang nhân viên</div>
        </div>
        <div class="col-6 col-md-3 pe-3">
            <div class="text-muted small">Đang tạm khóa</div>
            <div class="fs-5 fw-bold @(Model.SoDangTamKhoa > 0 ? "text-danger" : "text-dark") so-tien">@Model.SoDangTamKhoa tài khoản</div>
        </div>
    </div>
</div>

<div class="kv-layout-2col">
    @await Html.PartialAsync("~/Areas/Admin/Views/NhanVienAdmin/PhanKhu/_BoLocNhanVienSidebar.cshtml", Model)
    @await Html.PartialAsync("~/Areas/Admin/Views/NhanVienAdmin/PhanKhu/_BangDanhSachNhanVien.cshtml", Model)
</div>

@await Html.PartialAsync("~/Areas/Admin/Views/NhanVienAdmin/PhanKhu/_ModalLuuNhanVien.cshtml", Model)
@await Html.PartialAsync("~/Areas/Admin/Views/NhanVienAdmin/PhanKhu/_ModalDatLaiMatKhauNv.cshtml")

@section Scripts {
    <script src="~/js/admin-nhan-vien.js" asp-append-version="true"></script>
}
