@model WebBanhTrungThu.ViewModels.NhanVienAdminViewModel

<div class="modal fade" id="modalLuuNhanVien" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content kv-modal-content">
            <form asp-area="Admin" asp-controller="NhanVienAdmin" asp-action="LuuNhanVien" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaNv" id="nv_MaNv" value="0" />
                <input type="hidden" name="MaNd" id="nv_MaNd" value="0" />

                <div class="kv-modal-header pb-2 border-bottom">
                    <div>
                        <h5 class="kv-modal-title" id="nv_ModalTitle">Thêm nhân viên mới</h5>
                        <div class="small text-muted">Cấp tài khoản và hồ sơ nhân sự theo phân quyền 2 vai trò (Chủ cửa hàng / Nhân viên Bán hàng).</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="kv-modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="kv-field-label" for="nv_MaCodeNv">Mã nhân viên</label>
                            <input type="text" name="MaCodeNv" id="nv_MaCodeNv" class="kv-form-control" maxlength="20"
                                   placeholder="Để trống để tự sinh (VD: NV004)" />
                        </div>
                        <div class="col-md-8">
                            <label class="kv-field-label" for="nv_HoTen">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" name="HoTen" id="nv_HoTen" class="kv-form-control" maxlength="150" required
                                   placeholder="VD: Phạm Minh Anh" />
                        </div>

                        <div class="col-md-6">
                            <label class="kv-field-label" for="nv_Sdt">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="text" name="Sdt" id="nv_Sdt" class="kv-form-control" maxlength="15" required
                                   placeholder="VD: 0909123456" />
                        </div>
                        <div class="col-md-6">
                            <label class="kv-field-label" for="nv_Email">Email đăng nhập <span class="text-danger">*</span></label>
                            <input type="email" name="Email" id="nv_Email" class="kv-form-control" maxlength="150" required
                                   placeholder="VD: minhanh@nguyetcat.vn" />
                        </div>

                        <div class="col-md-4">
                            <label class="kv-field-label" for="nv_MaVt">Vai trò hệ thống <span class="text-danger">*</span></label>
                            <select name="MaVt" id="nv_MaVt" class="form-select form-select-sm" required>
                                <option value="NHAN_VIEN">Nhân viên Bán hàng</option>
                                <option value="ADMIN">Chủ cửa hàng</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="kv-field-label" for="nv_ChiNhanh">Chi nhánh làm việc</label>
                            <select name="ChiNhanh" id="nv_ChiNhanh" class="form-select form-select-sm">
                                @foreach (var cn in Model.DanhSachChiNhanh)
                                {
                                    <option value="@cn">@cn</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="kv-field-label" for="nv_CaLamViec">Ca làm việc</label>
                            <select name="CaLamViec" id="nv_CaLamViec" class="form-select form-select-sm">
                                @foreach (var ca in Model.DanhSachCaLamViec)
                                {
                                    <option value="@ca">@ca</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="kv-field-label" for="nv_NgayVaoLam">Ngày vào làm</label>
                            <input type="date" name="NgayVaoLam" id="nv_NgayVaoLam" class="kv-form-control"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-4">
                            <label class="kv-field-label" for="nv_TrangThaiLamViec">Trạng thái tài khoản</label>
                            <select name="TrangThaiLamViec" id="nv_TrangThaiLamViec" class="form-select form-select-sm">
                                <option value="DANG_LAM_VIEC">Đang làm việc</option>
                                <option value="TAM_KHOA">Tạm khóa</option>
                            </select>
                        </div>
                        <div class="col-md-4" id="nv_WrapMatKhau">
                            <label class="kv-field-label" for="nv_MatKhauKhoiTao">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
                            <input type="password" name="MatKhauKhoiTao" id="nv_MatKhauKhoiTao" class="kv-form-control"
                                   minlength="6" maxlength="100" placeholder="Tối thiểu 6 ký tự" />
                        </div>

                        <div class="col-12">
                            <label class="kv-field-label" for="nv_GhiChu">Ghi chú nhân sự</label>
                            <textarea name="GhiChu" id="nv_GhiChu" class="form-control" rows="2" maxlength="500"
                                      placeholder="Ghi chú phân công quầy POS, giao nhận hoặc kinh nghiệm..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="kv-modal-footer">
                    <button type="button" class="btn-kv-outline" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn-kv-blue"><i class="bi bi-check2-circle"></i> Lưu hồ sơ nhân viên</button>
                </div>
            </form>
        </div>
    </div>
</div>
