<div class="modal fade" id="modalDatLaiMatKhauNv" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content kv-modal-content">
            <form asp-area="Admin" asp-controller="NhanVienAdmin" asp-action="DatLaiMatKhau" method="post" onsubmit="return kiemTraDatLaiMatKhauNv();">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaNd" id="nvMk_MaNd" value="0" />

                <div class="kv-modal-header pb-2 border-bottom">
                    <div>
                        <h5 class="kv-modal-title">Đặt lại mật khẩu nhân viên</h5>
                        <div class="small text-muted" id="nvMk_ThongTinNhanVien">Tài khoản nhân sự</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="kv-modal-body">
                    <div class="mb-3">
                        <label class="kv-field-label" for="nvMk_MatKhauMoi">Mật khẩu mới <span class="text-danger">*</span></label>
                        <input type="password" name="MatKhauMoi" id="nvMk_MatKhauMoi" class="kv-form-control"
                               minlength="6" maxlength="100" required placeholder="Nhập tối thiểu 6 ký tự" />
                    </div>
                    <div class="mb-1">
                        <label class="kv-field-label" for="nvMk_XacNhanMatKhau">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                        <input type="password" name="XacNhanMatKhau" id="nvMk_XacNhanMatKhau" class="kv-form-control"
                               minlength="6" maxlength="100" required placeholder="Nhập lại mật khẩu mới" />
                    </div>
                </div>

                <div class="kv-modal-footer">
                    <button type="button" class="btn-kv-outline" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn-kv-blue"><i class="bi bi-key"></i> Cập nhật mật khẩu</button>
                </div>
            </form>
        </div>
    </div>
</div>
