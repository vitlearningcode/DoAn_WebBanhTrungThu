@model WebBanhTrungThu.ViewModels.SoQuyAdminViewModel
@{
    ViewData["Title"] = "Sổ quỹ - KiotViet";
    decimal tongChiThucTe = Model.TongGiaVonUocTinh + Model.TongTienHoanKhach;
}

<style>
    .kv-page-heading {
        font-size: 20px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 14px 0;
    }

    .kv-select, .kv-input {
        width: 100%;
        height: 34px;
        border: 1px solid #D1D5DA;
        border-radius: 6px;
        padding: 0 10px;
        font-size: 13px;
        color: #1F2937;
        background-color: #FFFFFF;
        outline: none;
    }

    .kv-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

    .kv-search-box {
        position: relative;
        width: 340px;
        max-width: 100%;
    }

    .kv-search-box i {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        color: #6B7280;
        font-size: 14px;
    }

    .kv-search-box input {
        width: 100%;
        height: 36px;
        padding: 0 12px 0 34px;
        border: 1px solid #D1D5DA;
        border-radius: 6px;
        background: #FFFFFF;
        font-size: 13.5px;
        color: #1F2937;
        outline: none;
    }
</style>

<!-- THANH 4 CHỈ SỐ ĐẦU TRANG SỔ QUỸ CHUẨN KIOTVIET -->
<div class="kv-card p-3 mb-3">
    <div class="row g-3 text-end align-items-center">
        <div class="col-md-3 border-end pe-4">
            <div class="text-muted small">Quỹ đầu kỳ</div>
            <div class="fs-5 fw-bold text-dark">@Model.QuyDauKy.ToString("N0")</div>
        </div>
        <div class="col-md-3 border-end pe-4">
            <div class="text-muted small">Tổng thu (Đơn đã thanh toán)</div>
            <div class="fs-5 fw-bold" style="color: #0070F4;">+@Model.TongThuTrongKy.ToString("N0")</div>
        </div>
        <div class="col-md-3 border-end pe-4">
            <div class="text-muted small">Tổng chi (Giá vốn & Hoàn tiền)</div>
            <div class="fs-5 fw-bold text-danger">-@tongChiThucTe.ToString("N0")</div>
            @if (Model.TongTienHoanKhach > 0)
            {
                <small class="text-danger">Hoàn tiền hủy đơn: -@Model.TongTienHoanKhach.ToString("N0")</small>
            }
        </div>
        <div class="col-md-3 pe-3">
            <div class="text-muted small">Tồn quỹ / Lợi nhuận gộp</div>
            <div class="fs-5 fw-bold text-success">@Model.LoiNhuanGop.ToString("N0")</div>
            <small class="text-muted">Tồn quỹ cuối: @Model.TonQuyCuoiKy.ToString("N0")</small>
        </div>
    </div>
</div>

<div class="kv-layout-2col">
    <!-- ========================================================================= -->
    <!-- CỘT TRÁI (250PX): BỘ LỌC SỔ QUỸ CHUẨN KIOTVIET                            -->
    <!-- ========================================================================= -->
    <aside class="kv-sidebar-filter">
        <h1 class="kv-page-heading">Sổ quỹ</h1>

        <div>
            <!-- 1. Loại chứng từ -->
            <div class="kv-filter-box">
                <div class="kv-filter-title">
                    <span>Loại chứng từ</span>
                    <i class="bi bi-chevron-up text-muted" style="font-size: 11px;"></i>
                </div>
                <div class="d-flex flex-column gap-1">
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="fltSqLoaiCt" value="ALL" checked onchange="locSoQuyClient()" />
                        <span>Tất cả chứng từ</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="fltSqLoaiCt" value="PHIEU_THU" onchange="locSoQuyClient()" />
                        <span>Phiếu thu đơn hàng</span>
                    </label>
                    <label class="d-flex align-items-center justify-content-between" style="cursor:pointer;">
                        <span class="d-flex align-items-center gap-2">
                            <input type="radio" name="fltSqLoaiCt" value="PHIEU_HOAN_TIEN" onchange="locSoQuyClient()" />
                            <span>Phiếu chi hoàn tiền khách</span>
                        </span>
                        <span class="badge bg-danger-subtle text-danger">@Model.DanhSachPhieuHoanTien.Count</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="fltSqLoaiCt" value="GIA_VON" onchange="locSoQuyClient()" />
                        <span>Giá vốn lô bánh</span>
                    </label>
                </div>
            </div>

            <!-- 2. Phương thức thanh toán -->
            <div class="kv-filter-box">
                <div class="kv-filter-title">
                    <span>Phương thức</span>
                    <i class="bi bi-chevron-up text-muted" style="font-size: 11px;"></i>
                </div>
                <div class="d-flex flex-column gap-2">
                    <label class="d-flex align-items-center justify-content-between" style="cursor:pointer;">
                        <span class="d-flex align-items-center gap-2">
                            <input type="radio" name="fltSqPhuongThuc" value="ALL" checked onchange="locSoQuyClient()" />
                            <span>Tất cả</span>
                        </span>
                        <span class="text-muted small">@Model.TongThuTrongKy.ToString("N0")</span>
                    </label>
                    <label class="d-flex align-items-center justify-content-between" style="cursor:pointer;">
                        <span class="d-flex align-items-center gap-2">
                            <input type="radio" name="fltSqPhuongThuc" value="COD" onchange="locSoQuyClient()" />
                            <span>Tiền mặt COD</span>
                        </span>
                        <span class="text-muted small">@Model.ThuTienMatCod.ToString("N0")</span>
                    </label>
                    <label class="d-flex align-items-center justify-content-between" style="cursor:pointer;">
                        <span class="d-flex align-items-center gap-2">
                            <input type="radio" name="fltSqPhuongThuc" value="VIETQR" onchange="locSoQuyClient()" />
                            <span>Chuyển khoản VietQR</span>
                        </span>
                        <span class="text-muted small">@Model.ThuChuyenKhoanVietQr.ToString("N0")</span>
                    </label>
                    <label class="d-flex align-items-center justify-content-between" style="cursor:pointer;">
                        <span class="d-flex align-items-center gap-2">
                            <input type="radio" name="fltSqPhuongThuc" value="VI_DIEN_TU" onchange="locSoQuyClient()" />
                            <span>Ví MoMo / VNPay</span>
                        </span>
                        <span class="text-muted small">@((Model.ThuViMoMo + Model.ThuVnPay).ToString("N0"))</span>
                    </label>
                </div>
            </div>
        </div>
    </aside>

    <!-- ========================================================================= -->
    <!-- CỘT PHẢI: BẢNG PHIẾU THU / CHI SỔ QUỸ CHUẨN KIOTVIET                      -->
    <!-- ========================================================================= -->
    <div class="kv-main-table-area">
        <div class="kv-toolbar">
            <div class="kv-search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="txtTimSoQuy" placeholder="Theo mã phiếu, mã hóa đơn, người nộp / nhận hoàn tiền"
                       oninput="locSoQuyClient()" />
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button type="button" class="btn-kv-primary" data-bs-toggle="modal" data-bs-target="#modalCauHinhQrMoMo">
                    ⚙️ Cấu hình Tài khoản QR / MoMo nhận tiền (@Model.CauHinhQr.SoDienThoaiHienThi)
                </button>
                <button type="button" class="btn-kv-outline" onclick="window.print();">
                    <i class="bi bi-download"></i> Xuất file
                </button>
            </div>
        </div>

        @if (TempData["ThongBaoAdmin"] != null)
        {
            <div class="alert alert-success py-2 px-3 small mb-3">
                <i class="bi bi-check-circle-fill me-1"></i>@TempData["ThongBaoAdmin"]
            </div>
        }

        <div class="kv-card overflow-hidden">
            <div class="table-responsive">
                <table class="kv-table">
                    <thead>
                        <tr>
                            <th>Mã phiếu</th>
                            <th>Thời gian</th>
                            <th>Loại thu chi</th>
                            <th>Người nộp / nhận</th>
                            <th>Phương thức / Ngân hàng</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Giá trị</th>
                        </tr>
                    </thead>
                    <tbody id="tbodySoQuy">
                        <!-- 1. CÁC PHIẾU CHI HOÀN TIỀN KHÁCH HÀNG (ĐƠN ĐÃ HỦY & ĐÃ HOÀN TIỀN VIETQR) -->
                        @foreach (var dhHoan in Model.DanhSachPhieuHoanTien)
                        {
                            string searchHoan = $"PCH{dhHoan.MaDh:D5} {dhHoan.MaTraCuuDh} {dhHoan.HoTenNguoiMua} {dhHoan.SdtnguoiMua} {dhHoan.MaNganHangHoan} {dhHoan.SoTaiKhoanHoan}".ToLowerInvariant();
                            <tr class="border-bottom" style="background-color: #FEF2F2;"
                                data-loaict="PHIEU_HOAN_TIEN"
                                data-pt="VIETQR"
                                data-search="@searchHoan">
                                <td class="fw-semibold text-danger">PCH@(dhHoan.MaDh.ToString("D5"))</td>
                                <td>@(dhHoan.ThoiGianCapNhatCuoi ?? dhHoan.NgayDat.ToString("dd/MM/yyyy HH:mm"))</td>
                                <td>
                                    <span class="fw-semibold text-danger">Phiếu Chi Hoàn Tiền Khách Hàng</span>
                                    (<a href="/Admin/DonHangAdmin/Index?tuKhoa=@dhHoan.MaTraCuuDh" class="text-decoration-none fw-medium" style="color: #0070F4;">#@dhHoan.MaTraCuuDh</a>)
                                    @if (!string.IsNullOrWhiteSpace(dhHoan.LyDoHuyHoan))
                                    {
                                        <div class="small text-muted">Lý do: @dhHoan.LyDoHuyHoan</div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@dhHoan.HoTenNguoiMua</div>
                                    <small class="text-muted">@dhHoan.SdtnguoiMua</small>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">VietQR (@(dhHoan.MaNganHangHoan ?? "Ngân hàng"))</div>
                                    <small class="text-danger fw-medium">STK: @(dhHoan.SoTaiKhoanHoan ?? "---") • @(dhHoan.TenChuTkHoan ?? dhHoan.HoTenNguoiMua)</small>
                                </td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Đã hoàn tiền</span>
                                </td>
                                <td class="text-end fw-bold text-danger so-tien">-@dhHoan.TongThanhToanCuoi.ToString("N0")</td>
                            </tr>
                        }

                        <!-- 2. CÁC PHIẾU THU ĐƠN HÀNG & GIÁ VỐN LÔ BÁNH (ĐƠN HIỆU LỰC) -->
                        @foreach (var dh in Model.DanhSachPhieuThuDonHang)
                        {
                            string searchKey = $"TTH{dh.MaDh:D5} {dh.MaTraCuuDh} {dh.HoTenNguoiMua} {dh.SdtnguoiMua}".ToLowerInvariant();
                            decimal giaVonDon = Math.Round(dh.TongTienHang * 0.54m, 0);
                            string tenPhuongThucSq = (dh.PhuongThucTt ?? "").ToUpperInvariant() switch
                            {
                                "COD" => "Tiền mặt (COD)",
                                "TIEN_MAT" => "Tiền mặt tại quầy",
                                 "VIETQR" or "CHUYEN_KHOAN" => "Chuyển khoản VietQR",
                                 "MOMO" or "MOMO_QR" => $"Ví MoMo / QR ({Model.CauHinhQr.SoDienThoaiHienThi})",
                                 "VNPAY" => "Ví VNPay",
                                 "THE_NGAN_HANG" => "Quẹt thẻ ngân hàng",
                                 _ => dh.PhuongThucTt ?? "Tiền mặt"
                             };
                             bool daThuTien = dh.TrangThaiTt == "DA_TT" || dh.TrangThaiTt == "DA_THANH_TOAN";

                             <!-- Dòng Phiếu thu đơn hàng -->
                             <tr class="border-bottom"
                                 data-loaict="PHIEU_THU"
                                 data-pt="@dh.PhuongThucTt"
                                 data-search="@searchKey">
                                 <td class="fw-medium" style="color: #0070F4;">TTH@(dh.MaDh.ToString("D5"))</td>
                                 <td>@dh.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                                 <td>
                                     Thu tiền khách trả
                                     (<a href="/Admin/DonHangAdmin/Index?tuKhoa=@dh.MaTraCuuDh" class="text-decoration-none" style="color: #0070F4;">#@dh.MaTraCuuDh</a>)
                                 </td>
                                 <td>
                                     <div class="fw-medium text-dark">@dh.HoTenNguoiMua</div>
                                     <small class="text-muted">@dh.SdtnguoiMua</small>
                                 </td>
                                 <td>@tenPhuongThucSq</td>
                                 <td>
                                     <span class="badge @(daThuTien ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle")">
                                         @(daThuTien ? "Đã thanh toán" : dh.TenTrangThaiThanhToanHienThi)
                                     </span>
                                 </td>
                                 <td class="text-end fw-semibold so-tien" style="color: #0070F4;">+@dh.TongThanhToanCuoi.ToString("N0")</td>
                             </tr>

                            <!-- Dòng Giá vốn lô bánh tương ứng (hiển thị khi chọn Tất cả hoặc Giá vốn lô bánh) -->
                            <tr class="border-bottom"
                                data-loaict="GIA_VON"
                                data-pt="@dh.PhuongThucTt"
                                data-search="@searchKey">
                                <td class="fw-medium text-secondary">PCV@(dh.MaDh.ToString("D5"))</td>
                                <td>@dh.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-muted">
                                    Giá vốn lô bánh & vỏ hộp xuất kho (#@dh.MaTraCuuDh)
                                </td>
                                <td>
                                    <span class="text-muted">Kho Đại lý Phân phối</span>
                                </td>
                                <td>Hạch toán kho</td>
                                <td><span class="text-muted">Đã hoàn thành</span></td>
                                <td class="text-end fw-medium text-danger">-@giaVonDon.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function locSoQuyClient() {
            const tk = (document.getElementById('txtTimSoQuy')?.value || '').trim().toLowerCase();
            const loaiCt = document.querySelector('input[name="fltSqLoaiCt"]:checked')?.value || 'ALL';
            const pt = document.querySelector('input[name="fltSqPhuongThuc"]:checked')?.value || 'ALL';

            document.querySelectorAll('#tbodySoQuy tr').forEach(tr => {
                let hien = true;
                if (tk !== '') {
                    const s = tr.getAttribute('data-search') || '';
                    if (!s.includes(tk)) hien = false;
                }
                if (hien && loaiCt !== 'ALL') {
                    if (tr.getAttribute('data-loaict') !== loaiCt) hien = false;
                }
                if (hien && pt !== 'ALL') {
                    const rowPt = tr.getAttribute('data-pt') || '';
                    if (pt === 'VI_DIEN_TU') {
                        if (rowPt !== 'MOMO' && rowPt !== 'MOMO_QR' && rowPt !== 'VNPAY') hien = false;
                    } else if (rowPt !== pt) {
                        hien = false;
                    }
                }
                tr.style.display = hien ? '' : 'none';
            });
        }
    </script>
}

<!-- MODAL CẤU HÌNH TÀI KHOẢN QR / MOMO NHẬN TIỀN -->
<div class="modal fade" id="modalCauHinhQrMoMo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-area="Admin" asp-controller="SoQuyAdmin" asp-action="CapNhatCauHinhQrMoMo" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="/Admin/SoQuy" />
                <div class="modal-header bg-primary text-white py-2">
                    <h6 class="modal-title fw-bold mb-0">⚙️ Cấu hình Tài khoản QR / MoMo nhận tiền</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Số điện thoại / Số tài khoản MoMo nhận tiền *</label>
                        <input type="text" name="soTaiKhoanMoMo" class="form-control form-control-sm fw-bold"
                               value="@Model.CauHinhQr.SoTaiKhoanMoMo" required placeholder="VD: 0814585526" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên chủ tài khoản (In hoa không dấu) *</label>
                        <input type="text" name="tenChuTaiKhoan" class="form-control form-control-sm text-uppercase fw-bold"
                               value="@Model.CauHinhQr.TenChuTaiKhoan" required placeholder="VD: LE MINH DUC" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Ví / Ngân hàng</label>
                            <input type="text" name="maNganHang" class="form-control form-control-sm"
                                   value="@Model.CauHinhQr.MaNganHang" placeholder="MOMO" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Mã BIN VietQR</label>
                            <input type="text" name="maBinVietQr" class="form-control form-control-sm"
                                   value="@Model.CauHinhQr.MaBinVietQr" placeholder="970422" />
                        </div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label small fw-bold">Cú pháp nội dung chuyển khoản tự động</label>
                        <input type="text" name="mauNoiDungCk" class="form-control form-control-sm"
                               value="@Model.CauHinhQr.MauNoiDungCk" placeholder="NGUYETCAT {MaTraCuuDh}" />
                        <small class="text-muted" style="font-size: 11.5px;">Webhook <code>/api/webhook/momo</code> sẽ tự động đối soát theo mã đơn.</small>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sm btn-primary fw-bold">Lưu cấu hình QR / MoMo</button>
                </div>
            </form>
        </div>
    </div>
</div>
