@model WebBanhTrungThu.ViewModels.SoQuyAdminViewModel
@{
    ViewData["Title"] = "Sổ Quỹ Tiền Mặt, Ngân Hàng & Lợi Nhuận Gộp";
    string locPt = ViewBag.LocPhuongThuc as string ?? "ALL";
}

<!-- HÀNG TRÊN: THANH CHỈ SỐ DÒNG TIỀN KIOTVIET SỔ QUỸ -->
<div class="kv-card p-3 mb-3">
    <div class="row g-3 text-center">
        <div class="col-md-3 border-end">
            <div class="text-muted small fw-semibold text-uppercase">Quỹ đầu kỳ</div>
            <div class="fs-4 fw-bold text-dark">@Model.QuyDauKy.ToString("N0") đ</div>
            <small class="text-muted">Vốn lưu động đầu mùa vụ</small>
        </div>
        <div class="col-md-3 border-end">
            <div class="text-muted small fw-semibold text-uppercase">Tổng thu bán hàng (+)</div>
            <div class="fs-4 fw-bold text-primary">+@Model.TongThuTrongKy.ToString("N0") đ</div>
            <small class="text-success">COD • VietQR • VNPAY • MoMo</small>
        </div>
        <div class="col-md-3 border-end">
            <div class="text-muted small fw-semibold text-uppercase">Tổng giá vốn & Chi nguyên liệu (-)</div>
            <div class="fs-4 fw-bold text-danger">-@Model.TongGiaVonUocTinh.ToString("N0") đ</div>
            <small class="text-muted">Chi phí nhân bánh & vỏ hộp</small>
        </div>
        <div class="col-md-3">
            <div class="text-muted small fw-semibold text-uppercase">Lợi nhuận gộp / Tồn quỹ</div>
            <div class="fs-4 fw-bold text-success">@Model.LoiNhuanGop.ToString("N0") đ</div>
            <small class="text-primary fw-semibold">Tồn quỹ cuối: @Model.TonQuyCuoiKy.ToString("N0") đ</small>
        </div>
    </div>
</div>

<div class="kv-layout-2col">
    <!-- CỘT TRÁI (260PX): LỌC THEO QUỸ TIỀN MẶT / NGÂN HÀNG / VÍ -->
    <aside class="kv-sidebar-filter">
        <form method="get" action="/Admin/SoQuyAdmin/Index">
            <div class="kv-filter-box mb-3">
                <div class="kv-filter-title">
                    <span>💳 Loại quỹ & Phương thức</span>
                </div>
                <div class="d-flex flex-column gap-2">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="locPhuongThuc" value="ALL" id="pt_all"
                               @(locPt == "ALL" ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label d-flex justify-content-between" for="pt_all">
                            <span>Tất cả quỹ</span>
                            <strong>@Model.TongThuTrongKy.ToString("N0")</strong>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="locPhuongThuc" value="COD" id="pt_cod"
                               @(locPt == "COD" ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label d-flex justify-content-between" for="pt_cod">
                            <span>💵 Tiền mặt (COD)</span>
                            <strong class="text-success">@Model.ThuTienMatCod.ToString("N0")</strong>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="locPhuongThuc" value="VIETQR" id="pt_vqr"
                               @(locPt == "VIETQR" ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label d-flex justify-content-between" for="pt_vqr">
                            <span>🏦 VietQR 24/7</span>
                            <strong class="text-primary">@Model.ThuChuyenKhoanVietQr.ToString("N0")</strong>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="locPhuongThuc" value="MOMO" id="pt_momo"
                               @(locPt == "MOMO" ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label d-flex justify-content-between" for="pt_momo">
                            <span>👛 Ví MoMo</span>
                            <strong class="text-danger">@Model.ThuViMoMo.ToString("N0")</strong>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="locPhuongThuc" value="VNPAY" id="pt_vnp"
                               @(locPt == "VNPAY" ? "checked" : "") onchange="this.form.submit()">
                        <label class="form-check-label d-flex justify-content-between" for="pt_vnp">
                            <span>💳 Cổng VNPAY</span>
                            <strong class="text-info">@Model.ThuVnPay.ToString("N0")</strong>
                        </label>
                    </div>
                </div>
            </div>
        </form>
    </aside>

    <!-- CỘT PHẢI: BẢNG PHIẾU THU SỔ QUỸ CHUẨN KIOTVIET -->
    <div class="kv-main-table-area">
        <div class="kv-card overflow-hidden">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold text-uppercase mb-0 text-dark">
                    <i class="bi bi-journal-check text-primary me-2"></i>DANH SÁCH PHIẾU THU BÁN HÀNG (@Model.DanhSachPhieuThuDonHang.Count PHIẾU)
                </h6>
                <span class="badge bg-primary">Sổ quỹ tự động đối soát</span>
            </div>

            <div class="table-responsive">
                <table class="kv-table">
                    <thead>
                        <tr>
                            <th>Mã phiếu thu</th>
                            <th>Chứng từ gốc</th>
                            <th>Thời gian</th>
                            <th>Người nộp (Khách mua)</th>
                            <th>Phương thức</th>
                            <th>Trạng thái thu</th>
                            <th class="text-end">Giá trị thu (+)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dh in Model.DanhSachPhieuThuDonHang)
                        {
                            <tr class="border-bottom">
                                <td><code class="fw-bold text-success">TTH@(dh.MaDh.ToString("D5"))</code></td>
                                <td>
                                    <a href="/Admin/DonHangAdmin/ChiTiet/@dh.MaDh" class="fw-bold text-primary text-decoration-none">
                                        #@dh.MaTraCuuDh
                                    </a>
                                </td>
                                <td>@dh.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="fw-semibold text-dark">@dh.HoTenNguoiMua</div>
                                    <small class="text-muted">@dh.SdtnguoiMua • @(dh.LaDonDoanhNghiepB2b ? "Đơn sỉ B2B" : "Đơn lẻ B2C")</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@dh.PhuongThucTt</span></td>
                                <td>
                                    <span class="badge @(dh.TrangThaiTt == "DA_TT" ? "bg-success" : "bg-warning text-dark")">
                                        @dh.TrangThaiTt
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-primary">+@dh.TongThanhToanCuoi.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

