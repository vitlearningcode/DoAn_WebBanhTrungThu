@model WebBanhTrungThu.ViewModels.BanHangPosViewModel
@using System.Text.Json
@using System.Text.Encodings.Web
@using WebBanhTrungThu.Services
@{
    var jsonOptions = new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    var dsBanhPosJson = JsonSerializer.Serialize(Model.DanhSachBanh.Select(b => new
    {
        loai = 1, maBanh = b.MaBanh, maSku = b.MaSku, maVach = b.MaVach, ten = b.TenBanh, thuongHieu = b.ThuongHieu,
        donViTinh = string.IsNullOrWhiteSpace(b.DonViTinh) ? "Cái" : b.DonViTinh,
        giaGoc = Math.Round(b.DonGiaLe, 0), giaBan = Math.Round(b.DonGiaThucTe, 0),
        phanTramCanDate = Math.Round(b.PhanTramGiamCanDateHieuLuc, 0), dangXaCanDate = b.DangXaCanDate,
        tonKho = b.TongTonKho, mucDoNgot = b.MucDoNgot, laBanhThuongHang = b.LaBanhThuongHang, laBanhChay = b.LaBanhChay,
        calo = b.ThongSoDinhDuong?.NangLuongCalo ?? 380, anh = DichVuHinhAnh.LayUrl(Model.TuDienAnh, "BANH", b.MaBanh, "ANH_CHINH")
    }), jsonOptions);

    var dsComboPosJson = JsonSerializer.Serialize(Model.DanhSachCombo.Select(c => new
    {
        loai = 2, maCb = c.MaCb, maSku = c.MaCodeCb, maVach = c.MaVach, ten = c.TenCombo, thuongHieu = c.ThuongHieu,
        donViTinh = "Hộp", giaGoc = Math.Round(c.GiaNiemYet, 0), giaBan = Math.Round(c.GiaUuDaiCombo, 0),
        tonKho = c.MaVhNavigation != null ? Math.Min(c.TongTonKho, c.MaVhNavigation.SltonKhoVo) : c.TongTonKho,
        tenVoHop = c.MaVhNavigation?.TenVoHop ?? "Hộp tiêu chuẩn",
        chiTietBanh = string.Join(", ", c.ChiTietComboMaus.OrderBy(x => x.ViTriO).Select(x => $"Ô {x.ViTriO}: {x.MaBanhNavigation?.TenBanh}")),
        anh = Model.TuDienAnh.ContainsKey($"COMBO_{c.MaCb}_ANH_CHINH") ? Model.TuDienAnh[$"COMBO_{c.MaCb}_ANH_CHINH"] : DichVuHinhAnh.LayUrl(Model.TuDienAnh, "VO_HOP", c.MaVh, "ANH_CHINH")
    }), jsonOptions);

    var dsVoHopPosJson = JsonSerializer.Serialize(Model.DanhSachVoHop.Select(v => new
    {
        maVh = v.MaVh, maCodeVh = v.MaCodeVh, tenVoHop = v.TenVoHop, sucChua = v.SucChuaBanh,
        giaVoHop = Math.Round(v.GiaVoHopRieng, 0), tonKhoVo = v.SltonKhoVo, slVipToiThieu = v.SlbanhThuongHangToiThieu,
        anh = DichVuHinhAnh.LayUrl(Model.TuDienAnh, "VO_HOP", v.MaVh, "ANH_CHINH")
    }), jsonOptions);

    var bangB2BJson = JsonSerializer.Serialize(Model.BangChietKhauSiB2B.Select(b => new
    {
        tenMoc = b.TenMocB2b, tuHop = b.SlhopToiThieu, denHop = b.SlhopToiDa,
        phanTramCk = Math.Round(b.PhanTramChietKhau, 0), mienPhiInLogo = b.MienPhiInLogo, phiKhuon = Math.Round(b.PhiKhuonInLogo, 0)
    }), jsonOptions);

    var dsVoucherJson = JsonSerializer.Serialize(Model.DanhSachKhuyenMai.Select(k => new
    {
        codeKm = k.CodeKm, ten = k.TenChuongTrinh, loaiGiam = k.LoaiGiam,
        giaTriGiam = Math.Round(k.GiaTriGiam, 0), giamToiDa = Math.Round(k.GiamToiDa, 0), donToiThieu = Math.Round(k.DonToiThieu, 0)
    }), jsonOptions);

    var homNayPos = DateOnly.FromDateTime(DateTime.Today);
    var mocCanhBaoPos = DateOnly.FromDateTime(DateTime.Today.AddDays(10));
    var tatCaLoPos = Model.DanhSachBanh.SelectMany(b => b.LoSanXuatBanhs.Select(l => { l.MaBanhNavigation = b; return l; })).Where(l => l.SlconLai > 0).OrderBy(l => l.HanSuDung).ToList();
    var danhSachLoCanhBaoPos = tatCaLoPos.Where(l => l.HanSuDung <= mocCanhBaoPos || l.PhanTramGiamCanDate > 0 || l.TrangThaiLo == "XA_CAN_DATE").Take(3).ToList();
    if (!danhSachLoCanhBaoPos.Any()) { danhSachLoCanhBaoPos = tatCaLoPos.Take(2).ToList(); }
}

<div class="pos-catalog-panel">
    @if (danhSachLoCanhBaoPos.Any())
    {
        <div class="banner-canh-bao-fefo-pos" id="bannerCanhBaoFefoPos">
            @foreach (var loPos in danhSachLoCanhBaoPos)
            {
                int soNgayConPos = Math.Max(0, loPos.HanSuDung.DayNumber - homNayPos.DayNumber);
                bool daApGiaPos = loPos.PhanTramGiamCanDate >= 30;
                <div class="dong-fefo-pos">
                    <div>
                        <i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>
                        <strong>@loPos.MaLoCode</strong> •
                        <span class="fw-semibold">@(loPos.MaBanhNavigation?.TenBanh ?? "Bánh Trung Thu")</span> •
                        <span class="ton-kho">Tồn kho: <strong>@loPos.SlconLai.ToString("N0")</strong> bánh</span> •
                        <span class="ton-kho">Còn <strong>@soNgayConPos</strong> ngày sử dụng</span>
                    </div>
                    <div>
                        @if (daApGiaPos)
                        {
                            <button type="button" class="nut-xa-kho-pos da-ap-gia-xa" disabled>✓ Đã áp giá xả kho -@(loPos.PhanTramGiamCanDate.ToString("N0"))%</button>
                        }
                        else
                        {
                            <button type="button" class="nut-xa-kho-pos" onclick="kichHoatXaKhoNhanhPos(@loPos.MaLo, @loPos.MaBanh, this)">⚡ Kích hoạt xả kho -30%</button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <div class="pos-pill-bar" id="barLocPillPos">
        <button type="button" class="pos-filter-pill active" onclick="chonPillLocPos(this, 'ALL')">Tất cả</button>
        <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'TH_Kinh Đô')">Kinh Đô</button>
        <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'TH_Đồng Khánh')">Đồng Khánh</button>
        <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'TH_Như Lan')">Như Lan</button>
        <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'TH_Brodard')">Brodard</button>
        <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'ISOMALT')">🌿 Đường Isomalt</button>
        <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'COMBO')">🎁 Hộp Combo</button>
    </div>

    <div class="pos-product-grid" id="gridPosProducts"></div>
</div>

<script>
window.POS_CATALOG = {
    dsBanhPos: @Html.Raw(dsBanhPosJson),
    dsComboPos: @Html.Raw(dsComboPosJson),
    dsVoHopPos: @Html.Raw(dsVoHopPosJson),
    bangB2B: @Html.Raw(bangB2BJson),
    dsVoucher: @Html.Raw(dsVoucherJson),
    ngayHenMacDinh: '@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")'
};
</script>
