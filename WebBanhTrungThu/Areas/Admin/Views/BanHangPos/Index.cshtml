@model WebBanhTrungThu.ViewModels.BanHangPosViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Nguyệt Cát ERP Web POS - Bán Hàng Tại Quầy Nguyệt Cát</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/admin-pos.css" asp-append-version="true" />
<script>
window.KV_FALLBACK_SVG = "data:image/svg+xml;utf8," + encodeURIComponent("<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120' viewBox='0 0 120 120'><rect width='120' height='120' rx='10' fill='%23F3F4F6'/><circle cx='60' cy='54' r='26' fill='%23E5E7EB'/><text x='50%' y='98' dominant-baseline='middle' text-anchor='middle' fill='%236B7280' font-family='Inter,sans-serif' font-size='11' font-weight='600'>Nguyệt Cát</text></svg>");
window.kvImgFallback = function (img) {
    if (!img) return;
    img.onerror = null;
    if (img.dataset.fallbackApplied === "1") return;
    img.dataset.fallbackApplied = "1";
    img.src = window.KV_FALLBACK_SVG;
};
</script>
</head>
<body>
<header class="pos-topbar">
    <div class="pos-search-wrap">
        <i class="bi bi-search"></i>
        <input type="text" id="txtPosTimSanPham" class="pos-search-input" placeholder="(F3) Tìm tên bánh, mã SKU, quét mã vạch..." oninput="locSanPhamPos()" onkeydown="if(event.key === 'Enter'){ event.preventDefault(); quetMaVachNhanhPos(this.value); }" />
    </div>
    <div class="pos-tabs-bar" id="barMultiTabsHoaDon"></div>
    <button type="button" class="pos-btn-top-action" onclick="moModalDongHopTuChonPos()" title="Đóng Hộp Quà Tự Chọn (F6)">
        🎁 Đóng Hộp Quà Tự Chọn (F6)
    </button>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-light text-primary fw-semibold px-2 py-1"><i class="bi bi-person-badge me-1"></i>@Model.TenThuNgan (@Model.VaiTroThuNgan)</span>
        <a href="/Admin/Dashboard/Index" class="pos-btn-manage" title="Quay về giao diện Quản lý Nguyệt Cát ERP"><i class="bi bi-bar-chart-line-fill"></i> Về trang Quản lý</a>
    </div>
</header>

<div class="pos-workspace">
<div class="pos-left-col">
<div class="pos-cart-panel">
<div class="pos-cart-table-wrap">
<table class="pos-cart-table">
<thead>
<tr>
<th style="width: 42px;" class="text-center">STT</th>
<th style="width: 105px;">Mã hàng</th>
<th>Tên hàng hóa (kèm chi tiết nhân bánh nếu là hộp)</th>
<th style="width: 65px;" class="text-center">ĐVT</th>
<th style="width: 118px;" class="text-center">Số lượng</th>
<th style="width: 105px;" class="text-end">Đơn giá</th>
<th style="width: 115px;" class="text-end">Thành tiền</th>
<th style="width: 42px;" class="text-center"></th>
</tr>
</thead>
<tbody id="tbodyPosCart"></tbody>
</table>
</div>
</div>
@await Html.PartialAsync("~/Areas/Admin/Views/BanHangPos/PhanKhu/_LuoiSanPhamPos.cshtml", Model)
</div>
@await Html.PartialAsync("~/Areas/Admin/Views/BanHangPos/PhanKhu/_KhungThanhToanVaModalPos.cshtml", Model)
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/admin-pos.js" asp-append-version="true"></script>
<script src="~/js/modules/pos-in-hoa-don-k80.js" asp-append-version="true"></script>
</body>
</html>
