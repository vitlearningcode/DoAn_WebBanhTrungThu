@model WebBanhTrungThu.ViewModels.BanHangPosViewModel
@using System.Text.Json
@using System.Text.Encodings.Web
@using WebBanhTrungThu.Services
@{
    Layout = null;
    var jsonOptions = new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    var dsBanhPosJson = JsonSerializer.Serialize(Model.DanhSachBanh.Select(b => new
    {
        loai = 1, maBanh = b.MaBanh, maSku = b.MaSku, maVach = b.MaVach, ten = b.TenBanh, thuongHieu = b.ThuongHieu,
        donViTinh = string.IsNullOrWhiteSpace(b.DonViTinh) ? "Cái" : b.DonViTinh,
        giaGoc = Math.Round(b.DonGiaLe, 0), giaBan = Math.Round(b.DonGiaThucTe, 0),
        phanTramCanDate = Math.Round(b.PhanTramGiamCanDateHieuLuc, 0), dangXaCanDate = b.DangXaCanDate,
        tonKho = b.TongTonKho, mucDoNgot = b.MucDoNgot, laBanhThuongHang = b.LaBanhThuongHang, laBanhChay = b.LaBanhChay,
        calo = b.ThongSoDinhDuong?.NangLuongCalo ?? 380, anh = DichVuHinhAnh.LayUrl(Model.TuDienAnh, "BANH", b.MaBanh, "ANH_CHINH")
    }), jsonOptions);

    var dsComboPosJson = JsonSerializer.Serialize(Model.DanhSachCombo.Select(c => new
    {
        loai = 2, maCb = c.MaCb, maSku = c.MaCodeCb, maVach = c.MaVach, ten = c.TenCombo, thuongHieu = c.ThuongHieu,
        donViTinh = "Hộp", giaGoc = Math.Round(c.GiaNiemYet, 0), giaBan = Math.Round(c.GiaUuDaiCombo, 0),
        tonKho = c.MaVhNavigation != null ? Math.Min(c.TongTonKho, c.MaVhNavigation.SltonKhoVo) : c.TongTonKho,
        tenVoHop = c.MaVhNavigation?.TenVoHop ?? "Hộp tiêu chuẩn",
        chiTietBanh = string.Join(", ", c.ChiTietComboMaus.OrderBy(x => x.ViTriO).Select(x => $"Ô {x.ViTriO}: {x.MaBanhNavigation?.TenBanh}")),
        anh = Model.TuDienAnh.ContainsKey($"COMBO_{c.MaCb}_ANH_CHINH") ? Model.TuDienAnh[$"COMBO_{c.MaCb}_ANH_CHINH"] : DichVuHinhAnh.LayUrl(Model.TuDienAnh, "VO_HOP", c.MaVh, "ANH_CHINH")
    }), jsonOptions);

    var dsVoHopPosJson = JsonSerializer.Serialize(Model.DanhSachVoHop.Select(v => new
    {
        maVh = v.MaVh, maCodeVh = v.MaCodeVh, tenVoHop = v.TenVoHop, sucChua = v.SucChuaBanh,
        giaVoHop = Math.Round(v.GiaVoHopRieng, 0), tonKhoVo = v.SltonKhoVo, slVipToiThieu = v.SlbanhThuongHangToiThieu,
        anh = DichVuHinhAnh.LayUrl(Model.TuDienAnh, "VO_HOP", v.MaVh, "ANH_CHINH")
    }), jsonOptions);

    var bangB2BJson = JsonSerializer.Serialize(Model.BangChietKhauSiB2B.Select(b => new
    {
        tenMoc = b.TenMocB2b, tuHop = b.SlhopToiThieu, denHop = b.SlhopToiDa,
        phanTramCk = Math.Round(b.PhanTramChietKhau, 0), mienPhiInLogo = b.MienPhiInLogo, phiKhuon = Math.Round(b.PhiKhuonInLogo, 0)
    }), jsonOptions);

    var dsVoucherJson = JsonSerializer.Serialize(Model.DanhSachKhuyenMai.Select(k => new
    {
        codeKm = k.CodeKm, ten = k.TenChuongTrinh, loaiGiam = k.LoaiGiam,
        giaTriGiam = Math.Round(k.GiaTriGiam, 0), giamToiDa = Math.Round(k.GiamToiDa, 0), donToiThieu = Math.Round(k.DonToiThieu, 0)
    }), jsonOptions);

    var homNayPos = DateOnly.FromDateTime(DateTime.Today);
    var mocCanhBaoPos = DateOnly.FromDateTime(DateTime.Today.AddDays(10));
    var tatCaLoPos = Model.DanhSachBanh.SelectMany(b => b.LoSanXuatBanhs.Select(l => { l.MaBanhNavigation = b; return l; })).Where(l => l.SlconLai > 0).OrderBy(l => l.HanSuDung).ToList();
    var danhSachLoCanhBaoPos = tatCaLoPos.Where(l => l.HanSuDung <= mocCanhBaoPos || l.PhanTramGiamCanDate > 0 || l.TrangThaiLo == "XA_CAN_DATE").Take(3).ToList();
    if (!danhSachLoCanhBaoPos.Any()) { danhSachLoCanhBaoPos = tatCaLoPos.Take(2).ToList(); }
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>KiotViet Web POS - Bán Hàng Tại Quầy Nguyệt Cát</title>
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/admin-pos.css" asp-append-version="true" />
<script>
window.KV_FALLBACK_SVG = "data:image/svg+xml;utf8," + encodeURIComponent("<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120' viewBox='0 0 120 120'><rect width='120' height='120' rx='10' fill='%23F3F4F6'/><circle cx='60' cy='54' r='26' fill='%23E5E7EB'/><text x='50%' y='98' dominant-baseline='middle' text-anchor='middle' fill='%236B7280' font-family='Inter,sans-serif' font-size='11' font-weight='600'>Nguyệt Cát</text></svg>");
window.kvImgFallback = function (img) {
    if (!img) return;
    img.onerror = null;
    if (img.dataset.fallbackApplied === "1") return;
    img.dataset.fallbackApplied = "1";
    img.src = window.KV_FALLBACK_SVG;
};
</script>
</head>
<body>
<header class="pos-topbar">
    <div class="pos-search-wrap">
        <i class="bi bi-search"></i>
        <input type="text" id="txtPosTimSanPham" class="pos-search-input" placeholder="(F3) Tìm tên bánh, mã SKU, quét mã vạch..." oninput="locSanPhamPos()" onkeydown="if(event.key === 'Enter'){ event.preventDefault(); quetMaVachNhanhPos(this.value); }" />
    </div>
    <div class="pos-tabs-bar" id="barMultiTabsHoaDon"></div>
    <button type="button" class="pos-btn-top-action" onclick="moModalDongHopTuChonPos()">
        <i class="bi bi-gift-fill"></i> Đóng hộp tự chọn cho khách (F6)
    </button>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-light text-primary fw-semibold px-2 py-1"><i class="bi bi-person-badge me-1"></i>@Model.TenThuNgan (@Model.VaiTroThuNgan)</span>
        <a href="/Admin/Dashboard/Index" class="pos-btn-manage" title="Quay về giao diện Quản lý KiotViet"><i class="bi bi-bar-chart-line-fill"></i> Về trang Quản lý</a>
    </div>
</header>

<div class="pos-workspace">
<div class="pos-left-col">
    <div class="pos-cart-panel">
        <div class="pos-cart-table-wrap">
            <table class="pos-cart-table">
                <thead>
                    <tr>
                        <th style="width: 42px;" class="text-center">STT</th>
                        <th style="width: 105px;">Mã hàng</th>
                        <th>Tên hàng hóa (kèm chi tiết nhân bánh nếu là hộp)</th>
                        <th style="width: 65px;" class="text-center">ĐVT</th>
                        <th style="width: 118px;" class="text-center">Số lượng</th>
                        <th style="width: 105px;" class="text-end">Đơn giá</th>
                        <th style="width: 115px;" class="text-end">Thành tiền</th>
                        <th style="width: 42px;" class="text-center"></th>
                    </tr>
                </thead>
                <tbody id="tbodyPosCart"></tbody>
            </table>
        </div>
    </div>

    <div class="pos-catalog-panel">
        @if (danhSachLoCanhBaoPos.Any())
        {
            <div class="banner-canh-bao-fefo-pos" id="bannerCanhBaoFefoPos">
                @foreach (var loPos in danhSachLoCanhBaoPos)
                {
                    int soNgayConPos = Math.Max(0, loPos.HanSuDung.DayNumber - homNayPos.DayNumber);
                    bool daApGiaPos = loPos.PhanTramGiamCanDate >= 30;
                    <div class="dong-fefo-pos">
                        <div>
                            <i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>
                            <strong>@loPos.MaLoCode</strong> •
                            <span class="fw-semibold">@(loPos.MaBanhNavigation?.TenBanh ?? "Bánh Trung Thu")</span> •
                            <span class="ton-kho">Tồn kho: <strong>@loPos.SlconLai.ToString("N0")</strong> bánh</span> •
                            <span class="ton-kho">Còn <strong>@soNgayConPos</strong> ngày sử dụng</span>
                        </div>
                        <div>
                            @if (daApGiaPos)
                            {
                                <button type="button" class="nut-xa-kho-pos da-ap-gia-xa" disabled>✓ Đã áp giá xả kho -@(loPos.PhanTramGiamCanDate.ToString("N0"))%</button>
                            }
                            else
                            {
                                <button type="button" class="nut-xa-kho-pos" onclick="kichHoatXaKhoNhanhPos(@loPos.MaLo, @loPos.MaBanh, this)">⚡ Kích hoạt xả kho -30%</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="pos-pill-bar" id="barLocPillPos">
            <button type="button" class="pos-filter-pill active" onclick="chonPillLocPos(this, 'ALL')">Tất cả</button>
            <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'TH_Kinh Đô')">Kinh Đô</button>
            <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'TH_Đồng Khánh')">Đồng Khánh</button>
            <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'TH_Như Lan')">Như Lan</button>
            <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'TH_Brodard')">Brodard</button>
            <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'ISOMALT')">🌿 Đường Isomalt</button>
            <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'COMBO')">🎁 Hộp Combo</button>
        </div>

        <div class="pos-product-grid" id="gridPosProducts"></div>
    </div>
</div>

<div class="pos-right-col">
    <div class="pos-right-scroll">
        <div class="mb-2">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold text-dark"><i class="bi bi-person-vcard text-primary me-1"></i> Khách hàng (F4)</span>
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold text-primary" onclick="moModalThemKhachPos()">+ Thêm khách mới</button>
            </div>
            <div class="position-relative" id="boxTimKhachPos">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="txtPosTimKhach" class="form-control" placeholder="Tìm SĐT hoặc tên khách thành viên (F4)..." autocomplete="off" onfocus="timKhachHangPosAjax(this.value)" oninput="timKhachHangPosAjax(this.value)" />
                </div>
                <div class="pos-cust-dropdown" id="dropdownKhachPos"></div>
            </div>
            <div id="boxThongTinKhachDaChon" class="mt-2 p-2 rounded border bg-light" style="display: none;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fw-bold text-primary" id="lblPosTenKhach">---</div>
                        <div class="small text-muted">SĐT: <strong id="lblPosSdtKhach">---</strong> • Hạng: <span class="badge bg-warning text-dark" id="lblPosHangTv">Đồng</span> • Điểm: <strong class="text-success" id="lblPosDiemKhach">0</strong></div>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="boChonKhachHangPos()" title="Đổi về Khách lẻ tại quầy"><i class="bi bi-x-lg"></i></button>
                </div>
            </div>
        </div>

        <div class="pos-mode-switch">
            <button type="button" class="pos-mode-btn active" id="btnModeTaiQuay" onclick="chuyenCheDoMuaPos('TAI_QUAY')">🛍️ Khách lấy ngay tại quầy</button>
            <button type="button" class="pos-mode-btn" id="btnModeGiaoHangQr" onclick="chuyenCheDoMuaPos('GIAO_HANG_QR')">🚚 Đặt giao hàng &amp; Thiệp QR 3D</button>
        </div>

        <div id="boxGiaoHangQrPos" class="p-2 mb-2 rounded border bg-light" style="display: none;">
            <div class="fw-bold text-primary mb-2"><i class="bi bi-truck me-1"></i> Thông tin người nhận &amp; Thiệp Chúc Mừng QR 3D</div>
            <div class="row g-2 mb-2">
                <div class="col-6"><input type="text" id="txtPosTenNguoiNhan" class="form-control form-control-sm" placeholder="Họ tên người nhận *" oninput="luuThongTinTabHienTai()" /></div>
                <div class="col-6"><input type="text" id="txtPosSdtNguoiNhan" class="form-control form-control-sm" placeholder="SĐT người nhận *" oninput="luuThongTinTabHienTai()" /></div>
            </div>
            <div class="mb-2"><input type="text" id="txtPosDiaChiGiao" class="form-control form-control-sm" placeholder="Địa chỉ giao chi tiết *" oninput="luuThongTinTabHienTai()" /></div>
            <div class="row g-2 mb-2">
                <div class="col-6"><input type="date" id="txtPosNgayHenGiao" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" class="form-control form-control-sm" onchange="luuThongTinTabHienTai()" /></div>
                <div class="col-6">
                    <select id="selPosKhungGioGiao" class="form-select form-select-sm" onchange="luuThongTinTabHienTai()">
                        <option value="Sáng (08:00 - 11:30)">Sáng (08:00 - 11:30)</option>
                        <option value="Chiều (13:30 - 17:30)">Chiều (13:30 - 17:30)</option>
                        <option value="Tối (18:00 - 20:30)">Tối (18:00 - 20:30)</option>
                    </select>
                </div>
            </div>
            <div class="form-check mb-1">
                <input type="checkbox" id="chkPosKemThiepQr" class="form-check-input" checked onchange="luuThongTinTabHienTai()" />
                <label class="form-check-label fw-semibold" for="chkPosKemThiepQr">✨ Kèm Thiệp Chúc Mừng 3D QR Code</label>
            </div>
            <textarea id="txtPosLoiChucThiep" rows="2" class="form-control form-control-sm" placeholder="Lời chúc hiển thị khi người nhận quét mã QR 3D..." oninput="luuThongTinTabHienTai()">Kính chúc Quý khách & Gia đình mùa Trăng Rằm Đoàn Viên, Viên Mãn & An Khang!</textarea>
        </div>

        <div class="mt-1">
            <div class="pos-summary-row">
                <span>Tổng tiền hàng <span class="badge bg-secondary ms-1" id="lblPosTongSoMon">0 món</span> <span class="badge bg-info text-dark ms-1" id="lblPosTongSoHop">0 hộp</span></span>
                <strong class="text-dark" id="lblPosTongTienHang">0</strong>
            </div>
            <div class="pos-summary-row">
                <div><span>Chiết khấu sỉ B2B</span><small class="text-success d-block" id="lblPosTenMocB2B">Tự động áp dụng từ 10 hộp</small></div>
                <strong class="text-success" id="lblPosTienCkB2B">-0</strong>
            </div>
            <div class="py-1 border-bottom">
                <label class="d-flex align-items-center justify-content-between">
                    <span><input type="checkbox" id="chkPosYeuCauInLogo" class="form-check-input me-1" onchange="tinhToanHoaDonPos()" /> In Logo Doanh Nghiệp B2B</span>
                    <span class="fw-semibold text-dark" id="lblPosPhiInLogo">0</span>
                </label>
            </div>
            <div class="pos-summary-row">
                <div class="d-flex align-items-center gap-1">
                    <span>Voucher</span>
                    <select id="selPosVoucher" class="form-select form-select-sm py-0 px-2" style="width: 150px; height: 26px;" onchange="tinhToanHoaDonPos()">
                        <option value="">-- Chọn mã KM --</option>
                        @foreach (var km in Model.DanhSachKhuyenMai)
                        {
                            <option value="@km.CodeKm">@km.CodeKm (Đơn &ge; @(km.DonToiThieu.ToString("N0")))</option>
                        }
                    </select>
                </div>
                <strong class="text-success" id="lblPosTienVoucher">-0</strong>
            </div>
            <div class="pos-summary-row" id="rowPosPhiShip" style="display: none;">
                <span>Phí giao hàng tận nơi</span>
                <strong class="text-dark" id="lblPosPhiShip">30,000</strong>
            </div>
            <div class="pos-total-payable-box">
                <span class="fw-bold text-dark">KHÁCH CẦN TRẢ</span>
                <span class="fw-bold fs-5 text-primary" id="lblPosKhachCanTra">0</span>
            </div>
        </div>

        <div class="mt-2">
            <div class="fw-bold text-dark mb-2">Phương thức thanh toán</div>
            <div class="d-flex gap-3 mb-2">
                <label class="d-flex align-items-center gap-1 fw-semibold"><input type="radio" name="radPosPhuongThucTt" value="TIEN_MAT" checked onchange="doiPhuongThucTtPos(this.value)" /><span>💵 Tiền mặt</span></label>
                <label class="d-flex align-items-center gap-1 fw-semibold"><input type="radio" name="radPosPhuongThucTt" value="CHUYEN_KHOAN_QR" onchange="doiPhuongThucTtPos(this.value)" /><span>📱 Chuyển khoản VietQR</span></label>
                <label class="d-flex align-items-center gap-1 fw-semibold"><input type="radio" name="radPosPhuongThucTt" value="VI_DIEN_TU" onchange="doiPhuongThucTtPos(this.value)" /><span>💳 Thẻ/Ví</span></label>
            </div>
            <div id="boxPosTienMat" class="p-2 rounded border bg-light">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold">Tiền khách đưa:</span>
                    <input type="number" id="inpPosTienKhachDua" class="form-control form-control-sm text-end fw-bold" style="width: 150px;" oninput="tinhTienThuaPos()" />
                </div>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    <button type="button" class="pos-denom-btn" onclick="chonMenhGiaPos(0)">Chính xác</button>
                    <button type="button" class="pos-denom-btn" onclick="chonMenhGiaPos(200000)">200,000</button>
                    <button type="button" class="pos-denom-btn" onclick="chonMenhGiaPos(500000)">500,000</button>
                    <button type="button" class="pos-denom-btn" onclick="chonMenhGiaPos(1000000)">1,000,000</button>
                    <button type="button" class="pos-denom-btn" onclick="chonMenhGiaPos(2000000)">2,000,000</button>
                </div>
                <div class="d-flex justify-content-between align-items-center pt-1 border-top">
                    <span class="fw-semibold">Tiền thừa trả khách:</span>
                    <strong class="text-danger" id="lblPosTienThua">0 đ</strong>
                </div>
            </div>
            <div id="boxPosVietQr" class="p-2 rounded border bg-light text-center" style="display: none;">
                <div class="small fw-semibold text-primary mb-1">Quét mã VietQR Ngân hàng Quân Đội (MB Bank - 0814585526)</div>
                <img id="imgPosVietQrLive" src="" alt="Mã VietQR POS" style="max-width: 175px; border-radius: 6px; border: 1px solid #D1D5DB; background: #fff; padding: 4px;" onerror="window.kvImgFallback(this)" />
            </div>
        </div>
    </div>

    <div class="pos-checkout-footer">
        <button type="button" class="pos-btn-pay-f9" id="btnPosThanhToanF9" onclick="thucHienThanhToanPos()">
            <i class="bi bi-printer-fill"></i> THANH TOÁN (F9)
        </button>
    </div>
</div>
</div>

<!-- MODAL ĐÓNG HỘP TỰ CHỌN NHANH TẠI QUẦY (F6) -->
<div class="modal fade" id="modalDongHopPos" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header py-2 px-3 bg-primary text-white">
                <h6 class="modal-title fw-bold mb-0"><i class="bi bi-gift-fill me-1"></i> Đóng hộp quà tự chọn nhanh cho khách tại quầy (F6)</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <div class="row g-3">
                    <div class="col-md-5 border-end">
                        <label class="form-label small fw-bold mb-1">1. Chọn mẫu vỏ hộp:</label>
                        <select id="selPosVoHopTuChon" class="form-select form-select-sm mb-2" onchange="doiVoHopTuChonPos()">
                            @foreach (var vh in Model.DanhSachVoHop)
                            {
                                <option value="@vh.MaVh" data-succhua="@vh.SucChuaBanh" data-giavo="@Math.Round(vh.GiaVoHopRieng, 0)" data-ten="@vh.TenVoHop">
                                    @vh.TenVoHop (@vh.SucChuaBanh bánh - Vỏ: @vh.GiaVoHopRieng.ToString("N0") đ - Tồn: @vh.SltonKhoVo)
                                </option>
                            }
                        </select>
                        <div class="mb-2">
                            <label class="form-label small fw-bold mb-1">Tên hộp quà (tùy chọn):</label>
                            <input type="text" id="inpPosTenHopTuChon" class="form-control form-control-sm" placeholder="VD: Hộp Quà Biếu Sếp Thượng Hạng" />
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-bold">Các ô bánh trong hộp (<span id="lblPosDemBanhHop">0/4</span>):</span>
                            <button type="button" class="btn btn-link btn-sm p-0 text-danger text-decoration-none" onclick="xoaHetBanhTrongHopPos()">Làm trống</button>
                        </div>
                        <div id="listSlotHopPos" class="d-flex flex-column gap-1 mb-2" style="max-height: 195px; overflow-y: auto;"></div>
                        <div class="p-2 rounded bg-light border d-flex justify-content-between align-items-center">
                            <span class="fw-bold small">Tổng giá 1 hộp:</span>
                            <strong class="text-primary fs-6" id="lblPosTongGiaHopTuChon">0 đ</strong>
                        </div>
                    </div>
                    <div class="col-md-7">
                        <label class="form-label small fw-bold mb-1">2. Chạm chọn bánh để xếp vào ô trống:</label>
                        <div class="row g-2" style="max-height: 320px; overflow-y: auto;">
                            @foreach (var b in Model.DanhSachBanh)
                            {
                                <div class="col-6">
                                    <div class="p-2 border rounded d-flex justify-content-between align-items-center bg-white" style="cursor:pointer;" onclick="themBanhVaoHopTuChonPos(@b.MaBanh)">
                                        <div class="text-truncate pe-1">
                                            <div class="fw-semibold text-dark text-truncate">@b.TenBanh</div>
                                            <small class="text-primary fw-bold">@b.DonGiaThucTe.ToString("N0") đ</small>
                                            <small class="text-muted">• Tồn: @b.TongTonKho</small>
                                        </div>
                                        <span class="btn btn-sm btn-outline-primary py-0 px-2">+</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2 px-3 bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success btn-sm fw-bold px-3" onclick="xacNhanThemHopTuChonVaoPos()"><i class="bi bi-cart-plus me-1"></i> Đưa hộp quà vào hóa đơn POS</button>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
window.POS_CATALOG = {
    dsBanhPos: @Html.Raw(dsBanhPosJson),
    dsComboPos: @Html.Raw(dsComboPosJson),
    dsVoHopPos: @Html.Raw(dsVoHopPosJson),
    bangB2B: @Html.Raw(bangB2BJson),
    dsVoucher: @Html.Raw(dsVoucherJson),
    ngayHenMacDinh: '@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")'
};
</script>
<script src="~/js/admin-pos.js" asp-append-version="true"></script>
</body>
</html>
