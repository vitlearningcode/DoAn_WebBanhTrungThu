@model WebBanhTrungThu.ViewModels.BanHangPosViewModel
@using System.Text.Json
@using System.Text.Encodings.Web
@using WebBanhTrungThu.Services
@{
    Layout = null;
    var jsonOptions = new JsonSerializerOptions
    {
        Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    };

    // Chuẩn bị dữ liệu JSON cho Client-side POS siêu tốc (0ms latency)
    var dsBanhPosJson = JsonSerializer.Serialize(Model.DanhSachBanh.Select(b => new
    {
        loai = 1,
        maBanh = b.MaBanh,
        maSku = b.MaSku,
        maVach = b.MaVach,
        ten = b.TenBanh,
        thuongHieu = b.ThuongHieu,
        donViTinh = string.IsNullOrWhiteSpace(b.DonViTinh) ? "Cái" : b.DonViTinh,
        giaGoc = Math.Round(b.DonGiaLe, 0),
        giaBan = Math.Round(b.DonGiaThucTe, 0),
        phanTramCanDate = Math.Round(b.PhanTramGiamCanDateHieuLuc, 0),
        dangXaCanDate = b.DangXaCanDate,
        tonKho = b.TongTonKho,
        mucDoNgot = b.MucDoNgot,
        laBanhThuongHang = b.LaBanhThuongHang,
        laBanhChay = b.LaBanhChay,
        calo = b.ThongSoDinhDuong?.NangLuongCalo ?? 380,
        anh = DichVuHinhAnh.LayUrl(Model.TuDienAnh, "BANH", b.MaBanh, "ANH_CHINH")
    }), jsonOptions);

    var dsComboPosJson = JsonSerializer.Serialize(Model.DanhSachCombo.Select(c => new
    {
        loai = 2,
        maCb = c.MaCb,
        maSku = c.MaCodeCb,
        maVach = c.MaVach,
        ten = c.TenCombo,
        thuongHieu = c.ThuongHieu,
        donViTinh = "Hộp",
        giaGoc = Math.Round(c.GiaNiemYet, 0),
        giaBan = Math.Round(c.GiaUuDaiCombo, 0),
        tonKho = c.MaVhNavigation != null ? Math.Min(c.TongTonKho, c.MaVhNavigation.SltonKhoVo) : c.TongTonKho,
        tenVoHop = c.MaVhNavigation?.TenVoHop ?? "Hộp tiêu chuẩn",
        chiTietBanh = string.Join(", ", c.ChiTietComboMaus.OrderBy(x => x.ViTriO).Select(x => $"Ô {x.ViTriO}: {x.MaBanhNavigation?.TenBanh}")),
        anh = Model.TuDienAnh.ContainsKey($"COMBO_{c.MaCb}_ANH_CHINH")
            ? Model.TuDienAnh[$"COMBO_{c.MaCb}_ANH_CHINH"]
            : DichVuHinhAnh.LayUrl(Model.TuDienAnh, "VO_HOP", c.MaVh, "ANH_CHINH")
    }), jsonOptions);

    var dsVoHopPosJson = JsonSerializer.Serialize(Model.DanhSachVoHop.Select(v => new
    {
        maVh = v.MaVh,
        maCodeVh = v.MaCodeVh,
        tenVoHop = v.TenVoHop,
        sucChua = v.SucChuaBanh,
        giaVoHop = Math.Round(v.GiaVoHopRieng, 0),
        tonKhoVo = v.SltonKhoVo,
        slVipToiThieu = v.SlbanhThuongHangToiThieu,
        anh = DichVuHinhAnh.LayUrl(Model.TuDienAnh, "VO_HOP", v.MaVh, "ANH_CHINH")
    }), jsonOptions);

    var bangB2BJson = JsonSerializer.Serialize(Model.BangChietKhauSiB2B.Select(b => new
    {
        tenMoc = b.TenMocB2b,
        tuHop = b.SlhopToiThieu,
        denHop = b.SlhopToiDa,
        phanTramCk = Math.Round(b.PhanTramChietKhau, 0),
        mienPhiInLogo = b.MienPhiInLogo,
        phiKhuon = Math.Round(b.PhiKhuonInLogo, 0)
    }), jsonOptions);

    var dsVoucherJson = JsonSerializer.Serialize(Model.DanhSachKhuyenMai.Select(k => new
    {
        codeKm = k.CodeKm,
        ten = k.TenChuongTrinh,
        loaiGiam = k.LoaiGiam,
        giaTriGiam = Math.Round(k.GiaTriGiam, 0),
        giamToiDa = Math.Round(k.GiamToiDa, 0),
        donToiThieu = Math.Round(k.DonToiThieu, 0)
    }), jsonOptions);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KiotViet Web POS - Bán Hàng Tại Quầy Nguyệt Cát</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script>
        // Chặn tuyệt đối vòng lặp onerror của ảnh trên màn hình POS
        window.KV_FALLBACK_SVG = "data:image/svg+xml;utf8," + encodeURIComponent(
            "<svg xmlns='http://www.w3.org/2000/svg' width='120' height='120' viewBox='0 0 120 120'>" +
            "<rect width='120' height='120' rx='10' fill='%23F3F4F6'/>" +
            "<circle cx='60' cy='54' r='26' fill='%23E5E7EB'/>" +
            "<text x='50%' y='98' dominant-baseline='middle' text-anchor='middle' fill='%236B7280' font-family='Inter,sans-serif' font-size='11' font-weight='600'>Nguyệt Cát</text>" +
            "</svg>"
        );
        window.kvImgFallback = function (img) {
            if (!img) return;
            img.onerror = null;
            if (img.dataset.fallbackApplied === "1") return;
            img.dataset.fallbackApplied = "1";
            img.src = window.KV_FALLBACK_SVG;
        };
    </script>

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100vh;
            width: 100vw;
            margin: 0;
            padding: 0;
            overflow: hidden;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            font-size: 13px;
            background-color: #EBEEF2;
            color: #1F2937;
        }

        /* ================================================================= */
        /* 1. TOP BAR POS (#005AC3 - CAO 48PX)                               */
        /* ================================================================= */
        .pos-topbar {
            height: 48px;
            background-color: #005AC3;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 12px;
            gap: 10px;
            user-select: none;
        }

        .pos-search-wrap {
            position: relative;
            width: 340px;
            max-width: 32vw;
        }

        .pos-search-wrap i {
            position: absolute;
            left: 11px;
            top: 8px;
            color: #6B7280;
            font-size: 14px;
        }

        .pos-search-input {
            width: 100%;
            height: 34px;
            border-radius: 5px;
            border: none;
            padding: 0 12px 0 34px;
            font-size: 13px;
            color: #111827;
            background: #FFFFFF;
            box-shadow: 0 1px 2px rgba(0,0,0,0.12);
        }

        .pos-search-input:focus {
            outline: 2px solid #93C5FD;
        }

        /* Multi-tab Hóa đơn */
        .pos-tabs-bar {
            display: flex;
            align-items: flex-end;
            gap: 4px;
            height: 100%;
            padding-top: 8px;
            flex-grow: 1;
            overflow-x: auto;
        }

        .pos-tab-item {
            height: 40px;
            padding: 0 14px;
            border-radius: 6px 6px 0 0;
            background: rgba(255, 255, 255, 0.16);
            color: #E5E7EB;
            font-weight: 600;
            font-size: 13px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            border: none;
            white-space: nowrap;
            transition: background 0.12s;
        }

        .pos-tab-item:hover {
            background: rgba(255, 255, 255, 0.25);
            color: #FFFFFF;
        }

        .pos-tab-item.active {
            background: #EBEEF2;
            color: #005AC3;
            font-weight: 700;
        }

        .pos-tab-close {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            opacity: 0.75;
        }

        .pos-tab-close:hover {
            background: rgba(220, 38, 38, 0.15);
            color: #DC2626;
            opacity: 1;
        }

        .pos-btn-add-tab {
            height: 32px;
            width: 32px;
            border-radius: 5px;
            border: 1px solid rgba(255,255,255,0.35);
            background: rgba(255,255,255,0.12);
            color: #FFFFFF;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 4px;
            cursor: pointer;
        }

        .pos-btn-add-tab:hover {
            background: rgba(255,255,255,0.25);
        }

        .pos-btn-top-action {
            height: 33px;
            padding: 0 12px;
            border-radius: 5px;
            background: #00B63E;
            color: #FFFFFF;
            font-weight: 600;
            font-size: 12.5px;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
            text-decoration: none;
            cursor: pointer;
        }

        .pos-btn-top-action:hover {
            background: #009E35;
            color: #FFFFFF;
        }

        .pos-btn-manage {
            height: 33px;
            padding: 0 12px;
            border-radius: 5px;
            background: rgba(255,255,255,0.16);
            color: #FFFFFF;
            font-weight: 600;
            font-size: 12.5px;
            border: 1px solid rgba(255,255,255,0.3);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            white-space: nowrap;
        }

        .pos-btn-manage:hover {
            background: rgba(255,255,255,0.28);
            color: #FFFFFF;
        }

        /* ================================================================= */
        /* 2. BỐ CỤC CHÍNH 2 KHU VỰC: TRÁI (65%) & PHẢI (35%)               */
        /* ================================================================= */
        .pos-workspace {
            height: calc(100vh - 48px);
            display: flex;
            gap: 8px;
            padding: 8px;
        }

        /* KHU VỰC TRÁI (65%) */
        .pos-left-col {
            width: 65%;
            height: 100%;
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-width: 0;
        }

        /* Khung trên: Bảng món trong hóa đơn (46% chiều cao cột trái) */
        .pos-cart-panel {
            height: 46%;
            background: #FFFFFF;
            border-radius: 6px;
            border: 1px solid #D1D5DB;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .pos-cart-table-wrap {
            flex-grow: 1;
            overflow-y: auto;
        }

        .pos-cart-table {
            width: 100%;
            border-collapse: collapse;
        }

        .pos-cart-table thead th {
            position: sticky;
            top: 0;
            background: #F4F6F8;
            color: #374151;
            font-weight: 700;
            font-size: 12px;
            padding: 8px 10px;
            border-bottom: 1px solid #E5E7EB;
            z-index: 2;
        }

        .pos-cart-table tbody td {
            padding: 8px 10px;
            border-bottom: 1px solid #F0F1F3;
            vertical-align: middle;
            font-size: 13px;
        }

        .pos-cart-table tbody tr:hover {
            background-color: #F8FAFC;
        }

        .pos-qty-box {
            display: inline-flex;
            align-items: center;
            border: 1px solid #D1D5DB;
            border-radius: 5px;
            overflow: hidden;
            background: #fff;
        }

        .pos-qty-btn {
            width: 26px;
            height: 26px;
            border: none;
            background: #F3F4F6;
            color: #1F2937;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .pos-qty-btn:hover {
            background: #E5E7EB;
        }

        .pos-qty-input {
            width: 42px;
            height: 26px;
            border: none;
            text-align: center;
            font-weight: 700;
            font-size: 13px;
            color: #111827;
        }

        /* Khung dưới: Lưới chọn nhanh Hàng hóa & Combo (54% chiều cao cột trái) */
        .pos-catalog-panel {
            height: 54%;
            background: #FFFFFF;
            border-radius: 6px;
            border: 1px solid #D1D5DB;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .pos-pill-bar {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 10px;
            border-bottom: 1px solid #E5E7EB;
            background: #F9FAFB;
            overflow-x: auto;
            flex-shrink: 0;
        }

        .pos-filter-pill {
            padding: 5px 12px;
            border-radius: 999px;
            border: 1px solid #D1D5DB;
            background: #FFFFFF;
            color: #374151;
            font-weight: 600;
            font-size: 12px;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.12s;
        }

        .pos-filter-pill:hover {
            border-color: #0070F4;
            color: #0070F4;
        }

        .pos-filter-pill.active {
            background: #0070F4;
            border-color: #0070F4;
            color: #FFFFFF;
        }

        .pos-product-grid {
            flex-grow: 1;
            overflow-y: auto;
            padding: 10px;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
            gap: 10px;
            align-content: start;
        }

        .pos-prod-card {
            border: 1px solid #E5E7EB;
            border-radius: 6px;
            background: #FFFFFF;
            padding: 8px;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            transition: border-color 0.12s, box-shadow 0.12s, transform 0.08s;
            user-select: none;
        }

        .pos-prod-card:hover {
            border-color: #0070F4;
            box-shadow: 0 3px 8px rgba(0, 112, 244, 0.12);
            transform: translateY(-1px);
        }

        .pos-prod-card.out-of-stock {
            opacity: 0.55;
        }

        .pos-prod-img-wrap {
            height: 76px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #F9FAFB;
            border-radius: 5px;
            margin-bottom: 6px;
            overflow: hidden;
        }

        .pos-prod-img-wrap img {
            max-height: 70px;
            max-width: 100%;
            object-fit: contain;
        }

        .pos-badge-candate {
            position: absolute;
            top: 6px;
            left: 6px;
            background: #DC2626;
            color: #FFFFFF;
            font-size: 10px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
        }

        .pos-badge-stock {
            position: absolute;
            top: 6px;
            right: 6px;
            background: rgba(17, 24, 39, 0.75);
            color: #FFFFFF;
            font-size: 10px;
            font-weight: 600;
            padding: 2px 6px;
            border-radius: 4px;
        }

        .pos-prod-name {
            font-size: 12.5px;
            font-weight: 600;
            color: #111827;
            line-height: 1.3;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 32px;
        }

        .pos-prod-brand {
            font-size: 11px;
            color: #6B7280;
            margin-top: 2px;
        }

        .pos-prod-price {
            font-size: 13.5px;
            font-weight: 700;
            color: #0070F4;
            margin-top: 4px;
        }

        /* ================================================================= */
        /* 3. KHU VỰC PHẢI (35% - KHUNG THANH TOÁN HÓA ĐƠN)                  */
        /* ================================================================= */
        .pos-right-col {
            width: 35%;
            height: 100%;
            background: #FFFFFF;
            border-radius: 6px;
            border: 1px solid #D1D5DB;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .pos-right-scroll {
            flex-grow: 1;
            overflow-y: auto;
            padding: 12px;
        }

        .pos-mode-switch {
            display: flex;
            background: #F3F4F6;
            padding: 3px;
            border-radius: 6px;
            margin-bottom: 10px;
        }

        .pos-mode-btn {
            flex: 1;
            border: none;
            background: transparent;
            padding: 6px 8px;
            border-radius: 5px;
            font-size: 12px;
            font-weight: 600;
            color: #4B5563;
            cursor: pointer;
        }

        .pos-mode-btn.active {
            background: #FFFFFF;
            color: #0070F4;
            box-shadow: 0 1px 2px rgba(0,0,0,0.08);
        }

        .pos-summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 0;
            border-bottom: 1px dashed #E5E7EB;
            font-size: 13px;
        }

        .pos-total-payable-box {
            background: #EBF5FF;
            border: 1px solid #BFDBFE;
            border-radius: 6px;
            padding: 10px 12px;
            margin: 10px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .pos-denom-btn {
            border: 1px solid #D1D5DB;
            background: #F9FAFB;
            color: #1F2937;
            border-radius: 4px;
            padding: 4px 8px;
            font-size: 11.5px;
            font-weight: 600;
            cursor: pointer;
        }

        .pos-denom-btn:hover {
            border-color: #0070F4;
            color: #0070F4;
            background: #EBF5FF;
        }

        .pos-checkout-footer {
            padding: 10px 12px;
            border-top: 1px solid #E5E7EB;
            background: #F9FAFB;
        }

        .pos-btn-pay-f9 {
            width: 100%;
            height: 52px;
            background-color: #00B63E;
            color: #FFFFFF;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 700;
            letter-spacing: 0.3px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(0, 182, 62, 0.28);
        }

        .pos-btn-pay-f9:hover {
            background-color: #009E35;
        }

        .pos-btn-pay-f9:disabled {
            background-color: #9CA3AF;
            cursor: not-allowed;
            box-shadow: none;
        }

        /* Dropdown gợi ý khách hàng */
        .pos-cust-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #FFFFFF;
            border: 1px solid #D1D5DB;
            border-radius: 6px;
            box-shadow: 0 6px 16px rgba(0,0,0,0.12);
            z-index: 50;
            max-height: 210px;
            overflow-y: auto;
            display: none;
        }

        .pos-cust-option {
            padding: 7px 10px;
            border-bottom: 1px solid #F3F4F6;
            cursor: pointer;
            font-size: 12.5px;
        }

        .pos-cust-option:hover {
            background: #EBF5FF;
        }
    </style>
</head>
<body>
    <!-- ========================================================================= -->
    <!-- 1. TOP BAR KIOTVIET WEB POS (#005AC3, CAO 48PX)                           -->
    <!-- ========================================================================= -->
    <header class="pos-topbar">
        <!-- Ô tìm kiếm hàng hóa / quét mã vạch (F3) -->
        <div class="pos-search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" id="txtPosTimSanPham" class="pos-search-input"
                   placeholder="(F3) Tìm tên bánh, mã SKU, quét mã vạch..."
                   oninput="locSanPhamPos()"
                   onkeydown="if(event.key === 'Enter'){ event.preventDefault(); quetMaVachNhanhPos(this.value); }" />
        </div>

        <!-- Hệ thống Multi-Tab Hóa đơn -->
        <div class="pos-tabs-bar" id="barMultiTabsHoaDon">
            <!-- Render động bằng JS -->
        </div>

        <!-- Nút Đóng hộp tự chọn cho khách (F6) -->
        <button type="button" class="pos-btn-top-action" onclick="moModalDongHopTuChonPos()">
            <i class="bi bi-gift-fill"></i> Đóng hộp tự chọn cho khách (F6)
        </button>

        <!-- Thông tin Thu ngân & Nút Về trang Quản lý -->
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-primary fw-semibold px-2 py-1">
                <i class="bi bi-person-badge me-1"></i>@Model.TenThuNgan (@Model.VaiTroThuNgan)
            </span>
            <a href="/Admin/Dashboard/Index" class="pos-btn-manage" title="Quay về giao diện Quản lý KiotViet">
                <i class="bi bi-bar-chart-line-fill"></i> Về trang Quản lý
            </a>
        </div>
    </header>

    <!-- ========================================================================= -->
    <!-- 2. KHÔNG GIAN LÀM VIỆC POS (TRÁI 65% - PHẢI 35%)                          -->
    <!-- ========================================================================= -->
    <div class="pos-workspace">
        <!-- ===================================================================== -->
        <!-- KHU VỰC TRÁI (65%): BẢNG MÓN TRONG HÓA ĐƠN + LƯỚI CHỌN NHANH          -->
        <!-- ===================================================================== -->
        <div class="pos-left-col">
            <!-- PHẦN TRÊN: DANH SÁCH MÓN TRONG HÓA ĐƠN ĐANG CHỌN -->
            <div class="pos-cart-panel">
                <div class="pos-cart-table-wrap">
                    <table class="pos-cart-table">
                        <thead>
                            <tr>
                                <th style="width: 42px;" class="text-center">STT</th>
                                <th style="width: 105px;">Mã hàng</th>
                                <th>Tên hàng hóa (kèm chi tiết nhân bánh nếu là hộp)</th>
                                <th style="width: 65px;" class="text-center">ĐVT</th>
                                <th style="width: 118px;" class="text-center">Số lượng</th>
                                <th style="width: 105px;" class="text-end">Đơn giá</th>
                                <th style="width: 115px;" class="text-end">Thành tiền</th>
                                <th style="width: 42px;" class="text-center"></th>
                            </tr>
                        </thead>
                        <tbody id="tbodyPosCart">
                            <!-- Render động bằng JS -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- PHẦN DƯỚI: LƯỚI CHỌN NHANH HÀNG HÓA & COMBO -->
            <div class="pos-catalog-panel">
                <!-- Thanh lọc pill ngang -->
                <div class="pos-pill-bar" id="barLocPillPos">
                    <button type="button" class="pos-filter-pill active" onclick="chonPillLocPos(this, 'ALL')">Tất cả</button>
                    <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'TH_Kinh Đô')">Kinh Đô</button>
                    <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'TH_Đồng Khánh')">Đồng Khánh</button>
                    <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'TH_Như Lan')">Như Lan</button>
                    <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'TH_Brodard')">Brodard</button>
                    <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'ISOMALT')">🌿 Đường Isomalt</button>
                    <button type="button" class="pos-filter-pill" onclick="chonPillLocPos(this, 'COMBO')">🎁 Hộp Combo</button>
                </div>

                <!-- Lưới thẻ sản phẩm (Product Cards) -->
                <div class="pos-product-grid" id="gridPosProducts">
                    <!-- Render động bằng JS -->
                </div>
            </div>
        </div>

        <!-- ===================================================================== -->
        <!-- KHU VỰC PHẢI (35%): KHUNG KHÁCH HÀNG & THANH TOÁN HÓA ĐƠN             -->
        <!-- ===================================================================== -->
        <div class="pos-right-col">
            <div class="pos-right-scroll">
                <!-- 1. KHỐI KHÁCH HÀNG (F4) + NÚT THÊM KHÁCH MỚI -->
                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-bold text-dark" style="font-size: 12.5px;">
                            <i class="bi bi-person-vcard text-primary me-1"></i> Khách hàng (F4)
                        </span>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold"
                                style="font-size: 12px; color: #0070F4;"
                                onclick="moModalThemKhachPos()">
                            + Thêm khách mới
                        </button>
                    </div>

                    <div class="position-relative" id="boxTimKhachPos">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="txtPosTimKhach" class="form-control"
                                   placeholder="Tìm SĐT hoặc tên khách thành viên (F4)..."
                                   autocomplete="off"
                                   onfocus="timKhachHangPosAjax(this.value)"
                                   oninput="timKhachHangPosAjax(this.value)" />
                        </div>
                        <div class="pos-cust-dropdown" id="dropdownKhachPos"></div>
                    </div>

                    <!-- Thẻ hiển thị khi đã chọn khách thành viên -->
                    <div id="boxThongTinKhachDaChon" class="mt-2 p-2 rounded border" style="background: #F0F7FF; border-color: #BFDBFE !important; display: none;">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold text-primary" id="lblPosTenKhach">---</div>
                                <div class="small text-muted">
                                    SĐT: <strong id="lblPosSdtKhach">---</strong> •
                                    Hạng: <span class="badge bg-warning text-dark" id="lblPosHangTv">Đồng</span> •
                                    Điểm: <strong class="text-success" id="lblPosDiemKhach">0</strong>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="boChonKhachHangPos()" title="Đổi về Khách lẻ tại quầy">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 2. CHUYỂN ĐỔI CHẾ ĐỘ: LẤY NGAY TẠI QUẦY VS ĐẶT GIAO HÀNG & THIỆP QR 3D -->
                <div class="pos-mode-switch">
                    <button type="button" class="pos-mode-btn active" id="btnModeTaiQuay" onclick="chuyenCheDoMuaPos('TAI_QUAY')">
                        🛍️ Khách lấy ngay tại quầy
                    </button>
                    <button type="button" class="pos-mode-btn" id="btnModeGiaoHangQr" onclick="chuyenCheDoMuaPos('GIAO_HANG_QR')">
                        🚚 Đặt giao hàng &amp; Thiệp QR 3D
                    </button>
                </div>

                <!-- Khung nhập thông tin Giao hàng & Thiệp QR 3D (ẩn khi lấy ngay tại quầy) -->
                <div id="boxGiaoHangQrPos" class="p-2 mb-2 rounded border bg-light" style="display: none; font-size: 12px;">
                    <div class="fw-bold text-primary mb-2">
                        <i class="bi bi-truck me-1"></i> Thông tin người nhận &amp; Thiệp Chúc Mừng QR 3D
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <input type="text" id="txtPosTenNguoiNhan" class="form-control form-control-sm" placeholder="Họ tên người nhận *" oninput="luuThongTinTabHienTai()" />
                        </div>
                        <div class="col-6">
                            <input type="text" id="txtPosSdtNguoiNhan" class="form-control form-control-sm" placeholder="SĐT người nhận *" oninput="luuThongTinTabHienTai()" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <input type="text" id="txtPosDiaChiGiao" class="form-control form-control-sm" placeholder="Địa chỉ giao chi tiết *" oninput="luuThongTinTabHienTai()" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <input type="date" id="txtPosNgayHenGiao" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" class="form-control form-control-sm" onchange="luuThongTinTabHienTai()" />
                        </div>
                        <div class="col-6">
                            <select id="selPosKhungGioGiao" class="form-select form-select-sm" onchange="luuThongTinTabHienTai()">
                                <option value="Sáng (08:00 - 11:30)">Sáng (08:00 - 11:30)</option>
                                <option value="Chiều (13:30 - 17:30)">Chiều (13:30 - 17:30)</option>
                                <option value="Tối (18:00 - 20:30)">Tối (18:00 - 20:30)</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-check mb-1">
                        <input type="checkbox" id="chkPosKemThiepQr" class="form-check-input" checked onchange="luuThongTinTabHienTai()" />
                        <label class="form-check-label fw-semibold" for="chkPosKemThiepQr">
                            ✨ Kèm Thiệp Chúc Mừng 3D QR Code
                        </label>
                    </div>
                    <textarea id="txtPosLoiChucThiep" rows="2" class="form-control form-control-sm"
                              placeholder="Lời chúc hiển thị khi người nhận quét mã QR 3D..."
                              oninput="luuThongTinTabHienTai()">Kính chúc Quý khách & Gia đình mùa Trăng Rằm Đoàn Viên, Viên Mãn & An Khang!</textarea>
                </div>

                <!-- 3. BẢNG TÍNH TIỀN TỰ ĐỘNG -->
                <div class="mt-1">
                    <div class="pos-summary-row">
                        <span>
                            Tổng tiền hàng
                            <span class="badge bg-secondary ms-1" id="lblPosTongSoMon">0 món</span>
                            <span class="badge bg-info text-dark ms-1" id="lblPosTongSoHop">0 hộp</span>
                        </span>
                        <strong class="text-dark" id="lblPosTongTienHang">0</strong>
                    </div>

                    <!-- Chiết khấu sỉ B2B tự động khi >= 10 hộp -->
                    <div class="pos-summary-row">
                        <div>
                            <span>Chiết khấu sỉ B2B</span>
                            <small class="text-success d-block" id="lblPosTenMocB2B">Tự động áp dụng từ 10 hộp</small>
                        </div>
                        <strong class="text-success" id="lblPosTienCkB2B">-0</strong>
                    </div>

                    <div class="py-1 border-bottom">
                        <label class="d-flex align-items-center justify-content-between" style="cursor:pointer; font-size: 12px;">
                            <span>
                                <input type="checkbox" id="chkPosYeuCauInLogo" class="form-check-input me-1" onchange="tinhToanHoaDonPos()" />
                                In Logo Doanh Nghiệp B2B
                            </span>
                            <span class="fw-semibold text-dark" id="lblPosPhiInLogo">0</span>
                        </label>
                    </div>

                    <!-- Mã giảm giá Voucher -->
                    <div class="pos-summary-row">
                        <div class="d-flex align-items-center gap-1">
                            <span>Voucher</span>
                            <select id="selPosVoucher" class="form-select form-select-sm py-0 px-2" style="width: 150px; height: 26px; font-size: 11.5px;" onchange="tinhToanHoaDonPos()">
                                <option value="">-- Chọn mã KM --</option>
                                @foreach (var km in Model.DanhSachKhuyenMai)
                                {
                                    <option value="@km.CodeKm">@km.CodeKm (Đơn &ge; @(km.DonToiThieu.ToString("N0")))</option>
                                }
                            </select>
                        </div>
                        <strong class="text-success" id="lblPosTienVoucher">-0</strong>
                    </div>

                    <!-- Phí giao hàng (nếu chọn Giao hàng) -->
                    <div class="pos-summary-row" id="rowPosPhiShip" style="display: none;">
                        <span>Phí giao hàng tận nơi</span>
                        <strong class="text-dark" id="lblPosPhiShip">30,000</strong>
                    </div>

                    <!-- KHÁCH CẦN TRẢ -->
                    <div class="pos-total-payable-box">
                        <span class="fw-bold text-dark" style="font-size: 14px;">KHÁCH CẦN TRẢ</span>
                        <span class="fw-bold" style="font-size: 20px; color: #0070F4;" id="lblPosKhachCanTra">0</span>
                    </div>
                </div>

                <!-- 4. PHƯƠNG THỨC THANH TOÁN -->
                <div class="mt-2">
                    <div class="fw-bold text-dark mb-2" style="font-size: 12.5px;">Phương thức thanh toán</div>
                    <div class="d-flex gap-3 mb-2">
                        <label class="d-flex align-items-center gap-1 fw-semibold" style="cursor:pointer;">
                            <input type="radio" name="radPosPhuongThucTt" value="TIEN_MAT" checked onchange="doiPhuongThucTtPos(this.value)" />
                            <span>💵 Tiền mặt</span>
                        </label>
                        <label class="d-flex align-items-center gap-1 fw-semibold" style="cursor:pointer;">
                            <input type="radio" name="radPosPhuongThucTt" value="CHUYEN_KHOAN_QR" onchange="doiPhuongThucTtPos(this.value)" />
                            <span>📱 Chuyển khoản VietQR</span>
                        </label>
                        <label class="d-flex align-items-center gap-1 fw-semibold" style="cursor:pointer;">
                            <input type="radio" name="radPosPhuongThucTt" value="VI_DIEN_TU" onchange="doiPhuongThucTtPos(this.value)" />
                            <span>💳 Thẻ/Ví</span>
                        </label>
                    </div>

                    <!-- Khối Tiền mặt: Tiền khách đưa + Mệnh giá gợi ý + Tiền thừa -->
                    <div id="boxPosTienMat" class="p-2 rounded border bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold">Tiền khách đưa:</span>
                            <input type="number" id="inpPosTienKhachDua" class="form-control form-control-sm text-end fw-bold"
                                   style="width: 150px; font-size: 14px;"
                                   oninput="tinhTienThuaPos()" />
                        </div>
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            <button type="button" class="pos-denom-btn" onclick="chonMenhGiaPos(0)">Chính xác</button>
                            <button type="button" class="pos-denom-btn" onclick="chonMenhGiaPos(200000)">200,000</button>
                            <button type="button" class="pos-denom-btn" onclick="chonMenhGiaPos(500000)">500,000</button>
                            <button type="button" class="pos-denom-btn" onclick="chonMenhGiaPos(1000000)">1,000,000</button>
                            <button type="button" class="pos-denom-btn" onclick="chonMenhGiaPos(2000000)">2,000,000</button>
                        </div>
                        <div class="d-flex justify-content-between align-items-center pt-1 border-top">
                            <span class="fw-semibold">Tiền thừa trả khách:</span>
                            <strong class="text-danger" style="font-size: 15px;" id="lblPosTienThua">0 đ</strong>
                        </div>
                    </div>

                    <!-- Khối Chuyển khoản VietQR: Tự động hiển thị mã VietQR -->
                    <div id="boxPosVietQr" class="p-2 rounded border bg-light text-center" style="display: none;">
                        <div class="small fw-semibold text-primary mb-1">
                            Quét mã VietQR Ngân hàng Quân Đội (MB Bank - 0814585526)
                        </div>
                        <img id="imgPosVietQrLive"
                             src=""
                             alt="Mã VietQR POS"
                             style="max-width: 175px; border-radius: 6px; border: 1px solid #D1D5DB; background: #fff; padding: 4px;"
                             onerror="window.kvImgFallback(this)" />
                    </div>
                </div>
            </div>

            <!-- 5. NÚT CHỐT ĐƠN LỚN DƯỚI CÙNG (F9) -->
            <div class="pos-checkout-footer">
                <button type="button" class="pos-btn-pay-f9" id="btnPosThanhToanF9" onclick="thucHienThanhToanPos()">
                    <i class="bi bi-printer-fill"></i> THANH TOÁN (F9)
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODAL 1: 🎁 ĐÓNG HỘP TỰ CHỌN NHANH TẠI QUẦY (F6)                          -->
    <!-- ========================================================================= -->
    <div class="modal fade" id="modalDongHopPos" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header py-2 px-3" style="background: #005AC3; color: #fff;">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="bi bi-gift-fill me-1"></i> Đóng hộp quà tự chọn nhanh cho khách tại quầy (F6)
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-3">
                        <div class="col-md-5 border-end">
                            <label class="form-label small fw-bold mb-1">1. Chọn mẫu vỏ hộp:</label>
                            <select id="selPosVoHopTuChon" class="form-select form-select-sm mb-2" onchange="doiVoHopTuChonPos()">
                                @foreach (var vh in Model.DanhSachVoHop)
                                {
                                    <option value="@vh.MaVh" data-succhua="@vh.SucChuaBanh" data-giavo="@Math.Round(vh.GiaVoHopRieng, 0)" data-ten="@vh.TenVoHop">
                                        @vh.TenVoHop (@vh.SucChuaBanh bánh - Vỏ: @vh.GiaVoHopRieng.ToString("N0") đ - Tồn: @vh.SltonKhoVo)
                                    </option>
                                }
                            </select>

                            <div class="mb-2">
                                <label class="form-label small fw-bold mb-1">Tên hộp quà (tùy chọn):</label>
                                <input type="text" id="inpPosTenHopTuChon" class="form-control form-control-sm" placeholder="VD: Hộp Quà Biếu Sếp Thượng Hạng" />
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-bold">Các ô bánh trong hộp (<span id="lblPosDemBanhHop">0/4</span>):</span>
                                <button type="button" class="btn btn-link btn-sm p-0 text-danger text-decoration-none" onclick="xoaHetBanhTrongHopPos()">Làm trống</button>
                            </div>
                            <div id="listSlotHopPos" class="d-flex flex-column gap-1 mb-2" style="max-height: 195px; overflow-y: auto;">
                                <!-- Render động -->
                            </div>

                            <div class="p-2 rounded bg-light border d-flex justify-content-between align-items-center">
                                <span class="fw-bold small">Tổng giá 1 hộp:</span>
                                <strong class="text-primary fs-6" id="lblPosTongGiaHopTuChon">0 đ</strong>
                            </div>
                        </div>

                        <div class="col-md-7">
                            <label class="form-label small fw-bold mb-1">2. Chạm chọn bánh để xếp vào ô trống:</label>
                            <div class="row g-2" style="max-height: 320px; overflow-y: auto;">
                                @foreach (var b in Model.DanhSachBanh)
                                {
                                    <div class="col-6">
                                        <div class="p-2 border rounded d-flex justify-content-between align-items-center bg-white"
                                             style="cursor:pointer;"
                                             onclick="themBanhVaoHopTuChonPos(@b.MaBanh)">
                                            <div class="text-truncate pe-1">
                                                <div class="fw-semibold text-dark text-truncate" style="font-size: 12px;">@b.TenBanh</div>
                                                <small class="text-primary fw-bold">@b.DonGiaThucTe.ToString("N0") đ</small>
                                                <small class="text-muted">• Tồn: @b.TongTonKho</small>
                                            </div>
                                            <span class="btn btn-sm btn-outline-primary py-0 px-2">+</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 px-3 bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-success btn-sm fw-bold px-3" onclick="xacNhanThemHopTuChonVaoPos()">
                        <i class="bi bi-cart-plus me-1"></i> Đưa hộp quà vào hóa đơn POS
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- MODAL 2: + THÊM KHÁCH HÀNG THÀNH VIÊN NHANH TẠI QUẦY (+50 ĐIỂM MỞ THẺ)     -->
    <!-- ========================================================================= -->
    <div class="modal fade" id="modalThemKhachPos" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header py-2 px-3 bg-light">
                    <h6 class="modal-title fw-bold mb-0">
                        <i class="bi bi-person-plus-fill text-primary me-1"></i> Mở thẻ thành viên tại quầy
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">Họ tên khách hàng <span class="text-danger">*</span></label>
                        <input type="text" id="inpPosNewCustName" class="form-control form-control-sm" placeholder="VD: Nguyễn Minh Anh" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-bold mb-1">Số điện thoại <span class="text-danger">*</span></label>
