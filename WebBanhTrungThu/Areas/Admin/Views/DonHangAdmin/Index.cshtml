@model List<WebBanhTrungThu.Models.Entities.DonHang>
@{
    ViewData["Title"] = "Hóa đơn & Đặt hàng - Nguyệt Cát ERP";
}

<div class="kv-layout-2col">
    <!-- 1. CỘT TRÁI (250PX): BỘ LỌC GIAO DỊCH / HÓA ĐƠN CHUẨN NGUYETCAT_ERP -->
    @await Html.PartialAsync("~/Areas/Admin/Views/DonHangAdmin/PhanKhu/_BoLocHoaDonSidebar.cshtml")

    <!-- 2. CỘT PHẢI: THANH CÔNG CỤ & BẢNG HÓA ĐƠN MASTER-DETAIL 2 TAB -->
    @await Html.PartialAsync("~/Areas/Admin/Views/DonHangAdmin/PhanKhu/_BangDanhSachDonHang.cshtml", Model)
</div>

<!-- 3. CÁC MODAL ĐIỀU PHỐI TRẠNG THÁI & HOÀN TIỀN VIETQR -->
@await Html.PartialAsync("~/Areas/Admin/Views/DonHangAdmin/PhanKhu/_ModalDieuPhoiVaHoanTien.cshtml")

@section Scripts {
    <script src="~/js/admin-don-hang.js" asp-append-version="true"></script>
}
