@model List<WebBanhTrungThu.Models.Entities.DonHang>
@{
    ViewData["Title"] = "Hóa đơn & Đặt hàng - KiotViet";
    string tuKhoa = ViewBag.TuKhoa as string ?? "";
    string locTrangThai = ViewBag.LocTrangThai as string ?? "ALL";
    string locLoaiDon = ViewBag.LocLoaiDon as string ?? "ALL";
}

<div class="kv-layout-2col">
    <!-- CỘT TRÁI (250PX): BỘ LỌC HÓA ĐƠN CHUẨN KIOTVIET -->
    <aside class="kv-sidebar-filter">
        <h1 style="font-size: 20px; font-weight: 700; color: #111827; margin: 0 0 14px 0;">Hóa đơn</h1>

        <form method="get" action="/Admin/DonHangAdmin/Index">
            <!-- 1. Trạng thái xử lý -->
            <div class="kv-filter-box">
                <div class="kv-filter-title">
                    <span>Trạng thái</span>
                    <i class="bi bi-chevron-up text-muted" style="font-size: 11px;"></i>
                </div>
                <div class="d-flex flex-column gap-1">
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="locTrangThai" value="ALL" @(locTrangThai == "ALL" ? "checked" : "") onchange="this.form.submit()">
                        <span>Tất cả</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="locTrangThai" value="CHO_XAC_NHAN" @(locTrangThai == "CHO_XAC_NHAN" ? "checked" : "") onchange="this.form.submit()">
                        <span>Chờ xác nhận</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="locTrangThai" value="DANG_DONG_GOI_HOP" @(locTrangThai == "DANG_DONG_GOI_HOP" ? "checked" : "") onchange="this.form.submit()">
                        <span>Đang đóng gói hộp</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="locTrangThai" value="DANG_GIAO" @(locTrangThai == "DANG_GIAO" ? "checked" : "") onchange="this.form.submit()">
                        <span>Đang giao hàng</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="locTrangThai" value="HOAN_TAT" @(locTrangThai == "HOAN_TAT" ? "checked" : "") onchange="this.form.submit()">
                        <span>Hoàn thành</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="locTrangThai" value="DA_HUY" @(locTrangThai == "DA_HUY" ? "checked" : "") onchange="this.form.submit()">
                        <span>Đã hủy</span>
                    </label>
                </div>
            </div>

            <!-- 2. Phân loại kênh & khách -->
            <div class="kv-filter-box">
                <div class="kv-filter-title">
                    <span>Kênh bán & Khách hàng</span>
                    <i class="bi bi-chevron-up text-muted" style="font-size: 11px;"></i>
                </div>
                <div class="d-flex flex-column gap-1">
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="locLoaiDon" value="ALL" @(locLoaiDon == "ALL" ? "checked" : "") onchange="this.form.submit()">
                        <span>Tất cả</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="locLoaiDon" value="B2C" @(locLoaiDon == "B2C" ? "checked" : "") onchange="this.form.submit()">
                        <span>Khách lẻ B2C</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="locLoaiDon" value="B2B" @(locLoaiDon == "B2B" ? "checked" : "") onchange="this.form.submit()">
                        <span>Doanh nghiệp B2B</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="locLoaiDon" value="GUEST" @(locLoaiDon == "GUEST" ? "checked" : "") onchange="this.form.submit()">
                        <span>Khách vãng lai (Guest)</span>
                    </label>
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="radio" name="locLoaiDon" value="MEMBER" @(locLoaiDon == "MEMBER" ? "checked" : "") onchange="this.form.submit()">
                        <span>Thành viên (Member)</span>
                    </label>
                </div>
            </div>
        </form>
    </aside>

    <!-- CỘT PHẢI: THANH CÔNG CỤ & BẢNG HÓA ĐƠN -->
    <div class="kv-main-table-area">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <form method="get" action="/Admin/DonHangAdmin/Index" class="d-flex gap-2" style="width: 340px; max-width: 100%;">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="tuKhoa" value="@tuKhoa" class="form-control" placeholder="Theo mã hóa đơn, SĐT, tên khách..." />
                </div>
            </form>

            <div class="d-flex align-items-center gap-2">
                <a href="/" target="_blank" class="btn-kv-blue text-decoration-none">
                    <i class="bi bi-plus-lg"></i> Tạo hóa đơn mới
                </a>
                <button type="button" class="btn-kv-outline" onclick="window.print();">
                    <i class="bi bi-download"></i> Xuất file
                </button>
            </div>
        </div>

        <div class="kv-card overflow-hidden">
            <div class="table-responsive">
                <table class="kv-table">
                    <thead>
                        <tr>
                            <th>Mã hóa đơn</th>
                            <th>Thời gian</th>
                            <th>Khách hàng</th>
                            <th>Phân loại</th>
                            <th class="text-end">Tổng tiền hàng</th>
                            <th class="text-end">Giảm giá</th>
                            <th class="text-end">Khách cần trả</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var dh = Model[i];
                            decimal tongGiam = dh.TienChietKhauB2b + dh.TienGiamVoucher;
                            bool moMacDinh = (i == 0);

                            <tr class="kv-master-row @(moMacDinh ? "active-row" : "")" onclick="toggleKvDetailRow('detail-dh-@dh.MaDh', this)">
                                <td class="fw-medium text-primary">@dh.MaTraCuuDh</td>
                                <td>@dh.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="fw-medium text-dark">@dh.HoTenNguoiMua</div>
                                    <small class="text-muted">@dh.SdtnguoiMua • @(dh.MaNd.HasValue ? $"Member #{dh.MaNd}" : "Guest KVL")</small>
                                </td>
                                <td>@(dh.LaDonDoanhNghiepB2b ? "Doanh nghiệp B2B" : "Bán lẻ B2C")</td>
                                <td class="text-end">@dh.TongTienHang.ToString("N0")</td>
                                <td class="text-end text-muted">@(tongGiam > 0 ? tongGiam.ToString("N0") : "0")</td>
                                <td class="text-end fw-semibold text-primary">@dh.TongThanhToanCuoi.ToString("N0")</td>
                                <td>
                                    <span class="fw-medium @(dh.TrangThaiDh == "HOAN_TAT" ? "text-success" : dh.TrangThaiDh == "DA_HUY" ? "text-danger" : "text-primary")">
                                        @dh.TrangThaiDh
                                    </span>
                                </td>
                            </tr>

                            <!-- DÒNG CHI TIẾT XỔ RỘNG KIOTVIET -->
                            <tr id="detail-dh-@dh.MaDh" class="kv-detail-row @(moMacDinh ? "open" : "")">
                                <td colspan="8" class="p-0">
                                    <div class="kv-detail-box">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom pb-2 mb-3">
                                            <div>
                                                <strong class="text-primary">Chi tiết hóa đơn #@dh.MaTraCuuDh</strong>
                                                <span class="text-muted ms-2">• Thanh toán: <strong>@dh.PhuongThucTt (@dh.TrangThaiTt)</strong></span>
                                                @if (dh.LaDonDoanhNghiepB2b)
                                                {
                                                    <span class="text-muted ms-2">• Công ty: <strong>@dh.TenCongTy (MST: @dh.MaSoThue)</strong></span>
                                                }
                                            </div>
                                            <a href="/Admin/DonHangAdmin/ChiTiet/@dh.MaDh" class="text-decoration-none small" style="color: #0070F4;">
                                                Mở trang chi tiết →
                                            </a>
                                        </div>

                                        <!-- BẢNG HÀNG HÓA TRONG HÓA ĐƠN -->
                                        <div class="table-responsive mb-3">
                                            <table class="table table-sm table-bordered align-middle mb-0" style="font-size: 13px;">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Tên hàng hóa / Cấu hình hộp tự chọn</th>
                                                        <th class="text-center" style="width: 90px;">Số lượng</th>
                                                        <th class="text-end" style="width: 120px;">Đơn giá</th>
                                                        <th class="text-end" style="width: 130px;">Thành tiền</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var ct in dh.ChiTietDonHangs)
                                                    {
                                                        <tr>
                                                            <td>
                                                                <strong class="text-dark d-block">@ct.TenSanPhamLuuCung</strong>
                                                                @if (!string.IsNullOrWhiteSpace(ct.CauHinhHopJson))
                                                                {
                                                                    try
                                                                    {
                                                                        var mangO = Newtonsoft.Json.Linq.JArray.Parse(ct.CauHinhHopJson);
                                                                        <div class="d-flex flex-wrap gap-1 mt-1">
                                                                            @foreach (var o in mangO)
                                                                            {
                                                                                int viTri = o.Value<int?>("ViTriOTrongHop") ?? 1;
                                                                                string tenBanh = o.Value<string>("TenBanh") ?? "Bánh Trung Thu";
                                                                                decimal donGia = o.Value<decimal?>("DonGia") ?? 0m;
                                                                                <span class="badge bg-light text-dark border fw-normal px-2 py-1">
                                                                                    Ô @viTri: @tenBanh (@donGia.ToString("N0"))
                                                                                </span>
                                                                            }
                                                                        </div>
                                                                    }
                                                                    catch
                                                                    {
                                                                        <small class="text-muted">Hộp quà tự chọn</small>
                                                                    }
                                                                }
                                                            </td>
                                                            <td class="text-center">@ct.SoLuong</td>
                                                            <td class="text-end">@ct.DonGiaLucMua.ToString("N0")</td>
                                                            <td class="text-end fw-semibold">@ct.ThanhTien.ToString("N0")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <!-- ĐỢT GIAO HÀNG ĐA ĐIỂM & THIỆP QR -->
                                        <div class="row g-2 mb-3">
                                            @foreach (var dot in dh.DotGiaoHangDaDiems)
                                            {
                                                <div class="col-md-6">
                                                    <div class="p-2 rounded border bg-light d-flex justify-content-between align-items-center" style="font-size: 12.5px;">
                                                        <div>
                                                            <strong class="text-dark">Người nhận: @dot.TenNguoiNhan (@dot.SdtnguoiNhan)</strong>
                                                            <div class="text-muted">@dot.DiaChiGiaoChiTiet</div>
                                                            <div class="text-muted">Ngày giao: @dot.NgayHenGiao.ToString("dd/MM/yyyy") (@dot.KhungGioGiao)</div>
                                                        </div>
                                                        @if (dot.CoKemThiepQr && !string.IsNullOrEmpty(dot.MaTokenThiepQr))
                                                        {
                                                            <a href="/Thiep3D/Xem/@dot.MaTokenThiepQr" target="_blank" class="btn-kv-outline text-decoration-none py-1 px-2">
                                                                Xem Thiệp 3D (@dot.SoLanMoThiep)
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <!-- NÚT TÁC VỤ -->
                                        <div class="d-flex flex-wrap justify-content-between align-items-center pt-2 border-top gap-2">
                                            <div class="d-flex flex-wrap gap-2">
                                                <form asp-area="Admin" asp-controller="DonHangAdmin" asp-action="CapNhatTrangThai" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maDh" value="@dh.MaDh" />
                                                    <input type="hidden" name="trangThaiDh" value="DANG_DONG_GOI_HOP" />
                                                    <button type="submit" class="btn-kv-outline">Đóng gói hộp</button>
                                                </form>

                                                <form asp-area="Admin" asp-controller="DonHangAdmin" asp-action="CapNhatTrangThai" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maDh" value="@dh.MaDh" />
                                                    <input type="hidden" name="trangThaiDh" value="DANG_GIAO" />
                                                    <button type="submit" class="btn-kv-outline">Giao hàng</button>
                                                </form>

                                                <form asp-area="Admin" asp-controller="DonHangAdmin" asp-action="CapNhatTrangThai" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maDh" value="@dh.MaDh" />
                                                    <input type="hidden" name="trangThaiDh" value="HOAN_TAT" />
                                                    <input type="hidden" name="trangThaiTt" value="DA_TT" />
                                                    <button type="submit" class="btn-kv-green">Hoàn thành</button>
                                                </form>

                                                <form asp-area="Admin" asp-controller="DonHangAdmin" asp-action="CapNhatTrangThai" method="post" class="d-inline"
                                                      onsubmit="return confirm('Xác nhận hủy đơn hàng #@dh.MaTraCuuDh?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maDh" value="@dh.MaDh" />
                                                    <input type="hidden" name="trangThaiDh" value="DA_HUY" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">Hủy bỏ</button>
                                                </form>
                                            </div>

                                            <a href="/Admin/DonHangAdmin/InHoaDon/@dh.MaDh" target="_blank" class="btn-kv-blue text-decoration-none">
                                                <i class="bi bi-printer me-1"></i> In hóa đơn
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
