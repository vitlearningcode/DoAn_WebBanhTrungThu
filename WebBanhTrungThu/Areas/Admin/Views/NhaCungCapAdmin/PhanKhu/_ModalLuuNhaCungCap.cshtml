@model WebBanhTrungThu.ViewModels.NhaCungCapAdminViewModel

<div class="modal fade" id="modalLuuNhaCungCap" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content kv-modal-content">
            <form asp-area="Admin" asp-controller="NhaCungCapAdmin" asp-action="LuuNhaCungCap" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaNcc" id="ncc_MaNcc" value="0" />

                <div class="kv-modal-header pb-2 border-bottom">
                    <div>
                        <h5 class="kv-modal-title" id="ncc_ModalTitle">Thêm nhà cung cấp mới</h5>
                        <div class="small text-muted">Thiết lập thông tin đối tác &amp; tỷ lệ chiết khấu nhập hàng mặc định.</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="kv-modal-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="kv-field-label">Mã nhà cung cấp</label>
                            <input type="text" name="MaCodeNcc" id="ncc_MaCodeNcc" class="kv-form-control" maxlength="30"
                                   placeholder="Để trống để tự sinh (VD: NCC007)" />
                        </div>
                        <div class="col-md-8">
                            <label class="kv-field-label">Tên nhà cung cấp <span class="text-danger">*</span></label>
                            <input type="text" name="TenNcc" id="ncc_TenNcc" class="kv-form-control" maxlength="200" required
                                   placeholder="VD: Nhà phân phối Kinh Đô Chính Hãng" />
                        </div>

                        <div class="col-md-4">
                            <label class="kv-field-label">Loại đối tác</label>
                            <select name="LoaiNcc" id="ncc_LoaiNcc" class="form-select">
                                <option value="HANG_CHINH_HANG">Hãng / NPP Cấp 1</option>
                                <option value="DAI_LY_DIEU_TIET">Đại lý điều tiết</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="kv-field-label">Thương hiệu cung cấp</label>
                            <input type="text" name="ThuongHieuCungCap" id="ncc_ThuongHieu" list="dlThuongHieuNcc" class="kv-form-control" maxlength="100"
                                   placeholder="VD: Kinh Đô hoặc Đa thương hiệu" />
                            <datalist id="dlThuongHieuNcc">
                                @foreach (var th in Model.DanhSachThuongHieu)
                                {
                                    <option value="@th"></option>
                                }
                            </datalist>
                        </div>
                        <div class="col-md-4">
                            <label class="kv-field-label">Chiết khấu mặc định (%) <span class="text-danger">*</span></label>
                            <input type="number" name="PhanTramChietKhauMacDinh" id="ncc_PhanTramCk" class="kv-form-control text-end fw-bold text-success"
                                   min="0" max="90" step="0.5" value="25" required />
                        </div>

                        <div class="col-md-6">
                            <label class="kv-field-label">Số điện thoại liên hệ</label>
                            <input type="text" name="SoDienThoai" id="ncc_SoDienThoai" class="kv-form-control" maxlength="20"
                                   placeholder="VD: 02838270838" />
                        </div>
                        <div class="col-md-6">
                            <label class="kv-field-label">Email đối tác</label>
                            <input type="email" name="Email" id="ncc_Email" class="kv-form-control" maxlength="150"
                                   placeholder="VD: lienhe@nhacungcap.vn" />
                        </div>

                        <div class="col-12">
                            <label class="kv-field-label">Địa chỉ kho / văn phòng</label>
                            <input type="text" name="DiaChi" id="ncc_DiaChi" class="kv-form-control" maxlength="300"
                                   placeholder="Số nhà, đường, quận/huyện, tỉnh/thành..." />
                        </div>

                        <div class="col-12">
                            <label class="kv-field-label">Ghi chú hợp tác &amp; điều khoản chiết khấu</label>
                            <textarea name="GhiChu" id="ncc_GhiChu" class="form-control" rows="2" maxlength="500"
                                      placeholder="Ghi chú chính sách giao hàng, thanh toán công nợ..."></textarea>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="DangHoatDong" id="ncc_DangHoatDong" value="true" checked />
                                <label class="form-check-label fw-medium" for="ncc_DangHoatDong">Đang hợp tác cung ứng hàng</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="kv-modal-footer">
                    <button type="button" class="btn-kv-outline" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn-kv-blue"><i class="bi bi-check2-circle"></i> Lưu nhà cung cấp</button>
                </div>
            </form>
        </div>
    </div>
</div>
