@model WebBanhTrungThu.ViewModels.NhaCungCapAdminViewModel

<div class="kv-card overflow-hidden">
    <div class="table-responsive">
        <table class="kv-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã NCC</th>
                    <th>Nhà cung cấp</th>
                    <th>Loại đối tác</th>
                    <th>Thương hiệu</th>
                    <th class="text-center">CK nhập mặc định</th>
                    <th>Liên hệ</th>
                    <th class="text-end">Tổng đã nhập</th>
                    <th class="text-end">Công nợ</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody id="tbodyNhaCungCap">
                @foreach (var ncc in Model.DanhSachNhaCungCap)
                {
                    string searchKey = $"{ncc.MaCodeNcc} {ncc.TenNcc} {ncc.ThuongHieuCungCap} {ncc.SoDienThoai} {ncc.Email} {ncc.DiaChi}".ToLowerInvariant();
                    string detailId = $"detailNcc_{ncc.MaNcc}";
                    string trangThaiFilter = ncc.DangHoatDong ? "ACTIVE" : "INACTIVE";

                    <tr class="kv-master-row"
                        data-detail-id="@detailId"
                        data-search="@searchKey"
                        data-loai="@ncc.LoaiNcc"
                        data-trangthai="@trangThaiFilter"
                        onclick="toggleKvDetailRow('@detailId', this)">
                        <td class="fw-bold text-primary text-nowrap">@ncc.MaCodeNcc</td>
                        <td>
                            <div class="fw-semibold text-dark">@ncc.TenNcc</div>
                            <small class="text-muted">@ncc.SoPhieuNhap phiếu nhập</small>
                        </td>
                        <td class="text-nowrap">
                            @if (ncc.LoaiNcc == "DAI_LY_DIEU_TIET")
                            {
                                <span class="badge" style="background: #FEF3C7; color: #92400E; border: 1px solid #FDE68A;">Đại lý điều tiết</span>
                            }
                            else
                            {
                                <span class="badge" style="background: #EBF5FF; color: #005AC3; border: 1px solid #BFDBFE;">Hãng / NPP Cấp 1</span>
                            }
                        </td>
                        <td><span class="fw-medium text-dark">@ncc.ThuongHieuCungCap</span></td>
                        <td class="text-center">
                            <span class="badge so-tien" style="background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; font-size: 12.5px;">
                                @ncc.PhanTramChietKhauMacDinh.ToString("0.##")%
                            </span>
                        </td>
                        <td>
                            <div>@(string.IsNullOrWhiteSpace(ncc.SoDienThoai) ? "---" : ncc.SoDienThoai)</div>
                            @if (!string.IsNullOrWhiteSpace(ncc.Email))
                            {
                                <small class="text-muted">@ncc.Email</small>
                            }
                        </td>
                        <td class="text-end fw-semibold text-dark so-tien">@ncc.TongGiaTriDaNhap.ToString("N0") đ</td>
                        <td class="text-end fw-bold so-tien @(ncc.CongNoConPhaiTra > 0 ? "text-danger" : "text-muted")">
                            @ncc.CongNoConPhaiTra.ToString("N0") đ
                        </td>
                        <td class="text-center text-nowrap">
                            @if (ncc.DangHoatDong)
                            {
                                <span class="badge" style="background: #DCFCE7; color: #166534; border: 1px solid #BBF7D0;">Đang hợp tác</span>
                            }
                            else
                            {
                                <span class="badge" style="background: #F3F4F6; color: #4B5563; border: 1px solid #D1D5DB;">Ngừng hợp tác</span>
                            }
                        </td>
                        <td class="text-end text-nowrap" onclick="event.stopPropagation();">
                            <div class="d-inline-flex align-items-center gap-1">
                                <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size: 12px; flex-shrink: 0; white-space: nowrap;"
                                        onclick="moModalSuaNhaCungCap(@ncc.MaNcc)">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </button>
                                @if (ncc.DangHoatDong)
                                {
                                    <form asp-area="Admin" asp-controller="NhaCungCapAdmin" asp-action="XoaNhaCungCap" method="post" class="d-inline"
                                          onsubmit="return confirm('@(ncc.SoPhieuNhap > 0 ? $"Nhà cung cấp {ncc.TenNcc} đã phát sinh phiếu nhập nên sẽ chuyển sang Ngừng hợp tác. Tiếp tục?" : $"Xác nhận xóa nhà cung cấp {ncc.TenNcc}?")');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maNcc" value="@ncc.MaNcc" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 12px; flex-shrink: 0; white-space: nowrap;">
                                            <i class="bi bi-trash"></i> @(ncc.SoPhieuNhap > 0 ? "Ngừng" : "Xóa")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-area="Admin" asp-controller="NhaCungCapAdmin" asp-action="KhoiPhucNhaCungCap" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="maNcc" value="@ncc.MaNcc" />
                                        <button type="submit" class="btn btn-sm btn-outline-success py-1 px-2" style="font-size: 12px; flex-shrink: 0; white-space: nowrap;">
                                            <i class="bi bi-arrow-clockwise"></i> Kích hoạt
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>

                    <tr id="@detailId" class="kv-detail-row d-none" onclick="event.stopPropagation();">
                        <td colspan="10" class="p-0">
                            <div class="kv-detail-box">
                                <div class="row g-3 mb-3" style="font-size: 13px;">
                                    <div class="col-md-6">
                                        <div><span class="text-muted">Địa chỉ:</span> <strong>@(string.IsNullOrWhiteSpace(ncc.DiaChi) ? "Chưa cập nhật" : ncc.DiaChi)</strong></div>
                                        <div class="mt-1"><span class="text-muted">Ghi chú hợp đồng:</span> @(string.IsNullOrWhiteSpace(ncc.GhiChu) ? "Không có ghi chú" : ncc.GhiChu)</div>
                                    </div>
                                    <div class="col-md-6 text-md-end">
                                        <div><span class="text-muted">Tổng đã thanh toán:</span> <strong class="text-success so-tien">@ncc.TongDaThanhToan.ToString("N0") đ</strong></div>
                                        <div class="mt-1"><span class="text-muted">Ngày tạo hồ sơ:</span> @ncc.NgayTao.ToString("dd/MM/yyyy HH:mm")</div>
                                    </div>
                                </div>

                                @if (ncc.DanhSachPhieuGanDay.Any())
                                {
                                    <div class="fw-semibold small text-dark mb-2">Phiếu nhập hàng gần đây (@ncc.SoPhieuNhap phiếu):</div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered bg-white align-middle mb-0" style="font-size: 12.5px;">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Số phiếu nhập</th>
                                                    <th>Ngày nhập</th>
                                                    <th class="text-end">Tổng phải trả</th>
                                                    <th class="text-end">Đã thanh toán</th>
                                                    <th class="text-center">Trạng thái kho</th>
                                                    <th class="text-center">Thanh toán</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var pn in ncc.DanhSachPhieuGanDay)
                                                {
                                                    <tr>
                                                        <td>
                                                            <a href="/Admin/NhapKhoAdmin/Index?tuKhoa=@pn.SoPhieuNhap" class="fw-semibold text-primary text-decoration-none">
                                                                @pn.SoPhieuNhap
                                                            </a>
                                                        </td>
                                                        <td>@pn.NgayNhap.ToString("dd/MM/yyyy HH:mm")</td>
                                                        <td class="text-end fw-semibold so-tien">@pn.TongPhaiTra.ToString("N0") đ</td>
                                                        <td class="text-end text-success so-tien">@pn.DaThanhToan.ToString("N0") đ</td>
                                                        <td class="text-center">@(pn.TrangThai == "DA_NHAP_KHO" ? "Đã nhập kho" : "Phiếu tạm")</td>
                                                        <td class="text-center">@pn.TrangThaiThanhToan</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="small text-muted">Đối tác này chưa phát sinh phiếu nhập kho nào.</div>
                                }
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.DanhSachNhaCungCap.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">
                            Chưa có dữ liệu nhà cung cấp phù hợp. Nhấn <strong>+ Thêm nhà cung cấp</strong> để tạo mới.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
