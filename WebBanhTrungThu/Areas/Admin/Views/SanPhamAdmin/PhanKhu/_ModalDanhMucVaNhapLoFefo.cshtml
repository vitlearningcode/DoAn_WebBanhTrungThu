<!-- MODAL CÁ NHÂN HÓA: TẠO MỚI NHÓM HÀNG / THƯƠNG HIỆU / NHÀ CUNG CẤP / VỊ TRÍ -->
<div class="modal fade" id="modalTaoDanhMucCaNhanHoa" tabindex="-1" aria-hidden="true" style="z-index: 1065;">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 10px;">
            <div class="modal-header py-2 px-3" style="background: #F4F6F8; border-bottom: 1px solid #E5E7EB;">
                <h6 class="modal-title fw-bold text-dark mb-0" id="lblPopupDmTitle">Tạo mới nhóm hàng</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3">
                <input type="hidden" id="hidPopupDmLoai" value="NHOM_HANG" />
                <div class="mb-2">
                    <label class="kv-field-label" id="lblPopupDmField1">Tên nhóm hàng</label>
                    <input type="text" id="inpPopupDmTenMoi" class="kv-form-control" placeholder="Nhập tên..." />
                </div>
                <div id="wrapPopupDmField2">
                    <label class="kv-field-label" id="lblPopupDmField2">Mô tả ngắn</label>
                    <input type="text" id="inpPopupDmMoTaPhu" class="kv-form-control" placeholder="Mô tả thêm (tùy chọn)..." />
                </div>
                <div id="msgPopupDmError" class="text-danger small mt-1" style="display:none;"></div>
            </div>
            <div class="modal-footer py-2 px-3" style="background: #F9FAFB;">
                <button type="button" class="btn-kv-outline btn-sm" data-bs-dismiss="modal">Bỏ qua</button>
                <button type="button" class="btn-kv-blue btn-sm" onclick="luuDanhMucNhanhAjax()">
                    <i class="bi bi-check2"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL NHẬP LÔ BÁNH FEFO MỚI TỪ DÒNG MỞ RỘNG (EXPANDABLE ROW) -->
<div class="modal fade" id="modalThemLoNhanhInline" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 8px;">
            <form asp-area="Admin" asp-controller="SanPhamAdmin" asp-action="ThemLoBanhMoi" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maBanh" id="hidThemLoMaBanh" value="0" />
                <input type="hidden" name="returnUrl" value="/Admin/SanPhamAdmin/Index" />

                <div class="modal-header py-2 px-3" style="background: #F4F6F8; border-bottom: 1px solid #E5E7EB;">
                    <h6 class="modal-title fw-bold text-dark mb-0">
                        <i class="bi bi-calendar-plus text-primary me-1"></i> Thêm lô mới: <span id="lblThemLoTenBanh" class="text-primary"></span>
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body p-3">
                    <div class="row g-2 mb-2">
                        <div class="col-sm-6">
                            <label class="form-label small fw-bold mb-1">Mã lô sản xuất</label>
                            <input type="text" name="maLoCode" class="form-control form-control-sm" placeholder="Tự động nếu để trống" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small fw-bold mb-1">SL nhập ban đầu <span class="text-danger">*</span></label>
                            <input type="number" name="slNhapBanDau" min="1" value="50" class="form-control form-control-sm text-end fw-bold" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-sm-6">
                            <label class="form-label small fw-bold mb-1">Ngày sản xuất</label>
                            <input type="date" name="ngaySanXuat" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small fw-bold mb-1">Hạn sử dụng</label>
                            <input type="date" name="hanSuDung" value="@DateTime.Today.AddDays(35).ToString("yyyy-MM-dd")" class="form-control form-control-sm" required />
                        </div>
                    </div>
                    <div>
                        <label class="form-label small fw-bold mb-1">% Giảm giá xả kho cận Date</label>
                        <div class="input-group input-group-sm">
                            <input type="number" name="phanTramGiamCanDate" min="0" max="90" value="0" class="form-control text-end" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer py-2 px-3" style="background: #F9FAFB;">
                    <button type="button" class="btn-kv-outline" data-bs-dismiss="modal">Bỏ qua</button>
                    <button type="submit" class="btn-kv-green"><i class="bi bi-check2"></i> Lưu lô mới</button>
                </div>
            </form>
        </div>
    </div>
</div>
