@model WebBanhTrungThu.ViewModels.CaiDatHeThongViewModel
@{
    var dsBanner = Model.DanhSachBanner;
    var dsAnh = Model.DanhSachAnhBanner;

    static (string TenViTri, string MoTaViTri, string IconClass) LayThongTinViTriThanThien(string? maCode, int thuTu)
    {
        string code = (maCode ?? string.Empty).Trim().ToUpperInvariant();
        return code switch
        {
            "HERO_BANNER" or "TANG_1_HERO" => ("Banner chính đầu trang", "Khu vực mở đầu & Đồng hồ đếm ngược", "bi-stars"),
            "BOX_BUILDER_INTRO" or "TANG_2_STUDIO" => ("Studio Phối Hộp Quà", "Giới thiệu tự chọn lễ hộp 4 & 6 bánh", "bi-gift"),
            "TANG_3_BOSUUTAP" => ("Bộ Sưu Tập Vị Bánh", "Trưng bày danh mục bánh 5 thương hiệu", "bi-grid-3x3-gap"),
            "TANG_4_CHIETKHAU" => ("Ưu Đãi Doanh Nghiệp", "Bảng chiết khấu số lượng lớn & Ép kim logo", "bi-building-check"),
            "TANG_5_THIEPQR" => ("Thiệp Chúc Mừng 3D QR", "Giới thiệu thiệp điện tử cá nhân hóa", "bi-envelope-paper-heart"),
            _ => ($"Phân khu Trang chủ #{thuTu}", "Khu vực nội dung quảng bá trên Trang chủ", "bi-layout-text-window-reverse")
        };
    }

    static string LayTenDichDenThanThien(string? url)
    {
        string u = (url ?? string.Empty).Trim();
        return u switch
        {
            "#studio-phoi-hop" or "#tang-tu-chon-hop" => "Cuộn tới Studio Phối Hộp Quà",
            "#bo-suu-tap-banh" => "Cuộn tới Bộ Sưu Tập Vị Bánh",
            "#chiet-khau-so-luong" => "Cuộn tới Bảng Chiết Khấu Sỉ",
            "/ThanhToan" => "Mở trang Đặt Hàng & Thanh Toán",
            "/TraCuuDonHang" => "Mở trang Tra Cứu Đơn Hàng",
            "/" => "Về đầu Trang chủ",
            _ => "Chuyển tới khu vực liên kết"
        };
    }

    static string LamSachTenAnhThuVien(string? tieuDeAlt, string? tenTepGoc, int maHa)
    {
        string raw = !string.IsNullOrWhiteSpace(tieuDeAlt) ? tieuDeAlt.Trim() : (tenTepGoc ?? $"Hình ảnh #{maHa}").Trim();
        raw = System.Text.RegularExpressions.Regex.Replace(raw, @"^Banner\s+[A-Z0-9_]+\s*-\s*", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return string.IsNullOrWhiteSpace(raw) ? $"Hình ảnh thư viện #{maHa}" : raw;
    }

    var danhSachDichDenGoiY = new (string Url, string TenHienThi)[]
    {
        ("#studio-phoi-hop", "Cuộn tới khu vực Studio Phối Hộp Quà"),
        ("#bo-suu-tap-banh", "Cuộn tới khu vực Bộ Sưu Tập Vị Bánh"),
        ("#chiet-khau-so-luong", "Cuộn tới khu vực Ưu Đãi Chiết Khấu Sỉ"),
        ("/ThanhToan", "Chuyển sang trang Đặt Hàng & Thanh Toán"),
        ("/TraCuuDonHang", "Chuyển sang trang Tra Cứu Đơn Hàng")
    };
}

<style>
    .kv-banner-select {
        width: 100%;
        height: 36px;
        border: 1px solid #CBD5E1;
        border-radius: 6px;
        padding: 0 10px;
        font-size: 13px;
        color: #1E293B;
        background-color: #FFFFFF;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .kv-banner-select:focus {
        border-color: #2563EB;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .kv-banner-thumb {
        width: 92px;
        height: 56px;
        border-radius: 7px;
        border: 1px solid #E2E8F0;
        background: #F8FAFC;
        object-fit: cover;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
    }

    .kv-banner-thumb-lg {
        width: 100%;
        height: 140px;
        border-radius: 8px;
        border: 1px solid #E2E8F0;
        background: #F8FAFC;
        object-fit: cover;
    }

    .kv-section-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        background: #EFF6FF;
        color: #1D4ED8;
        border: 1px solid #BFDBFE;
    }

    .kv-cta-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 999px;
        background: #F1F5F9;
        color: #334155;
        border: 1px solid #E2E8F0;
        font-size: 11.5px;
        font-weight: 500;
    }

    .kv-status-badge-on {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        font-size: 11.5px;
        font-weight: 600;
        border-radius: 999px;
        background: #ECFDF5;
        color: #047857;
        border: 1px solid #A7F3D0;
    }

    .kv-status-badge-off {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        font-size: 11.5px;
        font-weight: 600;
        border-radius: 999px;
        background: #F3F4F6;
        color: #4B5563;
        border: 1px solid #D1D5DB;
    }

    .kv-edit-banner-card {
        background: #FFFFFF;
        border: 1px solid #DBEAFE;
        border-radius: 10px;
        padding: 16px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }
</style>

<div class="kv-card p-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 border-bottom pb-3 mb-4">
        <div>
            <h2 class="h5 fw-bold text-dark mb-1">Quản lý Hình ảnh &amp; Nội dung Trang chủ</h2>
            <p class="text-muted small mb-0">
                Tùy chỉnh hình nền, tiêu đề chào mừng, thông điệp giới thiệu và nút điều hướng cho từng khu vực trên Trang chủ. Mọi thay đổi được áp dụng ngay sau khi lưu.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/" target="_blank" class="btn-kv-outline text-decoration-none d-inline-flex align-items-center gap-1" style="font-size: 13px;">
                <i class="bi bi-box-arrow-up-right"></i> Xem Trang chủ thực tế
            </a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="kv-table border">
            <thead>
                <tr>
                    <th style="width: 64px;" class="text-center">Vị trí</th>
                    <th style="width: 112px;" class="text-center">Hình nền</th>
                    <th style="width: 215px;">Khu vực trên Trang chủ</th>
                    <th>Tiêu đề &amp; Thông điệp hiển thị</th>
                    <th style="width: 135px;" class="text-center">Trạng thái</th>
                    <th style="width: 175px;" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < dsBanner.Count; i++)
                {
                    var item = dsBanner[i];
                    string urlAnh = item.MaAnhNenNavigation?.UrlHienThi ?? "/images/landing/hero-banner-trungthu.jpg";
                    string idCollapse = $"formSuaBanner_{item.MaPhanKhu}";
                    bool moMacDinh = string.Equals(item.MaCodeKhuVuc, "HERO_BANNER", StringComparison.OrdinalIgnoreCase)
                                  || (i == 0 && !dsBanner.Any(x => x.MaCodeKhuVuc == "HERO_BANNER"));
                    string mocDemNguocVal = item.MocThoiGianDemNguoc.HasValue
                        ? item.MocThoiGianDemNguoc.Value.ToString("yyyy-MM-ddTHH:mm")
                        : string.Empty;
                    var infoViTri = LayThongTinViTriThanThien(item.MaCodeKhuVuc, item.ThuTuHienThi);
                    string dichDenThanThien = LayTenDichDenThanThien(item.DuongDanCta);
                    string urlCtaHienTai = (item.DuongDanCta ?? "#studio-phoi-hop").Trim();
                    bool coTrongDanhSachGoiY = danhSachDichDenGoiY.Any(x => string.Equals(x.Url, urlCtaHienTai, StringComparison.OrdinalIgnoreCase));

                    <tr>
                        <td class="text-center">
                            <span class="badge rounded-pill" style="background: #F1F5F9; color: #334155; border: 1px solid #CBD5E1; font-size: 12px;">
                                Phần @item.ThuTuHienThi
                            </span>
                        </td>
                        <td class="text-center">
                            <img src="@urlAnh"
                                 alt="@item.TieuDeChinh"
                                 class="kv-banner-thumb"
                                 onerror="window.kvImgFallback && window.kvImgFallback(this)" />
                        </td>
                        <td>
                            <div class="kv-section-badge">
                                <i class="bi @infoViTri.IconClass"></i>
                                <span>@infoViTri.TenViTri</span>
                            </div>
                            <div class="small text-muted mt-1" style="font-size: 11.5px;">@infoViTri.MoTaViTri</div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark" style="font-size: 13.5px;">@item.TieuDeChinh</div>
                            @if (!string.IsNullOrWhiteSpace(item.TieuDePhu))
                            {
                                <div class="small text-primary fw-medium mt-1">@item.TieuDePhu</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.NoiDungMoTa))
                            {
                                <div class="small text-muted text-truncate mt-1" style="max-width: 420px;" title="@item.NoiDungMoTa">
                                    @item.NoiDungMoTa
                                </div>
                            }
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                @if (!string.IsNullOrWhiteSpace(item.ChuNutBamCta))
                                {
                                    <span class="kv-cta-pill">
                                        <i class="bi bi-hand-index-thumb text-primary"></i>
                                        <span>Nút bấm: <strong>@item.ChuNutBamCta</strong> (@dichDenThanThien)</span>
                                    </span>
                                }
                                @if (item.MocThoiGianDemNguoc.HasValue)
                                {
                                    <span class="kv-cta-pill">
                                        <i class="bi bi-clock-history text-warning"></i>
                                        <span>Đếm ngược đến: <strong>@item.MocThoiGianDemNguoc.Value.ToString("dd/MM/yyyy HH:mm")</strong></span>
                                    </span>
                                }
                            </div>
                        </td>
                        <td class="text-center">
                            @if (item.DangKichHoat)
                            {
                                <span class="kv-status-badge-on"><i class="bi bi-eye-fill"></i> Đang hiển thị</span>
                            }
                            else
                            {
                                <span class="kv-status-badge-off"><i class="bi bi-eye-slash"></i> Đang tạm ẩn</span>
                            }
                        </td>
                        <td class="text-end" style="white-space: nowrap;">
                            <div class="d-inline-flex align-items-center gap-1">
                                <button type="button"
                                        class="btn-kv-blue px-2 py-1"
                                        style="font-size: 12.5px;"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@idCollapse"
                                        aria-expanded="@(moMacDinh ? "true" : "false")">
                                    <i class="bi bi-pencil-square me-1"></i>Chỉnh sửa
                                </button>

                                <form asp-area="Admin"
                                      asp-controller="CaiDatAdmin"
                                      asp-action="ChuyenTrangThaiBanner"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="maPhanKhu" value="@item.MaPhanKhu" />
                                    <button type="submit"
                                            class="btn-kv-outline px-2 py-1"
                                            style="font-size: 12.5px;"
                                            title="@(item.DangKichHoat ? "Tạm ẩn khu vực này trên Trang chủ" : "Hiển thị lại khu vực này trên Trang chủ")">
                                        @(item.DangKichHoat ? "Tạm ẩn" : "Hiển thị")
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>

                    <tr class="collapse @(moMacDinh ? "show" : "")" id="@idCollapse" style="background: #F8FAFC;">
                        <td colspan="6" class="p-3 border-bottom">
                            <div class="kv-edit-banner-card">
                                <form asp-area="Admin"
                                      asp-controller="CaiDatAdmin"
                                      asp-action="LuuBannerLanding"
                                      method="post"
                                      enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="MaPhanKhu" value="@item.MaPhanKhu" />
                                    <input id="inpCode_@item.MaPhanKhu" type="hidden" name="MaCodeKhuVuc" value="@item.MaCodeKhuVuc" />

                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-2 border-bottom">
                                        <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                            <span class="kv-section-badge">
                                                <i class="bi @infoViTri.IconClass"></i>
                                                <span>@infoViTri.TenViTri</span>
                                            </span>
                                            <span class="text-muted fw-normal small">— @infoViTri.MoTaViTri</span>
                                        </div>
                                        <span class="small text-muted">
                                            <i class="bi bi-layers me-1 text-primary"></i>Vị trí hiển thị: <strong>Phần @item.ThuTuHienThi</strong> trên Trang chủ
                                        </span>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-lg-8">
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="kv-field-label" for="inpTieuDeChinh_@item.MaPhanKhu">Tiêu đề chính hiển thị *</label>
                                                    <input id="inpTieuDeChinh_@item.MaPhanKhu"
                                                           type="text"
                                                           name="TieuDeChinh"
                                                           class="kv-form-control fw-bold"
                                                           value="@item.TieuDeChinh"
                                                           placeholder="Nhập tiêu đề nổi bật..."
                                                           required />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="kv-field-label" for="inpTieuDePhu_@item.MaPhanKhu">Tiêu đề phụ / Dòng giới thiệu ngắn</label>
                                                    <input id="inpTieuDePhu_@item.MaPhanKhu"
                                                           type="text"
                                                           name="TieuDePhu"
                                                           class="kv-form-control"
                                                           value="@item.TieuDePhu"
                                                           placeholder="Nhập dòng giới thiệu ngắn phía trên..." />
                                                </div>

                                                <div class="col-12">
                                                    <label class="kv-field-label" for="inpMoTa_@item.MaPhanKhu">Nội dung mô tả chi tiết</label>
                                                    <textarea id="inpMoTa_@item.MaPhanKhu"
                                                              name="NoiDungMoTa"
                                                              rows="2"
                                                              class="form-control form-control-sm"
                                                              placeholder="Nhập đoạn văn mô tả ngắn gọn cho khách hàng...">@item.NoiDungMoTa</textarea>
                                                </div>

                                                <div class="col-md-4">
                                                    <label class="kv-field-label" for="inpCtaText_@item.MaPhanKhu">Tên nút bấm hành động</label>
                                                    <input id="inpCtaText_@item.MaPhanKhu"
                                                           type="text"
                                                           name="ChuNutBamCta"
                                                           class="kv-form-control"
                                                           value="@item.ChuNutBamCta"
                                                           placeholder="VD: Khám Phá Ngay" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="kv-field-label" for="inpCtaUrl_@item.MaPhanKhu">Khi khách bấm nút sẽ mở</label>
                                                    <select id="inpCtaUrl_@item.MaPhanKhu"
                                                            name="DuongDanCta"
                                                            class="kv-banner-select">
                                                        @if (!coTrongDanhSachGoiY && !string.IsNullOrWhiteSpace(urlCtaHienTai))
                                                        {
                                                            <option value="@urlCtaHienTai" selected>@LayTenDichDenThanThien(urlCtaHienTai)</option>
                                                        }
                                                        @foreach (var goiY in danhSachDichDenGoiY)
                                                        {
                                                            bool dangChonUrl = string.Equals(urlCtaHienTai, goiY.Url, StringComparison.OrdinalIgnoreCase);
                                                            <option value="@goiY.Url" selected="@(dangChonUrl ? "selected" : null)">@goiY.TenHienThi</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="kv-field-label" for="inpDemNguoc_@item.MaPhanKhu">Thời hạn đồng hồ đếm ngược</label>
                                                    <input id="inpDemNguoc_@item.MaPhanKhu"
                                                           type="datetime-local"
                                                           name="MocThoiGianDemNguoc"
                                                           class="kv-form-control"
                                                           value="@mocDemNguocVal" />
                                                </div>

                                                <div class="col-md-4">
                                                    <label class="kv-field-label" for="inpThuTu_@item.MaPhanKhu">Thứ tự xuất hiện trên trang</label>
                                                    <input id="inpThuTu_@item.MaPhanKhu"
                                                           type="number"
                                                           min="1"
                                                           max="20"
                                                           name="ThuTuHienThi"
                                                           class="kv-form-control"
                                                           value="@item.ThuTuHienThi" />
                                                </div>
                                                <div class="col-md-8">
                                                    <label class="kv-field-label" for="selTrangThai_@item.MaPhanKhu">Chế độ hiển thị</label>
                                                    <select id="selTrangThai_@item.MaPhanKhu" name="DangKichHoat" class="kv-banner-select">
                                                        @if (item.DangKichHoat)
                                                        {
                                                            <option value="true" selected>Đang hiển thị công khai ngoài Trang chủ</option>
                                                            <option value="false">Tạm ẩn khu vực này</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="true">Đang hiển thị công khai ngoài Trang chủ</option>
                                                            <option value="false" selected>Tạm ẩn khu vực này</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-4">
                                            <div class="p-3 rounded border" style="background: #F8FAFC; border-color: #E2E8F0 !important;">
                                                <div class="mb-2">
                                                    <label class="kv-field-label">Hình nền đang sử dụng</label>
                                                    <img id="imgPreviewBanner_@item.MaPhanKhu"
                                                         src="@urlAnh"
                                                         alt="Xem trước hình nền"
                                                         class="kv-banner-thumb-lg"
                                                         onerror="window.kvImgFallback && window.kvImgFallback(this)" />
                                                </div>

                                                <div class="mb-2">
                                                    <label class="kv-field-label" for="selAnhNen_@item.MaPhanKhu">Chọn hình có sẵn trong thư viện</label>
                                                    <select id="selAnhNen_@item.MaPhanKhu"
                                                            name="MaAnhNen"
                                                            class="kv-banner-select"
                                                            onchange="capNhatXemTruocAnhBanner(this, 'imgPreviewBanner_@item.MaPhanKhu')">
                                                        <option value="" data-url="/images/landing/hero-banner-trungthu.jpg">-- Hình nền Trung Thu mặc định --</option>
                                                        @foreach (var ha in dsAnh)
                                                        {
                                                            bool dangChon = item.MaAnhNen == ha.MaHa;
                                                            string tenAnhDep = LamSachTenAnhThuVien(ha.TieuDeAlt, ha.TenTepGoc, ha.MaHa);
                                                            <option value="@ha.MaHa"
                                                                    data-url="@ha.UrlHienThi"
                                                                    selected="@(dangChon ? "selected" : null)">
                                                                @tenAnhDep
                                                            </option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="mb-2">
                                                    <label class="kv-field-label" for="inpFileBanner_@item.MaPhanKhu">Hoặc tải hình mới từ máy tính</label>
                                                    <input id="inpFileBanner_@item.MaPhanKhu"
                                                           type="file"
                                                           name="TepAnhNenMoi"
                                                           accept=".jpg,.jpeg,.png,.webp"
                                                           class="form-control form-control-sm"
                                                           onchange="xemTruocTepBannerTaiLen(this, 'imgPreviewBanner_@item.MaPhanKhu')" />
                                                    <small class="text-muted d-block mt-1" style="font-size: 11.5px;">
                                                        Hỗ trợ ảnh JPG, PNG, WebP sắc nét (tối đa 5MB). Hình tải lên sẽ tự động áp dụng khi bấm Lưu.
                                                    </small>
                                                </div>

                                                <div>
                                                    <label class="kv-field-label" for="selAnhPhu_@item.MaPhanKhu">Hình trang trí phụ (tùy chọn)</label>
                                                    <select id="selAnhPhu_@item.MaPhanKhu" name="MaAnhPhuParallax" class="kv-banner-select">
                                                        <option value="">-- Không dùng hình trang trí phụ --</option>
                                                        @foreach (var ha in dsAnh)
                                                        {
                                                            bool chonPhu = item.MaAnhPhuParallax == ha.MaHa;
                                                            string tenAnhPhuDep = LamSachTenAnhThuVien(ha.TieuDeAlt, ha.TenTepGoc, ha.MaHa);
                                                            <option value="@ha.MaHa" selected="@(chonPhu ? "selected" : null)">
                                                                @tenAnhPhuDep
                                                            </option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-3 pt-3 border-top d-flex justify-content-end gap-2">
                                        <button type="button"
                                                class="btn-kv-outline px-3 py-1"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#@idCollapse">
                                            Thu gọn
                                        </button>
                                        <button type="submit" class="btn-kv-blue px-4 py-1 fw-semibold">
                                            <i class="bi bi-check2-circle me-1"></i> Lưu thay đổi
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function capNhatXemTruocAnhBanner(selectEl, imgId) {
        const imgEl = document.getElementById(imgId);
        if (!imgEl || !selectEl) return;
        const opt = selectEl.options[selectEl.selectedIndex];
        const url = opt ? opt.getAttribute("data-url") : "/images/landing/hero-banner-trungthu.jpg";
        if (url) {
            imgEl.src = url;
        }
    }

    function xemTruocTepBannerTaiLen(inputEl, imgId) {
        const imgEl = document.getElementById(imgId);
        if (!imgEl || !inputEl || !inputEl.files || !inputEl.files.length) return;
        const file = inputEl.files[0];
        const reader = new FileReader();
        reader.onload = function (e) {
            if (e.target && e.target.result) {
                imgEl.src = e.target.result;
            }
        };
        reader.readAsDataURL(file);
    }
</script>
