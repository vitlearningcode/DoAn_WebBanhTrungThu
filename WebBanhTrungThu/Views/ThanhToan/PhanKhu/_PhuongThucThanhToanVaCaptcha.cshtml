@model WebBanhTrungThu.ViewModels.TrangThanhToanViewModel

<div class="mb-4">
    <h2 class="fs-5 fw-bold text-dark mb-3">Phương thức thanh toán</h2>
    <div id="nhomPhuongThucThanhToan" class="danh-sach-phuong-thuc-tt-bitis">
        <label class="dong-phuong-thuc-tt-bitis dang-chon">
            <input type="radio" name="PhuongThucTt" value="COD" checked class="form-check-input mt-0" onchange="capNhatTrangThaiPhuongThucTt()" />
            <span class="fw-medium text-dark">Thanh toán khi nhận hàng (COD)</span>
        </label>
        <label class="dong-phuong-thuc-tt-bitis">
            <input type="radio" name="PhuongThucTt" value="MOMO_QR" class="form-check-input mt-0" onchange="capNhatTrangThaiPhuongThucTt()" />
            <span class="d-inline-flex align-items-center gap-2 fw-medium text-dark"><span class="logo-momo-badge">momo</span><span>Ví MoMo – Quét mã QR chuyển khoản (0814 585 526)</span></span>
        </label>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 pt-2">
    <a href="javascript:void(0)" onclick="moNganKeoGioHang()" class="lien-ket-quay-lai-gio-bitis">← Quay lại giỏ hàng</a>
    <button type="submit" id="btnHoanTatDatHang" class="btn-hoan-tat-dat-hang-bitis">HOÀN TẤT ĐẶT HÀNG</button>
</div>
