@model WebBanhTrungThu.ViewModels.TrangThanhToanViewModel
@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng - Nguyệt Cát";
    int tongSoMon = Model.DanhSachMon.Sum(x => x.SoLuong);
    int tongSoLuongSanPham = Model.GioHang?.ChiTietGioHangs?.Sum(x => x.SoLuong) ?? tongSoMon;
    decimal tienHangSauGiamBanDau = Math.Max(0m, Model.TongTienHang - Model.TienChietKhauB2B - Model.TienGiamVoucher);
    bool duMienPhiShip = tienHangSauGiamBanDau >= 500000m;
    decimal phiShipMacDinh = duMienPhiShip ? 0m : 30000m;
    decimal tongThanhToanBanDau = Math.Max(0m, tienHangSauGiamBanDau + phiShipMacDinh);
    string ngayHenMacDinh = DateTime.Now.AddDays(2).ToString("yyyy-MM-dd");

    var diaChiMacDinh = Model.DanhSachSoDiaChi.FirstOrDefault();
    string soNhaBanDau = diaChiMacDinh?.DiaChiCuThe ?? "";
    string tinhThanhBanDau = diaChiMacDinh?.TinhThanh ?? "TP. Hồ Chí Minh";
    string phuongQuanBanDau = diaChiMacDinh != null
        ? $"{diaChiMacDinh.PhuongXa}, {diaChiMacDinh.QuanHuyen}"
        : "";
    string diaChiGhepBanDau = diaChiMacDinh != null
        ? $"{diaChiMacDinh.DiaChiCuThe}, {diaChiMacDinh.PhuongXa}, {diaChiMacDinh.QuanHuyen}, {diaChiMacDinh.TinhThanh}"
        : "";

    string? tenBanhHetHangBanDau = TempData["TenBanhHetHang"] as string ?? ViewBag.TenBanhHetHangKhiTaiTrang as string;
    string? thongBaoHetHangBanDau = TempData["LoiThanhToan"] as string ?? ViewBag.ThongBaoHetHangKhiTaiTrang as string;

    string LayAnhDaiDienMon(object? entity, string anhMacDinh = "/images/default/banh-mac-dinh.png")
    {
        if (entity == null) return anhMacDinh;
        var kieu = entity.GetType();
        foreach (var tenThuocTinh in new[] { "HinhAnh", "AnhDaiDien", "UrlHinhAnh", "AnhBanh", "HinhAnhChinh", "AnhMinhHoa", "HinhAnhCombo", "AnhVoHop" })
        {
            var prop = kieu.GetProperty(tenThuocTinh);
            if (prop != null && prop.GetValue(entity) is string duongDan && !string.IsNullOrWhiteSpace(duongDan))
            {
                return duongDan;
            }
        }
        return anhMacDinh;
    }
}

<section class="py-4 trang-thanh-toan-bitis">
    <div class="container">
        <form asp-controller="ThanhToan" asp-action="DatHang" method="post" id="formDatHangTrungThu" onsubmit="return chuanBiTruocKhiGuiDon(event)">
            @if (TempData["LoiThanhToan"] != null)
            {
                <div class="alert alert-danger border border-danger mb-4 rounded-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>@TempData["LoiThanhToan"]</strong>
                </div>
            }
            @Html.AntiForgeryToken()
            <input type="hidden" name="TocDoGiaoHang" id="hidTocDoGiaoHang" value="GIAO_TIEU_CHUAN" />
            <input type="hidden" name="CoThiep3D" id="hidCoThiep3D" value="false" />
            <input type="hidden" name="DanhSachDotGiao[0].TinhThanhPho" id="dot0_TinhThanhPho" value="@tinhThanhBanDau" />
            <input type="hidden" name="DanhSachDotGiao[0].DiaChiGiaoChiTiet" id="dot0_DiaChi" value="@diaChiGhepBanDau" />
            <input type="hidden" name="DanhSachDotGiao[0].NgayHenGiao" value="@ngayHenMacDinh" />
            <input type="hidden" name="DanhSachDotGiao[0].KhungGioGiao" value="Sáng (08:00 - 11:30)" />

            <div class="row g-4 align-items-start">
                <!-- =========================================================================
                     A. CỘT TRÁI (55% CHIỀU RỘNG - PHẲNG, SẠCH TRÊN NỀN TRẮNG #FFFFFF NHƯ BITI'S)
                     ========================================================================= -->
                <div class="col-lg-7 cot-trai-bitis">
                    <div class="khung-cot-trai-bitis">
                        <!-- Dòng đầu: Đăng nhập hoặc Xin chào + Chọn nhanh Sổ địa chỉ -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                            @if (!Model.DaDangNhap)
                            {
                                <div class="small" style="color: #4B5563;">
                                    Bạn đã có tài khoản?
                                    <a href="javascript:void(0)" data-bs-toggle="modal" data-bs-target="#modalTaiKhoan"
                                       class="fw-bold text-decoration-underline ms-1" style="color: #111827;">
                                        Đăng nhập ngay
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="small fw-semibold" style="color: #111827;">
                                    Xin chào, <strong>@Model.HoTenNguoiMua</strong>
                                </div>
                            }

                            @if (Model.DaDangNhap && Model.DanhSachSoDiaChi.Any())
                            {
                                <select id="ddlSoDiaChiDaLuu" class="form-select form-select-sm w-auto"
                                        style="font-size: 0.8rem; border-color: #D1D5DB; color: #111827; font-weight: 500; height: 34px;"
                                        onchange="chonTuDropdownSoDiaChi(this)">
                                    <option value="">Chọn nhanh từ Sổ địa chỉ...</option>
                                    @foreach (var dc in Model.DanhSachSoDiaChi)
                                    {
                                        string phuongQuan = $"{dc.PhuongXa}, {dc.QuanHuyen}";
                                        <option value="@dc.DiaChiCuThe"
                                                data-ten="@dc.TenNguoiNhan"
                                                data-sdt="@dc.SdtnguoiNhan"
                                                data-tinhthanh="@dc.TinhThanh"
                                                data-phuongquan="@phuongQuan">
                                            @(dc.NhanDiaChi ?? dc.TenNguoiNhan) - @dc.DiaChiCuThe, @dc.QuanHuyen
                                        </option>
                                    }
                                </select>
                            }
                        </div>

                        <!-- Tiêu đề lớn: Thông tin giao hàng -->
                        <h2 style="font-size: 1.25rem; font-weight: 700; color: #111827; margin-bottom: 16px;">
                            Thông tin giao hàng
                        </h2>

                        <!-- 2 Tab chọn gọn gàng: [ Giao tận nơi ] | [ Nhận tại cửa hàng ] -->
                        <div class="tab-hinh-thuc-nhan-bitis mb-3">
                            <label class="nut-tab-nhan-bitis dang-chon" id="lblChonGiaoTanNoi">
                                <input type="radio" name="HinhThucNhanHang" id="radGiaoTanNoi" value="GIAO_TAN_NOI" checked
                                       onchange="chuyenDoiHinhThucNhanHang()" />
                                <span>Giao tận nơi</span>
                            </label>
                            <label class="nut-tab-nhan-bitis" id="lblChonNhanTaiCuaHang">
                                <input type="radio" name="HinhThucNhanHang" id="radNhanTaiCuaHang" value="NHAN_TAI_CUA_HANG"
                                       onchange="chuyenDoiHinhThucNhanHang()" />
                                <span>Nhận tại cửa hàng</span>
                            </label>
                        </div>

                        <!-- Hệ thống ô nhập liệu phẳng chuẩn Biti's -->
                        <div class="row g-2 mb-2">
                            <!-- Hàng 1: Ô Họ và tên * (rộng 100%) -->
                            <div class="col-12">
                                <input type="text" name="HoTenNguoiMua" id="txtHoTenNguoiMua" required
                                       class="input-phang-bitis"
                                       value="@Model.HoTenNguoiMua"
                                       placeholder="Họ và tên *"
                                       oninput="dongBoNguoiMuaSangNguoiNhan()" />
                            </div>

                            <!-- Hàng 2 (2 cột): Ô Email (bên trái) và Ô Số điện thoại * (bên phải) -->
                            <div class="col-md-6">
                                <input type="email" name="EmailNguoiMua" id="txtEmailNguoiMua"
                                       class="input-phang-bitis"
                                       value="@Model.EmailNguoiMua"
                                       placeholder="Email" />
                            </div>
                            <div class="col-md-6">
                                <input type="text" name="SdtNguoiMua" id="txtSdtNguoiMua" required
                                       class="input-phang-bitis"
                                       value="@Model.SdtNguoiMua"
                                       placeholder="Số điện thoại *"
                                       oninput="dongBoNguoiMuaSangNguoiNhan()" />
                            </div>
                        </div>

                        <!-- Hàng 3, 4, 5 (Khi chọn Giao tận nơi) -->
                        <div id="khungDiaChiGiaoTanNoi">
                            <div class="row g-2 mb-2">
                                <!-- Hàng 3: Ô Địa chỉ (Số nhà, tên đường) * (rộng 100%) -->
                                <div class="col-12">
                                    <input type="text" id="txtDiaChiSoNha"
                                           class="input-phang-bitis"
                                           value="@soNhaBanDau"
                                           placeholder="Địa chỉ (Số nhà, tên đường) *"
                                           oninput="dongBoDiaChiGiaoChinh()" />
                                </div>

                                <!-- Hàng 4 (2 cột): Chọn Tỉnh/Thành phố * và Quận/Huyện, Phường/Xã * -->
                                <div class="col-md-6">
                                    <select id="ddlTinhThanh" class="input-phang-bitis" onchange="dongBoDiaChiGiaoChinh(); kiemTraTinhThanhVaCapNhatHoaToc();">
                                        <option value="TP. Hồ Chí Minh" selected="@(tinhThanhBanDau.Contains("Hồ Chí Minh"))">TP. Hồ Chí Minh</option>
                                        <option value="An Giang" selected="@(tinhThanhBanDau.Contains("An Giang"))">An Giang (TP. Long Xuyên)</option>
                                        <option value="Hà Nội" selected="@(tinhThanhBanDau.Contains("Hà Nội"))">Hà Nội</option>
                                        <option value="Đà Nẵng" selected="@(tinhThanhBanDau.Contains("Đà Nẵng"))">Đà Nẵng</option>
                                        <option value="Cần Thơ" selected="@(tinhThanhBanDau.Contains("Cần Thơ"))">Cần Thơ</option>
                                        <option value="Bình Dương" selected="@(tinhThanhBanDau.Contains("Bình Dương"))">Bình Dương</option>
                                        <option value="Đồng Nai" selected="@(tinhThanhBanDau.Contains("Đồng Nai"))">Đồng Nai</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <input type="text" id="txtPhuongXaQuanHuyen" list="goiYPhuongQuan"
                                           class="input-phang-bitis"
                                           value="@phuongQuanBanDau"
                                           placeholder="Quận/Huyện, Phường/Xã *"
                                           oninput="dongBoDiaChiGiaoChinh()" />
                                    <datalist id="goiYPhuongQuan">
                                        <option value="Phường Bến Nghé, Quận 1"></option>
                                        <option value="Phường Bến Thành, Quận 1"></option>
                                        <option value="Phường Võ Thị Sáu, Quận 3"></option>
                                        <option value="Phường Thảo Điền, TP. Thủ Đức"></option>
                                        <option value="Phường Mỹ Xuyên, TP. Long Xuyên"></option>
                                        <option value="Phường Mỹ Bình, TP. Long Xuyên"></option>
                                    </datalist>
                                </div>
                            </div>

                            <!-- Hàng 5: Hai nút chọn tốc độ giao nằm gọn trên 1 hàng ngang -->
                            <div id="khungPhuongThucVanChuyen" class="mb-3">
                                <div class="hang-toc-do-giao-bitis">
                                    <label class="o-toc-do-giao-bitis dang-chon" id="lblDongGiaoTieuChuan">
                                        <input type="radio" name="GoiTocDoGiao" id="radGiaoTieuChuan" value="GIAO_TIEU_CHUAN" checked
                                               class="form-check-input mt-0" onchange="capNhatBangTinhThanhToan()" />
                                        <span>Giao tiêu chuẩn (<span id="lblGiaShipTieuChuan">30.000đ</span> / Miễn phí từ 500k)</span>
                                    </label>
                                    <label class="o-toc-do-giao-bitis" id="lblDongGiaoHoaToc">
                                        <input type="radio" name="GoiTocDoGiao" id="radGiaoHoaToc" value="GIAO_HOA_TOC"
                                               class="form-check-input mt-0" onchange="capNhatBangTinhThanhToan()" />
                                        <span>Hỏa tốc 6h (<span id="lblGiaShipHoaToc">60.000đ</span> - Nội thành TP.HCM &amp; Long Xuyên)</span>
                                    </label>
                                </div>
                                <div id="thongBaoGioiHanHoaToc" class="mt-1 small" style="display: none; color: #DC2626; font-size: 0.78rem;">
                                    Hỏa tốc 6h hiện chỉ hỗ trợ tại TP. Hồ Chí Minh và TP. Long Xuyên (An Giang).
                                </div>
                            </div>
                        </div>

                        <!-- Khối Nhận tại cửa hàng (Khi chọn tab Nhận tại cửa hàng) -->
                        <div id="khungNhanTaiCuaHang" class="mb-3" style="display: none;">
                            <label class="the-cua-hang-nhan">
                                <div class="d-flex align-items-start gap-2">
                                    <input type="radio" name="CuaHangNhan" class="form-check-input mt-1" checked
                                           value="[Nhận tại cửa hàng] Nguyệt Cát – Quận 1, Nguyễn Huệ (128 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh - 0909 123 456)"
                                           onchange="dongBoDiaChiGiaoChinh()" />
                                    <div>
                                        <strong class="d-block" style="color: #111827; font-size: 0.9rem;">Nguyệt Cát – Quận 1, Nguyễn Huệ</strong>
                                        <small class="text-muted d-block" style="font-size: 0.78rem;">128 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh</small>
                                    </div>
                                </div>
                                <span class="small fw-semibold text-success text-nowrap">Miễn phí • 0đ</span>
                            </label>

                            <label class="the-cua-hang-nhan">
                                <div class="d-flex align-items-start gap-2">
                                    <input type="radio" name="CuaHangNhan" class="form-check-input mt-1"
                                           value="[Nhận tại cửa hàng] Nguyệt Cát – Quận 3, Pasteur (215 Pasteur, Phường Võ Thị Sáu, Quận 3, TP. Hồ Chí Minh - 0909 654 321)"
                                           onchange="dongBoDiaChiGiaoChinh()" />
                                    <div>
                                        <strong class="d-block" style="color: #111827; font-size: 0.9rem;">Nguyệt Cát – Quận 3, Pasteur</strong>
                                        <small class="text-muted d-block" style="font-size: 0.78rem;">215 Pasteur, Phường Võ Thị Sáu, Quận 3, TP. Hồ Chí Minh</small>
                                    </div>
                                </div>
                                <span class="small fw-semibold text-success text-nowrap">Miễn phí • 0đ</span>
                            </label>

                            <label class="the-cua-hang-nhan">
                                <div class="d-flex align-items-start gap-2">
                                    <input type="radio" name="CuaHangNhan" class="form-check-input mt-1"
                                           value="[Nhận tại cửa hàng] Nguyệt Cát – Long Xuyên, An Giang (45 Trần Hưng Đạo, Phường Mỹ Xuyên, TP. Long Xuyên, An Giang - 0909 888 999)"
                                           onchange="dongBoDiaChiGiaoChinh()" />
                                    <div>
                                        <strong class="d-block" style="color: #111827; font-size: 0.9rem;">Nguyệt Cát – Long Xuyên, An Giang</strong>
                                        <small class="text-muted d-block" style="font-size: 0.78rem;">45 Trần Hưng Đạo, Phường Mỹ Xuyên, TP. Long Xuyên, An Giang</small>
                                    </div>
                                </div>
                                <span class="small fw-semibold text-success text-nowrap">Miễn phí • 0đ</span>
                            </label>
                        </div>

                        <!-- Các tùy chọn phụ thu gọn thành dòng checkbox mảnh, không bọc khung viền dày -->
                        <div class="danh-sach-tuy-chon-manh-bitis mb-4">
                            <!-- Tùy chọn 1: Đính kèm Thiệp Chúc Tết Đoàn Viên QR 3D (Miễn phí) -->
                            <div class="dong-tuy-chon-manh-bitis">
                                <div class="form-check d-flex align-items-center gap-2 m-0">
                                    <input class="form-check-input" type="checkbox" id="chkThiepQr_0"
                                           name="DanhSachDotGiao[0].CoKemThiepQr" value="true"
                                           onchange="xuLyBatTatThiepQrChinh(this)">
                                    <label class="form-check-label" for="chkThiepQr_0" style="cursor: pointer; color: #1F2937; font-size: 0.9rem;">
                                        Đính kèm Thiệp Chúc Tết Đoàn Viên QR 3D (Miễn phí)
                                    </label>
                                </div>

                                <div id="khungChiTietThiepQr" class="mt-2 pt-2" style="display: none;">
                                    <div class="row g-2 mb-2">
                                        <div class="col-md-5">
                                            <input type="text" name="DanhSachDotGiao[0].TenNguoiNhanThiep" id="txtKinhGuiTrenThiep_0"
                                                   class="input-phang-bitis"
                                                   placeholder="Kính gửi (Người nhận trên thiệp) *"
                                                   oninput="kiemTraTrungTenThiep3D()" />
                                        </div>
                                        <div class="col-md-4">
                                            <input type="text" name="DanhSachDotGiao[0].TenNguoiGuiThiep" id="txtNguoiGuiTrenThiep_0"
                                                   class="input-phang-bitis"
                                                   value="@Model.HoTenNguoiMua"
                                                   placeholder="Người gửi *"
                                                   oninput="kiemTraTrungTenThiep3D()" />
                                        </div>
                                        <div class="col-md-3">
                                            <select name="DanhSachDotGiao[0].MauGiaoDienThiep" class="input-phang-bitis">
                                                <option value="CO_PHONG_HOANG_GIA">Cổ Phong Hoàng Gia</option>
                                                <option value="TRANG_RAM_HIEN_DAI">Trăng Rằm Hiện Đại</option>
                                                <option value="SUM_VAY_AM_AP">Sum Vầy Ấm Áp</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div id="canhBaoTrungTenThiep3D" class="mb-2 small" style="display: none; color: #B45309; font-size: 0.78rem;">
                                        Lưu ý: Tên Kính gửi và Người gửi trên thiệp đang trùng nhau.
                                    </div>
                                    <textarea name="DanhSachDotGiao[0].LoiChucThiep" id="txtLoiChucThiep_0" rows="2"
                                              class="form-control" style="border: 1px solid #E5E7EB; border-radius: 6px; font-size: 0.9rem;"
                                              placeholder="Lời chúc Tết Đoàn Viên *">Kính chúc Gia đình mùa Trăng Rằm Đoàn Viên, Hạnh Phúc &amp; Vạn Sự An Khang!</textarea>
                                </div>
                            </div>

                            <!-- Tùy chọn 2: Gọi người khác nhận hàng -->
                            <div class="dong-tuy-chon-manh-bitis">
                                <div class="form-check d-flex align-items-center gap-2 m-0">
                                    <input class="form-check-input" type="checkbox" id="chkGoiNguoiKhacNhan"
                                           onchange="xuLyBatTatNguoiKhacNhan()">
                                    <label class="form-check-label" id="lblChkGoiNguoiKhacNhan" for="chkGoiNguoiKhacNhan" style="cursor: pointer; color: #1F2937; font-size: 0.9rem;">
                                        @(tongSoLuongSanPham >= 2
                                            ? $"Gọi người khác nhận hàng (Chia điểm nhận tối đa {tongSoLuongSanPham} địa chỉ)"
                                            : "Gọi người khác nhận hàng")
                                    </label>
                                </div>

                                <div id="khungNguoiKhacNhanHang" class="mt-2 pt-2" style="display: none;">
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <input type="text" name="DanhSachDotGiao[0].TenNguoiNhan" id="dot0_TenNguoiNhan" required
                                                   class="input-phang-bitis"
                                                   value="@(diaChiMacDinh?.TenNguoiNhan ?? Model.HoTenNguoiMua)"
                                                   placeholder="Họ và tên người nhận *" />
                                        </div>
                                        <div class="col-md-6">
                                            <input type="text" name="DanhSachDotGiao[0].SdtNguoiNhan" id="dot0_SdtNguoiNhan" required
                                                   class="input-phang-bitis"
                                                   value="@(diaChiMacDinh?.SdtnguoiNhan ?? Model.SdtNguoiMua)"
                                                   placeholder="Số điện thoại người nhận *" />
                                        </div>
                                    </div>

                                    <input type="hidden" name="DiemNhanQuas[0].TenNguoiNhan" id="diem0_TenNguoiNhan" value="@(diaChiMacDinh?.TenNguoiNhan ?? Model.HoTenNguoiMua)" />
                                    <input type="hidden" name="DiemNhanQuas[0].SdtNguoiNhan" id="diem0_SdtNguoiNhan" value="@(diaChiMacDinh?.SdtnguoiNhan ?? Model.SdtNguoiMua)" />

                                    <div id="danhSachCacDotGiaoContainer" class="mt-2" style="display: @(tongSoLuongSanPham >= 2 ? "block" : "none");"></div>

                                    <button type="button" id="btnThemDiemNhanQua" class="btn btn-sm btn-outline-dark rounded-pill px-3 mt-2"
                                            style="display: @(tongSoLuongSanPham >= 2 ? "inline-block" : "none");"
                                            onclick="themDotGiaoHangMoi()">
                                        + Thêm điểm nhận quà khác
                                    </button>
                                </div>
                            </div>

                            <!-- Tùy chọn 3: Xuất hóa đơn VAT / Đơn hàng Doanh nghiệp (B2B) -->
                            <div class="dong-tuy-chon-manh-bitis">
                                <div class="form-check d-flex align-items-center gap-2 m-0">
                                    <input class="form-check-input" type="checkbox" id="chkDonB2B"
                                           name="LaDonDoanhNghiepB2B" value="true"
                                           onchange="capNhatBangTinhThanhToan()">
                                    <label class="form-check-label" for="chkDonB2B" style="cursor: pointer; color: #1F2937; font-size: 0.9rem;">
                                        Xuất hóa đơn VAT / Đơn hàng Doanh nghiệp (B2B)
                                    </label>
                                </div>

                                <div id="khungThongTinB2B" class="mt-2 pt-2" style="display: none;">
                                    <div class="row g-2">
                                        <div class="col-md-7">
                                            <input type="text" name="TenCongTy" class="input-phang-bitis" placeholder="Tên công ty / Tổ chức" />
                                        </div>
                                        <div class="col-md-5">
                                            <input type="text" name="MaSoThue" class="input-phang-bitis" placeholder="Mã số thuế" />
                                        </div>
                                        <div class="col-12">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-1">
                                                <div class="form-check m-0">
                                                    <input class="form-check-input" type="checkbox" id="chkYeuCauInLogo"
                                                           name="YeuCauInLogo" value="true" onchange="capNhatBangTinhThanhToan()">
                                                    <label class="form-check-label small" for="chkYeuCauInLogo" style="cursor: pointer; color: #1F2937;">
                                                        Ép kim Logo doanh nghiệp lên nắp hộp quà
                                                    </label>
                                                </div>
                                                @if (Model.MienPhiInLogo)
                                                {
                                                    <span class="small fw-semibold text-success">Đạt @Model.TongSoHop hộp: Miễn phí khuôn Logo</span>
                                                }
                                                else
                                                {
                                                    <span class="small text-muted">Phụ phí khuôn: +@Model.PhiInLogoMacDinh.ToString("N0")đ</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Khối Phương thức thanh toán (2 lựa chọn sạch gọn) -->
                        <div class="mb-4">
                            <h2 style="font-size: 1.25rem; font-weight: 700; color: #111827; margin-bottom: 12px;">
                                Phương thức thanh toán
                            </h2>

                            <div id="nhomPhuongThucThanhToan" class="danh-sach-phuong-thuc-tt-bitis">
                                <label class="dong-phuong-thuc-tt-bitis dang-chon">
                                    <input type="radio" name="PhuongThucTt" value="COD" checked
                                           class="form-check-input mt-0"
                                           onchange="capNhatTrangThaiPhuongThucTt()" />
                                    <span class="fw-medium" style="color: #111827; font-size: 0.92rem;">
                                        Thanh toán khi nhận hàng (COD)
                                    </span>
                                </label>

                                <label class="dong-phuong-thuc-tt-bitis">
                                    <input type="radio" name="PhuongThucTt" value="MOMO_QR"
                                           class="form-check-input mt-0"
                                           onchange="capNhatTrangThaiPhuongThucTt()" />
                                    <span class="d-inline-flex align-items-center gap-2 fw-medium" style="color: #111827; font-size: 0.92rem;">
                                        <span class="logo-momo-badge">momo</span>
                                        <span>Ví MoMo / Quét mã QR Ngân hàng (VietQR, VNPay, ZaloPay)</span>
                                    </span>
                                </label>
                            </div>
                        </div>

                        <!-- Khung Xác thực Captcha hình ảnh nhiễu trên 1 hàng ngang duy nhất ngay phía trên nút HOÀN TẤT ĐẶT HÀNG -->
                        <div class="khung-captcha-ngang-bitis mb-3">
                            <div class="d-flex align-items-center gap-2 flex-nowrap">
                                <img id="imgCaptchaThanhToan" src="" alt="Mã Captcha"
                                     style="width: 135px; height: 44px; border-radius: 6px; border: 1px solid #D1D5DB; background: #F9FAFB; flex-shrink: 0;" />
                                <button type="button" class="btn-doi-captcha-bitis" title="Đổi mã Captcha mới" onclick="taiMaCaptchaMoi(true)">
                                    ↻
                                </button>
                                <input type="text" id="txtMaCaptchaNhap" name="maCaptchaNhap"
                                       class="input-phang-bitis text-uppercase fw-bold"
                                       placeholder="Nhập mã xác thực *"
                                       maxlength="5" required autocomplete="off"
                                       style="letter-spacing: 2px; flex: 1; min-width: 0;"
                                       oninput="xuLyGoMaCaptchaTuDong(this)" />
                            </div>
                            <small id="lblTrangThaiCaptchaKho" class="d-block mt-1" style="font-size: 0.8rem; color: #6B7280;">
                                Nhập đủ 5 ký tự trong hình để hệ thống tự động xác thực &amp; kiểm tra tồn kho.
                            </small>
                        </div>

                        <!-- Hàng cuối Cột Trái: Liên kết ← Quay lại giỏ hàng bên trái và nút lớn HOÀN TẤT ĐẶT HÀNG bên phải -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 pt-2">
                            <a href="javascript:void(0)" onclick="moNganKeoGioHang()" class="lien-ket-quay-lai-gio-bitis">
                                ← Quay lại giỏ hàng
                            </a>
                            <button type="submit" id="btnHoanTatDatHang" class="btn-hoan-tat-dat-hang-bitis" disabled>
                                HOÀN TẤT ĐẶT HÀNG
                            </button>
                        </div>
                    </div>
                </div>

                <!-- =========================================================================
                     B. CỘT PHẢI (45% CHIỀU RỘNG - CHUẨN BITI'S)
                     ========================================================================= -->
                <div class="col-lg-5 cot-phai-bitis">
                    <div class="khung-cot-phai-bitis">
                        <!-- 1. Danh sách sản phẩm (Ảnh có chấm tròn đen số lượng góc phải trên, Tên ở giữa, Giá bên phải) -->
                        <div class="danh-sach-san-pham-bitis mb-3">
                            @foreach (var item in Model.DanhSachMon)
                            {
                                string tenMon = item.LoaiSanPham == 3
                                    ? (item.MaHopTcNavigation?.TenHopKhachDat ?? "Hộp Tự Phối")
                                    : item.LoaiSanPham == 2
                                        ? (item.MaCbNavigation?.TenCombo ?? "Combo Mẫu")
                                        : (item.MaBanhNavigation?.TenBanh ?? "Bánh Lẻ");

                                string anhSanPham = item.LoaiSanPham == 1
                                    ? LayAnhDaiDienMon(item.MaBanhNavigation)
                                    : item.LoaiSanPham == 2
                                        ? LayAnhDaiDienMon(item.MaCbNavigation)
                                        : LayAnhDaiDienMon(item.MaHopTcNavigation?.ChiTietHopTuChons?.FirstOrDefault()?.MaBanhNavigation);

                                <div class="dong-san-pham-bitis">
                                    <div class="d-flex align-items-center justify-content-between gap-3">
                                        <div class="khung-anh-san-pham-bitis">
                                            <img src="@anhSanPham" alt="@tenMon" class="anh-thu-nho-bitis" />
                                            <span class="cham-so-luong-bitis">@item.SoLuong</span>
                                        </div>
                                        <div class="ten-san-pham-bitis">
                                            <strong class="d-block" style="color: #111827; font-size: 0.9rem; line-height: 1.35;">@tenMon</strong>
                                        </div>
                                        <div class="gia-san-pham-bitis">
                                            @((item.SoLuong * item.DonGiaTamTinh).ToString("N0")) đ
                                        </div>
                                    </div>

                                    @if (item.LoaiSanPham == 3 && item.MaHopTcNavigation != null)
                                    {
                                        var danhSachO = item.MaHopTcNavigation.ChiTietHopTuChons
                                            .OrderBy(x => x.ViTriOtrongHop)
                                            .ToList();

                                        if (danhSachO.Any())
                                        {
                                            <div class="bang-thanh-phan-hop-2-cot mt-2">
                                                @foreach (var o in danhSachO)
                                                {
                                                    <div class="dong-thanh-phan-hop">
                                                        <span class="cot-o-banh">Ô @o.ViTriOtrongHop</span>
                                                        <span class="cot-ten-banh">@(o.MaBanhNavigation?.TenBanh ?? "Bánh Trung Thu")</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>

                        <!-- 2. Khung Mã khuyến mãi kiểu Biti's -->
                        <div class="khung-ma-khuyen-mai-bitis py-3 border-top border-bottom" style="border-color: #E5E7EB !important;">
                            <!-- Ô nhập mã bên trái + Nút đen [Sử dụng] bên phải -->
                            <div class="d-flex gap-2 mb-2">
                                <input type="text" id="txtMaGiamGiaCheckout" class="input-phang-bitis"
                                       value="@Model.CodeKmDangDung"
                                       placeholder="Mã khuyến mãi"
                                       style="flex: 1; min-width: 0;" />
                                <button type="button" class="btn-su-dung-ma-bitis"
                                        onclick="apDungMaGiamGiaTrangThanhToan()">
                                    Sử dụng
                                </button>
                            </div>

                            <small id="lblKetQuaVoucherCheckout" class="d-block mb-2 text-success fw-medium" style="font-size: 0.78rem;">
                                @if (!string.IsNullOrEmpty(Model.CodeKmDangDung))
                                {
                                    <span>✓ Đang áp dụng mã <strong>@Model.CodeKmDangDung</strong></span>
                                }
                            </small>

                            <!-- Thẻ Voucher trực quan kiểu Biti's -->
                            <div class="the-voucher-truc-quan-bitis">
                                <div class="icon-hop-qua-voucher">
                                    <i class="bi bi-gift-fill"></i>
                                </div>
                                <div class="noi-dung-the-voucher">
                                    <div class="fw-bold" style="color: #111827; font-size: 0.86rem;">Giảm 10% đơn Lễ Hội</div>
                                    <div class="d-flex align-items-center flex-wrap gap-1 mt-1">
                                        <span class="nhan-ma-vang-bitis">Mã: TRANGTRON2026</span>
                                        <span class="text-muted" style="font-size: 0.74rem;">HSD: 31/12/2027</span>
                                    </div>
                                </div>
                                <button type="button" class="btn-ap-dung-ma-vang-bitis"
                                        onclick="chonNhanhMaCheckout('TRANGTRON2026')">
                                    Áp dụng mã
                                </button>
                            </div>
                        </div>

                        <!-- 3. Bảng tính tiền tối giản (3 dòng chính: Tạm tính, Phí vận chuyển, Tổng cộng) -->
                        <div class="pt-3">
                            <div class="d-flex justify-content-between align-items-center py-1" style="font-size: 0.92rem;">
                                <span style="color: #4B5563;">Tạm tính</span>
                                <strong style="color: #111827;">@Model.TongTienHang.ToString("N0") đ</strong>
                            </div>

                            @if (Model.TienChietKhauB2B > 0)
                            {
                                <div class="d-flex justify-content-between align-items-center py-1" style="font-size: 0.88rem; color: #B45309;">
                                    <span>Chiết khấu sỉ B2B (@Model.PhanTramCkB2B%)</span>
                                    <strong>-@Model.TienChietKhauB2B.ToString("N0") đ</strong>
                                </div>
                            }

                            <div id="dongGiamGiaVoucherCheckout" class="d-flex justify-content-between align-items-center py-1 text-success"
                                 style="font-size: 0.88rem; display: @(Model.TienGiamVoucher > 0 ? "flex" : "none") !important;">
                                <span>Giảm giá khuyến mãi</span>
                                <strong id="lblTienGiamVoucherCheckout">-@Model.TienGiamVoucher.ToString("N0") đ</strong>
                            </div>

                            <div id="dongPhiLogoB2BCheckout" class="d-flex justify-content-between align-items-center py-1"
                                 style="font-size: 0.88rem; color: #4B5563; display: none !important;">
                                <span>Phí khuôn ép kim Logo B2B</span>
                                <strong id="lblPhiInLogoCheckout" style="color: #111827;">0 đ</strong>
                            </div>

                            <div class="d-flex justify-content-between align-items-center py-1" style="font-size: 0.92rem;">
                                <span style="color: #4B5563;">
                                    Phí vận chuyển
                                    <small style="color: #9CA3AF; font-size: 0.78rem;">(Miễn phí cho đơn từ 500k)</small>
                                    <span id="lblSoDiemGiaoCheckout" class="d-none">1</span>
                                </span>
                                <strong id="lblPhiShipCheckout" style="color: #111827;">
                                    @(duMienPhiShip ? "0 đ" : "30.000 đ")
                                </strong>
                            </div>

                            <hr class="my-3" style="border-color: #E5E7EB; opacity: 1;" />

                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="fw-bold" style="color: #111827; font-size: 1.05rem;">Tổng cộng</span>
                                <strong id="lblTongThanhToanCuoiCheckout" style="font-size: 1.35rem; font-weight: 800; color: #111827;">
                                    @tongThanhToanBanDau.ToString("N0") đ
                                </strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- =========================================================================
     MODAL 1: THÔNG BÁO HẾT HÀNG TRANG TRỌNG (LỚP 2 & LỚP 3 TIMING GATE)
     ========================================================================= -->
<div class="modal fade" id="modalThongBaoHetHang" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header text-white border-0 py-3" style="background: linear-gradient(135deg, #7A1215, #4A080A);">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-octagon-fill text-warning"></i>
                    Thông Báo Tình Trạng Tồn Kho Nguyệt Cát
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4" style="background: #FFFDF9;">
                <p id="noiDungModalHetHang" class="mb-3 fw-medium" style="color: #1F2937; line-height: 1.6; font-size: 0.96rem;">
                    Rất tiếc! Sản phẩm trong giỏ quà của Quý khách vừa hết hàng hoặc không còn đủ số lượng tại kho. Nguyệt Cát chân thành xin lỗi Quý khách vì sự bất tiện này. Vui lòng điều chỉnh lại số lượng hoặc chọn vị bánh khác.
                </p>
                <div class="p-3 rounded-3 small" style="background: #FEF2F2; color: #991B1B; border: 1px solid #FECACA;">
                    <i class="bi bi-shield-check me-1"></i>Hệ thống kiểm tra tồn kho thực tế theo lô sản xuất (FEFO) để đảm bảo mọi lễ hộp giao đến tay Quý khách đều mới nhất.
                </div>
            </div>
            <div class="modal-footer border-0 bg-light px-4 py-3 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">
                    Đóng lại
                </button>
                <button type="button" class="btn text-white rounded-pill px-4 fw-bold" style="background: #7A1215;"
                        onclick="bootstrap.Modal.getInstance(document.getElementById('modalThongBaoHetHang'))?.hide(); moNganKeoGioHang();">
                    <i class="bi bi-bag-check me-1"></i>Điều chỉnh Giỏ quà ngay
                </button>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL 2: CẢNH BÁO MẠNG GIÁN ĐOẠN (NETWORK ERROR / TIMEOUT)
     ========================================================================= -->
<div class="modal fade" id="modalCanhBaoMang" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header text-white border-0 py-3" style="background: #92400E;">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                    <i class="bi bi-wifi-off"></i>
                    Cảnh Báo Kết Nối Mạng
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <p id="noiDungModalCanhBaoMang" class="mb-0 fw-medium" style="color: #1F2937; line-height: 1.6;">
                    Kết nối Internet bị gián đoạn! Quý khách vui lòng kiểm tra lại đường truyền mạng và tiến hành xác thực thanh toán lại.
                </p>
            </div>
            <div class="modal-footer border-0 bg-light px-4 py-2">
                <button type="button" class="btn btn-dark rounded-pill px-4" data-bs-dismiss="modal">
                    Đã hiểu &amp; Thử lại
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const TONG_TIEN_HANG = @Model.TongTienHang;
        const TIEN_CK_B2B = @Model.TienChietKhauB2B;
        let TIEN_GIAM_VOUCHER = @Model.TienGiamVoucher;
        const MIEN_PHI_LOGO = @(Model.MienPhiInLogo ? "true" : "false");
        const PHI_LOGO_MAC_DINH = @Model.PhiInLogoMacDinh;
        const NGAY_HEN_MAC_DINH = "@ngayHenMacDinh";
        const tongSoLuongSanPham = @tongSoLuongSanPham;
        const MOC_FREESHIP_TIEU_CHUAN = 500000;
        let daXacThucCaptchaHopLe = false;
        let dangGuiDonHang = false;

        document.addEventListener("DOMContentLoaded", function () {
            capNhatGiaoDienNguoiKhacNhan();
            dongBoNguoiMuaSangNguoiNhan();
            dongBoDiaChiGiaoChinh();
            kiemTraTinhThanhVaCapNhatHoaToc();
            capNhatBangTinhThanhToan();
            taiMaCaptchaMoi(false);

            @if (!string.IsNullOrWhiteSpace(tenBanhHetHangBanDau))
            {
                <text>
                hienThiModalHetHang(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(tenBanhHetHangBanDau)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(thongBaoHetHangBanDau)));
                </text>
            }
        });

        function hienThiModalHetHang(tenBanh, thongBaoTuyChinh) {
            const noiDungEl = document.getElementById("noiDungModalHetHang");
            if (noiDungEl) {
                noiDungEl.textContent = thongBaoTuyChinh
                    || `Rất tiếc! Sản phẩm ${tenBanh || "Bánh Trung Thu"} trong giỏ quà của Quý khách vừa hết hàng hoặc không còn đủ số lượng tại kho. Nguyệt Cát chân thành xin lỗi Quý khách vì sự bất tiện này. Vui lòng điều chỉnh lại số lượng hoặc chọn vị bánh khác.`;
            }
            const modalEl = document.getElementById("modalThongBaoHetHang");
            if (modalEl && window.bootstrap) {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }
        }

        function hienThiModalCanhBaoMang() {
            const modalEl = document.getElementById("modalCanhBaoMang");
            if (modalEl && window.bootstrap) {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }
        }

        function datTrangThaiKhoaNutDatHang(moKhoa) {
            daXacThucCaptchaHopLe = Boolean(moKhoa);
            const btn = document.getElementById("btnHoanTatDatHang");
            if (btn) {
                btn.disabled = !daXacThucCaptchaHopLe;
            }
        }

        // Sinh mã Captcha hình ảnh nhiễu mới từ Server
        async function taiMaCaptchaMoi(xoaOInput = true) {
            datTrangThaiKhoaNutDatHang(false);
            const inputCaptcha = document.getElementById("txtMaCaptchaNhap");
            const lbl = document.getElementById("lblTrangThaiCaptchaKho");

            if (xoaOInput && inputCaptcha) {
                inputCaptcha.value = "";
                if (lbl) {
                    lbl.style.color = "#6B7280";
                    lbl.textContent = "Nhập đủ 5 ký tự trong hình để hệ thống tự động xác thực & kiểm tra tồn kho.";
                }
            }

            try {
                const res = await fetch("/ThanhToan/LayMaCaptchaMoi");
                const data = await res.json();
                if (data && data.thanhCong) {
                    const img = document.getElementById("imgCaptchaThanhToan");
                    if (img) img.src = data.anhCaptchaSvg;
                }
            } catch (e) {
                // Bỏ qua nếu đang tải trang
            }
        }

        // Mốc Timing Kiểm Tra Tồn Kho Tự Động: Ngay khi người dùng gõ đủ 5 ký tự vào ô Captcha (sự kiện input)
        async function xuLyGoMaCaptchaTuDong(inputEl) {
            if (!inputEl) return;
            const giaTri = inputEl.value.replace(/[^a-zA-Z0-9]/g, "").toUpperCase();
            if (inputEl.value !== giaTri) {
                inputEl.value = giaTri;
            }

            const lbl = document.getElementById("lblTrangThaiCaptchaKho");
            if (giaTri.length < 5) {
                datTrangThaiKhoaNutDatHang(false);
                if (lbl) {
                    lbl.style.color = "#6B7280";
                    lbl.textContent = "Nhập đủ 5 ký tự trong hình để hệ thống tự động xác thực & kiểm tra tồn kho.";
                }
                return;
            }

            if (giaTri.length === 5) {
                if (lbl) {
                    lbl.style.color = "#B45309";
                    lbl.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Đang xác thực mã & kiểm tra tồn kho thực tế...`;
                }
                await goiApiXacThucCaptchaVaKho();
            }
        }

        async function goiApiXacThucCaptchaVaKho() {
            const inputEl = document.getElementById("txtMaCaptchaNhap");
            const maCaptcha = inputEl?.value.trim() || "";
            const lbl = document.getElementById("lblTrangThaiCaptchaKho");
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 8000);

            try {
                const res = await fetch("/ThanhToan/XacThucCaptchaVaKiemTraKho", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        maCaptcha: maCaptcha,
                        maCaptchaNhap: maCaptcha
                    }),
                    signal: controller.signal
                });
                clearTimeout(timeoutId);

                if (!res.ok) {
                    throw new Error("Network response was not ok");
                }

                const data = await res.json();
                if (data.thanhCong) {
                    datTrangThaiKhoaNutDatHang(true);
                    if (lbl) {
                        lbl.style.color = "#059669";
                        lbl.className = "d-block mt-1 fw-semibold";
                        lbl.textContent = "✓ Đã xác thực & kiểm tra còn hàng";
                    }
                    return true;
                }

                datTrangThaiKhoaNutDatHang(false);

                if (data.loaiLoi === "CAPTCHA") {
                    if (lbl) {
                        lbl.style.color = "#DC2626";
                        lbl.className = "d-block mt-1 fw-medium";
                        lbl.textContent = data.thongBao || "Mã xác thực Captcha không chính xác. Vui lòng nhập lại mã hiển thị trong hình!";
                    }
                    if (data.anhCaptchaSvg) {
                        const img = document.getElementById("imgCaptchaThanhToan");
                        if (img) img.src = data.anhCaptchaSvg;
                        if (inputEl) {
                            inputEl.value = "";
                            inputEl.focus();
                        }
                    } else {
                        await taiMaCaptchaMoi(false);
                        if (inputEl) {
                            inputEl.value = "";
                            inputEl.focus();
                        }
                    }
                    return false;
                }

                // Mã Captcha đúng nhưng sản phẩm vừa hết hàng trong CSDL
                if (lbl) {
                    lbl.style.color = "#DC2626";
                    lbl.className = "d-block mt-1 fw-medium";
                    lbl.textContent = `Sản phẩm ${data.tenBanh || "trong giỏ"} vừa hết hàng hoặc không đủ tồn kho!`;
                }
                hienThiModalHetHang(data.tenBanh, data.thongBao);
                return false;
            } catch (err) {
                clearTimeout(timeoutId);
                datTrangThaiKhoaNutDatHang(false);
                if (lbl) {
                    lbl.style.color = "#DC2626";
                    lbl.className = "d-block mt-1 fw-medium";
                    lbl.textContent = "Kết nối Internet bị gián đoạn!";
                }
                hienThiModalCanhBaoMang();
                return false;
            }
        }

        function laTinhHoTroHoaToc(tinhThanh) {
            if (!tinhThanh) return false;
            const t = tinhThanh.toLowerCase();
            return t.includes("hồ chí minh") || t.includes("an giang") || t.includes("long xuyên");
        }

        function kiemTraTinhThanhVaCapNhatHoaToc() {
            const tinhThanh = document.getElementById("ddlTinhThanh")?.value || "TP. Hồ Chí Minh";
            const dot0Tinh = document.getElementById("dot0_TinhThanhPho");
            if (dot0Tinh) dot0Tinh.value = tinhThanh;

            const radHoaToc = document.getElementById("radGiaoHoaToc");
            const radTieuChuan = document.getElementById("radGiaoTieuChuan");
            const lblDongHoaToc = document.getElementById("lblDongGiaoHoaToc");
            const thongBaoHoaToc = document.getElementById("thongBaoGioiHanHoaToc");

            const hoTro = laTinhHoTroHoaToc(tinhThanh);

            if (!hoTro) {
                if (radHoaToc) {
                    if (radHoaToc.checked && radTieuChuan) {
                        radTieuChuan.checked = true;
                    }
                    radHoaToc.disabled = true;
                }
                if (lblDongHoaToc) {
                    lblDongHoaToc.style.opacity = "0.55";
                    lblDongHoaToc.style.cursor = "not-allowed";
                }
                if (thongBaoHoaToc) {
                    thongBaoHoaToc.style.display = "block";
                }
            } else {
                if (radHoaToc) radHoaToc.disabled = false;
                if (lblDongHoaToc) {
                    lblDongHoaToc.style.opacity = "1";
                    lblDongHoaToc.style.cursor = "pointer";
                }
                if (thongBaoHoaToc) {
                    thongBaoHoaToc.style.display = "none";
                }
            }

            capNhatBangTinhThanhToan();
        }

        function chuyenDoiHinhThucNhanHang() {
            const laNhanTaiCuaHang = document.getElementById("radNhanTaiCuaHang")?.checked === true;
            const khungDiaChiGiao = document.getElementById("khungDiaChiGiaoTanNoi");
            const khungCuaHang = document.getElementById("khungNhanTaiCuaHang");

            document.getElementById("lblChonGiaoTanNoi")?.classList.toggle("dang-chon", !laNhanTaiCuaHang);
            document.getElementById("lblChonNhanTaiCuaHang")?.classList.toggle("dang-chon", laNhanTaiCuaHang);

            if (khungDiaChiGiao) khungDiaChiGiao.style.display = laNhanTaiCuaHang ? "none" : "block";
            if (khungCuaHang) khungCuaHang.style.display = laNhanTaiCuaHang ? "block" : "none";

            capNhatGiaoDienNguoiKhacNhan();
            dongBoDiaChiGiaoChinh();
            capNhatBangTinhThanhToan();
        }

        function capNhatGiaoDienNguoiKhacNhan() {
            const laNhanTaiCuaHang = document.getElementById("radNhanTaiCuaHang")?.checked === true;
            const lblChk = document.getElementById("lblChkGoiNguoiKhacNhan");
            const container = document.getElementById("danhSachCacDotGiaoContainer");
            const btnThem = document.getElementById("btnThemDiemNhanQua");

            if (laNhanTaiCuaHang) {
                if (lblChk) lblChk.textContent = "Gọi người khác nhận hàng tại cửa hàng";
                if (container) {
                    container.innerHTML = "";
                    container.style.display = "none";
                }
                if (btnThem) btnThem.style.display = "none";
            } else if (tongSoLuongSanPham <= 1) {
                if (lblChk) lblChk.textContent = "Gọi người khác nhận hàng";
                if (container) {
                    container.innerHTML = "";
                    container.style.display = "none";
                }
                if (btnThem) btnThem.style.display = "none";
            } else {
                if (lblChk) lblChk.textContent = `Gọi người khác nhận hàng (Chia điểm nhận tối đa ${tongSoLuongSanPham} địa chỉ)`;
                if (container) {
                    container.style.display = "block";
                }
                const soDiemHienTai = 1 + (container ? container.querySelectorAll(".item-dot-giao").length : 0);
                if (btnThem) {
                    btnThem.style.display = soDiemHienTai >= tongSoLuongSanPham ? "none" : "inline-block";
                }
            }
        }

        function dongBoDiaChiGiaoChinh() {
            const laNhanTaiCuaHang = document.getElementById("radNhanTaiCuaHang")?.checked === true;
            const inputDiaChiServer = document.getElementById("dot0_DiaChi");
            if (!inputDiaChiServer) return;

            if (laNhanTaiCuaHang) {
                const radCuaHang = document.querySelector('input[name="CuaHangNhan"]:checked');
                inputDiaChiServer.value = radCuaHang
                    ? radCuaHang.value
                    : "[Nhận tại cửa hàng] Nguyệt Cát – Quận 1, Nguyễn Huệ (128 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh - 0909 123 456)";
            } else {
                const soNha = document.getElementById("txtDiaChiSoNha")?.value.trim() || "";
                const phuongQuan = document.getElementById("txtPhuongXaQuanHuyen")?.value.trim() || "";
                const tinhThanh = document.getElementById("ddlTinhThanh")?.value.trim() || "";

                const cacPhan = [soNha, phuongQuan, tinhThanh].filter(p => p.length > 0);
                inputDiaChiServer.value = soNha.length > 0 ? cacPhan.join(", ") : "";
            }
        }

        function chonTuDropdownSoDiaChi(selectEl) {
            const opt = selectEl.options[selectEl.selectedIndex];
            if (!opt || !opt.value) return;

            const soNhaEl = document.getElementById("txtDiaChiSoNha");
            const phuongQuanEl = document.getElementById("txtPhuongXaQuanHuyen");
            const tinhThanhEl = document.getElementById("ddlTinhThanh");

            if (soNhaEl) soNhaEl.value = opt.value;
            if (phuongQuanEl && opt.dataset.phuongquan) phuongQuanEl.value = opt.dataset.phuongquan;
            if (tinhThanhEl && opt.dataset.tinhthanh) {
                for (let i = 0; i < tinhThanhEl.options.length; i++) {
                    if (tinhThanhEl.options[i].value.includes(opt.dataset.tinhthanh) || opt.dataset.tinhthanh.includes(tinhThanhEl.options[i].value)) {
                        tinhThanhEl.selectedIndex = i;
                        break;
                    }
                }
            }

            if (opt.dataset.ten && document.getElementById("dot0_TenNguoiNhan")) {
                document.getElementById("dot0_TenNguoiNhan").value = opt.dataset.ten;
            }
            if (opt.dataset.sdt && document.getElementById("dot0_SdtNguoiNhan")) {
                document.getElementById("dot0_SdtNguoiNhan").value = opt.dataset.sdt;
            }

            dongBoDiaChiGiaoChinh();
            kiemTraTinhThanhVaCapNhatHoaToc();
            if (typeof hienThiThongBaoGioHang === "function") {
                hienThiThongBaoGioHang("Đã điền nhanh địa chỉ giao hàng đã lưu!", true);
            }
        }

        function batTatKhungTuyChonMoRong(idCheckbox, idKhung) {
            const chk = document.getElementById(idCheckbox);
            const khung = document.getElementById(idKhung);
            if (chk && khung) {
                khung.style.display = chk.checked ? "block" : "none";
            }
        }

        function xuLyBatTatThiepQrChinh(chk) {
            const khung = document.getElementById("khungChiTietThiepQr");
            const hidCoThiep = document.getElementById("hidCoThiep3D");
            const txtKinhGui = document.getElementById("txtKinhGuiTrenThiep_0");
            const txtNguoiGui = document.getElementById("txtNguoiGuiTrenThiep_0");
            const txtLoiChuc = document.getElementById("txtLoiChucThiep_0");

            const batThiep = Boolean(chk && chk.checked);
            if (khung) khung.style.display = batThiep ? "block" : "none";
            if (hidCoThiep) hidCoThiep.value = batThiep ? "true" : "false";

            if (txtKinhGui) txtKinhGui.required = batThiep;
            if (txtNguoiGui) {
                txtNguoiGui.required = batThiep;
                if (batThiep && !txtNguoiGui.value.trim()) {
                    txtNguoiGui.value = document.getElementById("txtHoTenNguoiMua")?.value.trim() || "";
                }
            }
            if (txtLoiChuc) txtLoiChuc.required = batThiep;
            kiemTraTrungTenThiep3D();
        }

        function kiemTraTrungTenThiep3D() {
            const chk = document.getElementById("chkThiepQr_0");
            const canhBao = document.getElementById("canhBaoTrungTenThiep3D");
            if (!chk || !chk.checked || !canhBao) {
                if (canhBao) canhBao.style.display = "none";
                return;
            }
            const kinhGui = (document.getElementById("txtKinhGuiTrenThiep_0")?.value || "").trim().toLowerCase();
            const nguoiGui = (document.getElementById("txtNguoiGuiTrenThiep_0")?.value || "").trim().toLowerCase();
            canhBao.style.display = (kinhGui.length > 0 && kinhGui === nguoiGui) ? "block" : "none";
        }

        function xuLyBatTatNguoiKhacNhan() {
            batTatKhungTuyChonMoRong("chkGoiNguoiKhacNhan", "khungNguoiKhacNhanHang");
            capNhatGiaoDienNguoiKhacNhan();
            dongBoNguoiMuaSangNguoiNhan();
        }

        function dongBoNguoiMuaSangNguoiNhan() {
            const chkNguoiKhac = document.getElementById("chkGoiNguoiKhacNhan");
            const hoTenMua = document.getElementById("txtHoTenNguoiMua")?.value.trim() || "";
            const sdtMua = document.getElementById("txtSdtNguoiMua")?.value.trim() || "";

            const elTenNhan0 = document.getElementById("dot0_TenNguoiNhan");
            const elSdtNhan0 = document.getElementById("dot0_SdtNguoiNhan");
            const elDiemTen0 = document.getElementById("diem0_TenNguoiNhan");
            const elDiemSdt0 = document.getElementById("diem0_SdtNguoiNhan");

            if (!chkNguoiKhac || !chkNguoiKhac.checked) {
                if (elTenNhan0) elTenNhan0.value = hoTenMua;
                if (elSdtNhan0) elSdtNhan0.value = sdtMua;
            }

            if (elDiemTen0) elDiemTen0.value = elTenNhan0?.value || hoTenMua;
            if (elDiemSdt0) elDiemSdt0.value = elSdtNhan0?.value || sdtMua;

            const txtNguoiGuiThiep = document.getElementById("txtNguoiGuiTrenThiep_0");
            if (txtNguoiGuiThiep && !txtNguoiGuiThiep.dataset.daSuaTay) {
                txtNguoiGuiThiep.value = hoTenMua;
            }
        }

        function batTatKhungThiepQr(chk) {
            const khungThiep = chk.closest(".khung-thiep-qr-phu");
            if (!khungThiep) return;
            const vungLoiChuc = khungThiep.querySelector(".noi-dung-loi-chuc-qr");
            if (vungLoiChuc) {
                vungLoiChuc.style.display = chk.checked ? "block" : "none";
            }
        }

        function capNhatTrangThaiPhuongThucTt() {
            document.querySelectorAll("#nhomPhuongThucThanhToan .dong-phuong-thuc-tt-bitis").forEach(the => {
                const radio = the.querySelector('input[type="radio"]');
                the.classList.toggle("dang-chon", Boolean(radio && radio.checked));
            });
        }

        function themDotGiaoHangMoi() {
            const laNhanTaiCuaHang = document.getElementById("radNhanTaiCuaHang")?.checked === true;
            if (laNhanTaiCuaHang || tongSoLuongSanPham <= 1) {
                capNhatGiaoDienNguoiKhacNhan();
                return;
            }

            const container = document.getElementById("danhSachCacDotGiaoContainer");
            const soDiemPhuHienTai = container.querySelectorAll(".item-dot-giao").length;
            const tongSoDiemHienTai = 1 + soDiemPhuHienTai;
            if (tongSoDiemHienTai >= tongSoLuongSanPham) {
                capNhatGiaoDienNguoiKhacNhan();
                return;
            }

            const idx = soDiemPhuHienTai + 1;
            const tenNguoiMua = document.getElementById("txtHoTenNguoiMua")?.value.trim() || "";

            const div = document.createElement("div");
            div.className = "item-dot-giao pt-2 mt-2 border-top";
            div.dataset.index = idx;
            div.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong class="small" style="color: #111827;">
                        <span class="tieu-de-dot-giao">Điểm nhận quà #${idx + 1}</span>
                    </strong>
                    <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="xoaDotGiaoHang(this)">
                        Xóa
                    </button>
                </div>

                <div class="row g-2">
                    <div class="col-md-6">
                        <input type="text" name="DanhSachDotGiao[${idx}].TenNguoiNhan" required
                               class="input-phang-bitis" placeholder="Họ và tên người nhận *" />
                    </div>
                    <div class="col-md-6">
                        <input type="text" name="DanhSachDotGiao[${idx}].SdtNguoiNhan" required
                               class="input-phang-bitis" placeholder="Số điện thoại người nhận *" />
                    </div>
                    <div class="col-12">
                        <input type="text" name="DanhSachDotGiao[${idx}].DiaChiGiaoChiTiet" required
                               class="input-phang-bitis" placeholder="Địa chỉ nhận quà chi tiết *" />
                    </div>
                    <input type="hidden" name="DanhSachDotGiao[${idx}].NgayHenGiao" value="${NGAY_HEN_MAC_DINH}" />
                    <input type="hidden" name="DanhSachDotGiao[${idx}].KhungGioGiao" value="Sáng (08:00 - 11:30)" />
                </div>

                <div class="khung-thiep-qr-phu mt-2">
                    <div class="form-check m-0">
                        <input class="form-check-input" type="checkbox" name="DanhSachDotGiao[${idx}].CoKemThiepQr" value="true"
                               onchange="batTatKhungThiepQr(this)">
                        <label class="form-check-label small" style="color: #1F2937;">
                            Đính kèm Thiệp Chúc Tết Đoàn Viên QR 3D riêng (Miễn phí)
                        </label>
                    </div>
                    <div class="noi-dung-loi-chuc-qr mt-2" style="display: none;">
                        <div class="row g-2 mb-2">
                            <div class="col-md-6">
                                <input type="text" name="DanhSachDotGiao[${idx}].TenNguoiNhanThiep"
                                       class="input-phang-bitis" placeholder="Kính gửi *" />
                            </div>
                            <div class="col-md-6">
                                <input type="text" name="DanhSachDotGiao[${idx}].TenNguoiGuiThiep" value="${tenNguoiMua}"
                                       class="input-phang-bitis" placeholder="Người gửi *" />
                            </div>
                        </div>
                        <textarea name="DanhSachDotGiao[${idx}].LoiChucThiep" rows="2" class="form-control form-control-sm"
                                  placeholder="Lời chúc riêng cho điểm nhận này...">Kính chúc Quý Đối tác &amp; Gia đình mùa Tết Trung Thu Đoàn Viên, Thịnh Vượng!</textarea>
                    </div>
                </div>
            `;

            container.appendChild(div);
            danhSoLaiCacDotGiao();
            capNhatGiaoDienNguoiKhacNhan();
            capNhatBangTinhThanhToan();
