                                       class="form-control form-control-sm" placeholder="Kính gửi (Tên in trên thiệp) *" />
                            </div>
                            <div class="col-md-6">
                                <input type="text" name="DanhSachDotGiao[${idx}].TenNguoiGuiThiep" value="${tenNguoiMua}"
