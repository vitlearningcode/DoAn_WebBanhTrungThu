@model WebBanhTrungThu.ViewModels.DonHangThanhCongViewModel
@{
    ViewData["Title"] = $"Đặt Hàng Thành Công #{Model.DonHang.MaTraCuuDh}";
    bool coThiep3D = Model.DonHang.ThiepChucMung3Ds.Any() && Model.DanhSachDotGiaoQr.Any();
    bool laDonQrMoMo = Model.DonHang.PhuongThucTt == "MOMO_QR"
                    || Model.DonHang.PhuongThucTt == "VIETQR"
                    || Model.DonHang.PhuongThucTt == "MOMO";
    bool coCotPhai = laDonQrMoMo || coThiep3D;
}

<section class="trang-thanh-toan-sang">
    <div class="container" style="max-width: @(coCotPhai ? "1020px" : "680px"); margin: 28px auto;">
        <!-- Thông báo tự động khi hết hạn 15 phút -->
        <div id="khungThongBaoHetHan15Phut" class="alert alert-danger border-danger shadow-sm rounded-3 mb-4 p-3"
             style="display: @(Model.DonHang.TrangThaiTt == "HET_HAN_15P" ? "block" : "none");">
            <div class="d-flex align-items-center gap-2 fw-bold">
                <i class="bi bi-clock-history fs-5"></i>
                <span>Đơn hàng đã hết hạn thanh toán 15 phút. Hệ thống đã hoàn trả sản phẩm về kho.</span>
            </div>
        </div>

        <div class="row g-4 align-items-start @(coCotPhai ? "" : "justify-content-center")">
            <!-- =========================================================================
                 CỘT TRÁI (THÔNG TIN HÓA ĐƠN ĐẶT HÀNG - CĂN GIỮA NẾU KHÔNG CÓ CỘT PHẢI)
                 ========================================================================= -->
            <div class="@(coCotPhai ? "col-lg-7" : "col-12")">
                <div class="card-hoang-gia p-4">
                    <!-- Tiêu đề gọn + Lời cảm ơn ngắn gọn 1 dòng -->
                    <div class="mb-3">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-1">
                            <h1 class="font-co-phong fs-2 fw-bold chu-do-son-mai mb-0">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>Đặt Hàng Thành Công!
                            </h1>
                            <div class="d-flex align-items-center gap-2">
                                <span id="badgeTrangThaiThanhToanDon" class="badge rounded-pill px-3 py-1"
                                      style="background: @(Model.DonHang.TrangThaiTt == "DA_THANH_TOAN" ? "#ECFDF5" : (Model.DonHang.TrangThaiTt == "HET_HAN_15P" ? "#FEF2F2" : "#FFFBEB"));
                                             color: @(Model.DonHang.TrangThaiTt == "DA_THANH_TOAN" ? "#065F46" : (Model.DonHang.TrangThaiTt == "HET_HAN_15P" ? "#991B1B" : "#92400E"));
                                             border: 1px solid @(Model.DonHang.TrangThaiTt == "DA_THANH_TOAN" ? "#10B981" : (Model.DonHang.TrangThaiTt == "HET_HAN_15P" ? "#EF4444" : "#F59E0B"));">
                                    @Model.DonHang.TenTrangThaiThanhToanHienThi
                                </span>
                                @if (Model.DiemCongThem > 0)
                                {
                                    <span class="badge rounded-pill px-3 py-1" style="background: #F4FBF5; color: #198754; border: 1px solid #81C784;">
                                        +@Model.DiemCongThem điểm thưởng
                                    </span>
                                }
                            </div>
                        </div>
                        <p class="chu-nau-phu small mb-0">
                            Cảm ơn Quý khách <strong>@Model.DonHang.HoTenNguoiMua</strong> đã tin chọn lễ hộp Trung Thu Nguyệt Cát.
                        </p>
                    </div>

                    <!-- 3 thông tin chính trên 1 hàng ngang nhỏ gọn -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-2 mb-3 rounded-3 small"
                         style="background: #FDFBF7; border: 1px solid #EADBC8;">
                        <div>
                            <span class="chu-nau-phu">Mã đơn:</span>
                            <strong class="chu-do-son-mai">@Model.DonHang.MaTraCuuDh</strong>
                        </div>
                        <span class="text-muted d-none d-sm-inline">|</span>
                        <div>
                            <span class="chu-nau-phu">SĐT:</span>
                            <strong class="chu-nau-tram">@Model.DonHang.SdtnguoiMua</strong>
                        </div>
                        <span class="text-muted d-none d-sm-inline">|</span>
                        <div>
                            <span class="chu-nau-phu">Hình thức:</span>
                            <strong class="chu-nau-tram">@(laDonQrMoMo ? "Ví MoMo / Chuyển khoản QR" : "Thanh toán khi nhận (COD)")</strong>
                        </div>
                    </div>

                    <!-- Bảng danh sách sản phẩm đã đặt & tổng kết thanh toán -->
                    <div class="table-responsive mb-3">
                        <table class="table table-trung-thu align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Sản Phẩm</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-end">Thành Tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ct in Model.DonHang.ChiTietDonHangs)
                                {
                                    <tr>
                                        <td>
                                            <strong class="chu-do-son-mai d-block" style="font-size: 0.92rem;">@ct.TenSanPhamLuuCung</strong>
                                            @if (!string.IsNullOrWhiteSpace(ct.CauHinhHopJson))
                                            {
                                                try
                                                {
                                                    var mangO = Newtonsoft.Json.Linq.JArray.Parse(ct.CauHinhHopJson);
                                                    if (mangO.Count > 0)
                                                    {
                                                        <div class="bang-thanh-phan-hop-2-cot mt-1">
                                                            @foreach (var o in mangO)
                                                            {
                                                                int viTri = o.Value<int?>("ViTriOTrongHop") ?? 1;
                                                                string tenBanh = o.Value<string>("TenBanh") ?? "Bánh Trung Thu";
                                                                <div class="dong-thanh-phan-hop" style="display: flex; align-items: baseline; padding: 2px 6px; border-bottom: 1px dashed #EAE0D5; font-size: 0.76rem;">
                                                                    <span class="cot-o-banh" style="font-weight: 700; color: #7A1215; flex: 0 0 48px; width: 48px;">Ô @viTri</span>
                                                                    <span class="cot-ten-banh" style="flex: 1; color: #2C1810; font-weight: 500;">@tenBanh</span>
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                }
                                                catch
                                                {
                                                    <small class="chu-nau-phu d-block">Hộp quà tự chọn Nguyệt Cát</small>
                                                }
                                            }
                                        </td>
                                        <td class="text-center">
                                            <span class="badge rounded-pill" style="background: #F6EFE2; color: #7A1215; border: 1px solid #E6D5B8;">
                                                x @ct.SoLuong
                                            </span>
                                        </td>
                                        <td class="text-end fw-bold chu-do-son-mai text-nowrap">@ct.ThanhTien.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot style="border-top: 2px solid #E6D5B8;">
                                <tr>
                                    <td colspan="2" class="text-end chu-nau-phu small">Tạm tính:</td>
                                    <td class="text-end fw-semibold chu-nau-tram text-nowrap">@Model.DonHang.TongTienHang.ToString("N0") đ</td>
                                </tr>
                                @if (Model.DonHang.TienChietKhauB2b > 0)
                                {
                                    <tr>
                                        <td colspan="2" class="text-end small" style="color: #9A5B13;">Chiết khấu B2B (@Model.DonHang.PhanTramCkB2b%):</td>
                                        <td class="text-end fw-semibold text-nowrap" style="color: #9A5B13;">-@Model.DonHang.TienChietKhauB2b.ToString("N0") đ</td>
                                    </tr>
                                }
                                @if (Model.DonHang.TienGiamVoucher > 0)
                                {
                                    <tr>
                                        <td colspan="2" class="text-end text-success small">Giảm giá Voucher:</td>
                                        <td class="text-end fw-semibold text-success text-nowrap">-@Model.DonHang.TienGiamVoucher.ToString("N0") đ</td>
                                    </tr>
                                }
                                @if (Model.DonHang.PhiInLogo > 0)
                                {
                                    <tr>
                                        <td colspan="2" class="text-end chu-nau-phu small">Phí khuôn ép kim Logo B2B:</td>
                                        <td class="text-end fw-semibold chu-nau-tram text-nowrap">+@Model.DonHang.PhiInLogo.ToString("N0") đ</td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="2" class="text-end chu-nau-phu small">Phí giao hàng:</td>
                                    <td class="text-end fw-semibold text-nowrap @(Model.DonHang.TongPhiVanChuyen <= 0 ? "text-success" : "chu-nau-tram")">
                                        @(Model.DonHang.TongPhiVanChuyen <= 0 ? "0 đ (Miễn phí)" : $"+{Model.DonHang.TongPhiVanChuyen:N0} đ")
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="text-end fw-bold" style="color: #2C1810; font-size: 1.02rem;">Tổng thanh toán:</td>
                                    <td class="text-end fw-bold text-nowrap" style="color: #7A1215; font-size: 1.3rem;">@Model.DonHang.TongThanhToan.ToString("N0") đ</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <!-- Thông tin địa chỉ nhận hàng -->
                    @if (Model.DonHang.DotGiaoHangDaDiems.Any())
                    {
                        <div class="p-3 rounded-3 mb-3 small" style="background: #FFFDF9; border: 1px solid #EADBC8;">
                            <strong class="chu-do-son-mai d-block mb-1">
                                <i class="bi bi-geo-alt-fill me-1"></i>Địa điểm nhận quà (@Model.DonHang.DotGiaoHangDaDiems.Count điểm):
                            </strong>
                            @foreach (var dot in Model.DonHang.DotGiaoHangDaDiems)
                            {
                                <div class="text-muted mt-1">
                                    • <strong>@dot.TenNguoiNhan</strong> (@dot.SdtnguoiNhan) — @dot.DiaChiGiaoChiTiet
                                </div>
                            }
                        </div>
                    }

                    <!-- Nút Tiếp tục mua sắm nằm gọn ở đáy cột trái -->
                    <div class="pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-color: #EADBC8 !important;">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-do-son-mai rounded-pill px-4 py-2">
                            ← Tiếp tục mua sắm
                        </a>
                        @if (Model.DonHang.MaNd.HasValue)
                        {
                            <a asp-controller="TaiKhoan" asp-action="HoSo" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-2">
                                Xem Lịch sử đơn hàng
                            </a>
                        }
                    </div>
                </div>
            </div>

            <!-- =========================================================================
                 CỘT PHẢI (5/12 - KHUNG THANH TOÁN QR MOMO 15 PHÚT & MÃ QR THIỆP 3D NẾU CÓ)
                 ========================================================================= -->
            @if (coCotPhai)
            {
                <div class="col-lg-5">
                    @if (laDonQrMoMo)
                    {
                        <!-- KHUNG 1A: HIỂN THỊ KHI ĐƠN ĐÃ THANH TOÁN THÀNH CÔNG -->
                        <div id="khungDaThanhToanQrThanhCong" class="p-4 mb-3 rounded-4 shadow-sm text-center"
                             style="display: @(Model.DonHang.TrangThaiTt == "DA_THANH_TOAN" ? "block" : "none"); background: #ECFDF5; border: 2px solid #10B981;">
                            <div class="fs-1 text-success mb-2"><i class="bi bi-patch-check-fill"></i></div>
                            <h5 class="fw-bold mb-1" style="color: #065F46;">✓ Thanh toán thành công!</h5>
                            <p class="small mb-0" style="color: #047857;">
                                Đơn hàng <strong>#@Model.DonHang.MaTraCuuDh</strong> của Quý khách đã được hệ thống tự động xác nhận và ghi sổ quỹ. Lễ hộp đang được chuẩn bị!
                            </p>
                        </div>

                        <!-- KHUNG 1B: KHUNG CHỜ THANH TOÁN QR MOMO & ĐỒNG HỒ ĐẾM NGƯỢC 15:00 -->
                        @if (Model.DangChoThanhToanQr)
                        {
                            <div id="khungChoThanhToanQrMoMo" class="p-4 mb-3"
                                 style="background: #FFFDF9; border: 2px solid #D4AF37; border-radius: 16px; box-shadow: 0 8px 24px rgba(122, 18, 21, 0.08);">
                                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3" style="border-color: #EADBC8 !important;">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="logo-momo-badge">momo</span>
                                        <strong style="color: #7A1215; font-size: 1rem;">Thanh Toán QR MoMo</strong>
                                    </div>
                                    <div class="badge rounded-pill px-3 py-1 d-inline-flex align-items-center gap-1"
                                         style="background: #FEF2F2; color: #DC2626; border: 1px solid #FCA5A5; font-size: 0.85rem;">
                                        <i class="bi bi-stopwatch-fill"></i>
                                        <span id="dong-ho-dem-nguoc-qr" style="font-variant-numeric: tabular-nums; font-weight: 800;">15:00</span>
                                    </div>
                                </div>

                                <!-- Ảnh Mã QR MoMo / VietQR sắc nét -->
                                <div class="text-center mb-3">
                                    <div class="bg-white d-inline-block p-2 rounded-3 shadow-sm" style="border: 1.5px solid #D4AF37;">
                                        <img src="@Model.AnhQrThanhToanBase64" width="185" height="185" alt="Mã QR Thanh Toán MoMo @Model.DonHang.MaTraCuuDh" />
                                    </div>
                                    <small class="d-block text-muted mt-1" style="font-size: 0.76rem;">
                                        Quét mã bằng App MoMo hoặc ứng dụng Ngân hàng bất kỳ
                                    </small>
                                </div>

                                <!-- Thông tin chuyển khoản kèm nút [Sao chép] -->
                                <div class="p-3 rounded-3 small mb-3" style="background: #FDFBF7; border: 1px solid #E6D5B8;">
                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom" style="border-color: #EFE6D5 !important;">
                                        <span class="text-muted">Số điện thoại / TK MoMo:</span>
                                        <div class="d-flex align-items-center gap-2">
                                            <strong style="color: #7A1215; font-size: 0.95rem;">@Model.CauHinhQr.SoDienThoaiHienThi</strong>
                                            <button type="button" class="btn btn-sm py-0 px-2 rounded-pill"
                                                    style="background: #FEF3C7; color: #92400E; border: 1px solid #F59E0B; font-size: 0.7rem; font-weight: 600;"
                                                    onclick="saoChepThongTinQr('@Model.CauHinhQr.SoTaiKhoanMoMo', this)">
                                                Sao chép
                                            </button>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom" style="border-color: #EFE6D5 !important;">
                                        <span class="text-muted">Chủ tài khoản:</span>
                                        <strong style="color: #111827;">@Model.CauHinhQr.TenChuTaiKhoan</strong>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center py-1 border-bottom" style="border-color: #EFE6D5 !important;">
                                        <span class="text-muted">Số tiền cần chuyển:</span>
                                        <strong style="color: #7A1215; font-size: 1rem;">@Model.DonHang.TongThanhToan.ToString("N0") đ</strong>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center pt-2">
                                        <span class="text-muted">Nội dung CK (Bắt buộc):</span>
                                        <div class="d-flex align-items-center gap-2">
                                            <strong class="px-2 py-0 rounded" style="background: #FEF2F2; color: #991B1B; border: 1px dashed #F87171;">
                                                @Model.NoiDungChuyenKhoan
                                            </strong>
                                            <button type="button" class="btn btn-sm py-0 px-2 rounded-pill"
                                                    style="background: #FEF3C7; color: #92400E; border: 1px solid #F59E0B; font-size: 0.7rem; font-weight: 600;"
                                                    onclick="saoChepThongTinQr('@Model.NoiDungChuyenKhoan', this)">
                                                Sao chép
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center justify-content-center gap-2 small text-muted mb-3" style="font-size: 0.76rem;">
                                    <span class="spinner-grow spinner-grow-sm text-warning" role="status"></span>
                                    <span>Đang chờ xác nhận tự động từ Webhook MoMo (kiểm tra mỗi 3 giây)...</span>
                                </div>

                                <!-- Nút mở Cổng thanh toán MoMo độc lập & Test nhận Webhook MoMo thực tế -->
                                <div class="pt-2 border-top text-center d-flex flex-column gap-2" style="border-color: #EADBC8 !important;">
                                    <a href="/ThanhToan/CongThanhToanMoMo/@Model.DonHang.MaTraCuuDh" class="btn btn-sm w-100 rounded-pill fw-bold py-2 text-white"
                                       style="background: #D82D8B; font-size: 0.82rem;">
                                        Mở Cổng thanh toán MoMo toàn màn hình
                                    </a>
                                    <button type="button" id="btnTestWebhookMoMo" class="btn btn-sm w-100 rounded-pill fw-bold py-2"
                                            style="background: #111827; color: #FBBF24; border: 1px solid #D4AF37; font-size: 0.8rem;"
                                            onclick="testNhanWebhookMoMoThucTe()">
                                        ⚡ Giả lập Khách đã quét QR thành công (Test Webhook MoMo)
                                    </button>
                                </div>
                            </div>
                        }
                    }

                    <!-- KHUNG 2: THẺ MÃ QR THIỆP CHÚC MỪNG 3D (CHỈ HIỂN THỊ KHI ĐƠN HÀNG CÓ THIỆP 3D) -->
                    @if (coThiep3D)
                    {
                        @for (int i = 0; i < Model.DanhSachDotGiaoQr.Count; i++)
                        {
                            var item = Model.DanhSachDotGiaoQr[i];
                            var dot = item.DotGiao;
                            string kinhGuiHienThi = !string.IsNullOrWhiteSpace(dot.TenNguoiNhanThiep) ? dot.TenNguoiNhanThiep : dot.TenNguoiNhan;
                            string nguoiGuiHienThi = !string.IsNullOrWhiteSpace(dot.TenNguoiGuiThiep) ? dot.TenNguoiGuiThiep : Model.DonHang.HoTenNguoiMua;

                            <div class="p-4 @(i < Model.DanhSachDotGiaoQr.Count - 1 ? "mb-3" : "")"
                                 style="background: #FFFDF9; border: 1px solid #E6D5B8; border-radius: 14px; box-shadow: 0 4px 16px rgba(122, 18, 21, 0.05);">
                                <div class="border-bottom pb-2 mb-3" style="border-color: #EADBC8 !important;">
                                    <strong class="chu-do-son-mai d-block" style="font-size: 1rem;">
                                        <i class="bi bi-gift-fill chu-vang-dong me-1"></i>Thiệp QR 3D — Kính gửi: @kinhGuiHienThi
                                    </strong>
                                    <small class="chu-nau-tram d-block mt-1">
                                        Người gửi: <strong>@nguoiGuiHienThi</strong> • Địa chỉ: @dot.DiaChiGiaoChiTiet
                                    </small>
                                </div>

                                <div class="text-center">
                                    <div class="bg-white d-inline-block p-2 rounded-3 mb-2 shadow-sm" style="border: 1px solid #E6D5B8;">
                                        <img src="@item.AnhQrBase64" width="130" height="130" alt="QR Thiệp 3D @kinhGuiHienThi" />
                                    </div>

                                    <p class="small chu-do-son-mai fst-italic mb-3 px-2">
                                        "@dot.LoiChucThiep"
                                    </p>

                                    <a href="/Thiep3D/Xem/@dot.MaTokenThiepQr" target="_blank" class="btn btn-do-son-mai w-100 rounded-pill py-2">
                                        Mở Thiệp QR 3D
                                    </a>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const MA_TRA_CUU_DON = "@Model.DonHang.MaTraCuuDh";
        const TONG_THANH_TOAN_DON = @Math.Round(Model.DonHang.TongThanhToan, 0);
        const NOI_DUNG_CK_CHUAN = "@Model.NoiDungChuyenKhoan";
        let dangChoThanhToanQr = @(Model.DangChoThanhToanQr ? "true" : "false");
        let soGiayConLaiQr = @Model.SoGiayConLai;
        let boDemGiayQr = null;
        let boPollingQr = null;
        let daXuLyHetHan = false;

        function saoChepThongTinQr(noiDung, btn) {
            if (!navigator.clipboard) return;
            navigator.clipboard.writeText(noiDung).then(() => {
                const textCu = btn.innerText;
                btn.innerText = "✓ Đã chép";
                setTimeout(() => { btn.innerText = textCu; }, 1600);
            });
        }

        function dinhDangPhutGiay(tongGiay) {
            const g = Math.max(0, Math.floor(tongGiay));
            const phut = String(Math.floor(g / 60)).padStart(2, "0");
            const giay = String(g % 60).padStart(2, "0");
            return `${phut}:${giay}`;
        }

        function hienThiThanhToanThanhCong() {
            dangChoThanhToanQr = false;
            if (boDemGiayQr) clearInterval(boDemGiayQr);
            if (boPollingQr) clearInterval(boPollingQr);

            const khungCho = document.getElementById("khungChoThanhToanQrMoMo");
            if (khungCho) khungCho.style.display = "none";

            const khungXong = document.getElementById("khungDaThanhToanQrThanhCong");
            if (khungXong) khungXong.style.display = "block";

            const badge = document.getElementById("badgeTrangThaiThanhToanDon");
            if (badge) {
                badge.textContent = "Đã thanh toán";
                badge.style.background = "#ECFDF5";
                badge.style.color = "#065F46";
                badge.style.borderColor = "#10B981";
            }

            if (typeof hienThiThongBaoGioHang === "function") {
                hienThiThongBaoGioHang("✓ Thanh toán thành công! Đơn hàng của Quý khách đang được chuẩn bị.", true);
            }
        }

        async function xuLyHetHan15PhutVaHoanKho() {
            if (daXuLyHetHan || !dangChoThanhToanQr) return;
            daXuLyHetHan = true;
            dangChoThanhToanQr = false;

            if (boDemGiayQr) clearInterval(boDemGiayQr);
            if (boPollingQr) clearInterval(boPollingQr);

            try {
                const res = await fetch(`/ThanhToan/HuyDonHetHanVaHoanKho?maTraCuu=${encodeURIComponent(MA_TRA_CUU_DON)}`, {
                    method: "POST"
                });
                const data = await res.json();
                if (data && data.daThanhToan) {
                    hienThiThanhToanThanhCong();
                    return;
                }
            } catch (e) {
                console.warn("Lỗi gọi hoàn kho tự động:", e);
            }

            const khungCho = document.getElementById("khungChoThanhToanQrMoMo");
            if (khungCho) khungCho.style.display = "none";

            const khungHetHan = document.getElementById("khungThongBaoHetHan15Phut");
            if (khungHetHan) khungHetHan.style.display = "block";

            if (typeof hienThiThongBaoGioHang === "function") {
                hienThiThongBaoGioHang("Đơn hàng đã hết hạn thanh toán 15 phút. Hệ thống đã hoàn trả sản phẩm về kho", false);
            } else {
                alert("Đơn hàng đã hết hạn thanh toán 15 phút. Hệ thống đã hoàn trả sản phẩm về kho");
            }

            setTimeout(() => {
                window.location.href = "/";
            }, 2500);
        }

        async function kiemTraTrangThaiDonDinhKy() {
            if (!dangChoThanhToanQr) return;
            try {
                const res = await fetch(`/ThanhToan/KiemTraTrangThaiDon?maTraCuu=${encodeURIComponent(MA_TRA_CUU_DON)}`);
                const data = await res.json();
                if (!data || !data.thanhCong) return;

                if (data.daThanhToan || data.trangThaiTt === "DA_THANH_TOAN") {
                    hienThiThanhToanThanhCong();
                } else if (data.daHetHan || data.soGiayConLai <= 0) {
                    await xuLyHetHan15PhutVaHoanKho();
                }
            } catch (err) {
                // Bỏ qua lỗi mạng tạm thời trong lúc polling
            }
        }

        async function testNhanWebhookMoMoThucTe() {
            const btn = document.getElementById("btnTestWebhookMoMo");
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>Đang gửi Webhook /api/webhook/momo...`;
            }

            try {
                const res = await fetch("/api/webhook/momo", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        content: NOI_DUNG_CK_CHUAN,
                        transferAmount: TONG_THANH_TOAN_DON
                    })
                });
                const data = await res.json();
                if (data && data.thanhCong) {
                    hienThiThanhToanThanhCong();
                } else {
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = "⚡ Test nhận Webhook MoMo thực tế";
                    }
                    alert(data?.thongBao || "Không thể xử lý Webhook MoMo.");
                }
            } catch (err) {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = "⚡ Test nhận Webhook MoMo thực tế";
                }
                alert("Lỗi kết nối tới /api/webhook/momo!");
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (dangChoThanhToanQr) {
                const elDongHo = document.getElementById("dong-ho-dem-nguoc-qr");
                if (elDongHo) {
                    elDongHo.textContent = dinhDangPhutGiay(soGiayConLaiQr);
                }

                boDemGiayQr = setInterval(() => {
                    soGiayConLaiQr -= 1;
                    if (elDongHo) {
                        elDongHo.textContent = dinhDangPhutGiay(soGiayConLaiQr);
                    }
                    if (soGiayConLaiQr <= 0) {
                        xuLyHetHan15PhutVaHoanKho();
                    }
                }, 1000);

                // Polling mỗi 3 giây kiểm tra trạng thái đơn
                boPollingQr = setInterval(kiemTraTrangThaiDonDinhKy, 3000);
            }
        });

        (function luuDonVuaDatVaoLocalStorage() {
            try {
                const donMoi = {
                    maTraCuuDh: "@Model.DonHang.MaTraCuuDh",
                    sdtNguoiMua: "@Model.DonHang.SdtnguoiMua",
                    tongThanhToan: @Math.Round(Model.DonHang.TongThanhToanCuoi, 0),
                    thoiGian: "@Model.DonHang.NgayDat.ToString("dd/MM/yyyy HH:mm")"
                };
                if (!donMoi.maTraCuuDh) return;

                let danhSachCu = [];
                const chuoiCu = localStorage.getItem("nguyetCat_DonGanDay");
                if (chuoiCu) {
                    const parsed = JSON.parse(chuoiCu);
                    if (Array.isArray(parsed)) {
                        danhSachCu = parsed.filter(x => x && x.maTraCuuDh !== donMoi.maTraCuuDh);
                    }
                }
                danhSachCu.unshift(donMoi);
                localStorage.setItem("nguyetCat_DonGanDay", JSON.stringify(danhSachCu.slice(0, 5)));

                if (typeof hienThiDanhSachDonVuaDatNhanh === "function") {
                    hienThiDanhSachDonVuaDatNhanh();
                }
            } catch (err) {
                console.warn("Không thể lưu lịch sử đơn gần đây:", err);
            }
        })();
    </script>
}
