@model WebBanhTrungThu.ViewModels.DonHangThanhCongViewModel
@{
    ViewData["Title"] = $"Đặt Hàng Thành Công #{Model.DonHang.MaTraCuuDh}";
}

<section class="py-4 py-lg-5 trang-thanh-toan-sang">
    <div class="container">
        <!-- KHỐI CHÚC MỪNG & MÃ TRA CỨU ĐƠN HÀNG TRÊN NỀN SÁNG -->
        <div class="card-hoang-gia p-4 p-lg-5 text-center mb-4">
            <div class="mb-3">
                <span class="badge badge-thuong-hang px-4 py-2 rounded-pill fs-6">
                    🌕 ĐẶT HÀNG &amp; KHỞI TẠO THIỆP QR 3D THÀNH CÔNG
                </span>
            </div>
            <h1 class="font-co-phong display-5 fw-bold chu-do-son-mai mb-2">
                Cảm Ơn Quý Khách @Model.DonHang.HoTenNguoiMua!
            </h1>
            <p class="chu-nau-phu mb-4 mx-auto" style="max-width: 680px;">
                Tuyệt tác lễ hộp Trung Thu của Quý khách đã được chuyển xuống xưởng nghệ nhân Nguyệt Cát để chuẩn bị đóng gói và niêm phong thiệp chúc mừng QR 3D.
            </p>

            <div class="row g-3 justify-content-center mb-4">
                <div class="col-md-3 col-sm-6">
                    <div class="the-thong-ke-thanh-cong">
                        <small class="chu-nau-phu d-block mb-1">Mã Tra Cứu Đơn Hàng</small>
                        <strong class="fs-4 chu-do-son-mai">@Model.DonHang.MaTraCuuDh</strong>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="the-thong-ke-thanh-cong">
                        <small class="chu-nau-phu d-block mb-1">Số Điện Thoại Đặt Mua</small>
                        <strong class="fs-5 chu-nau-tram">@Model.DonHang.SdtnguoiMua</strong>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="the-thong-ke-thanh-cong">
                        <small class="chu-nau-phu d-block mb-1">Tổng Thanh Toán (@Model.DonHang.PhuongThucTt)</small>
                        <strong class="fs-4 chu-do-son-mai">@Model.DonHang.TongThanhToanCuoi.ToString("N0") đ</strong>
                    </div>
                </div>
                @if (Model.DiemCongThem > 0)
                {
                    <div class="col-md-3 col-sm-6">
                        <div class="the-thong-ke-thanh-cong" style="border-color: #81C784; background-color: #F4FBF5;">
                            <small class="chu-nau-phu d-block mb-1">Điểm Thưởng Tích Lũy</small>
                            <strong class="fs-4 text-success">+@Model.DiemCongThem Điểm</strong>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-center flex-wrap gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-do-son-mai rounded-pill px-4 py-2">
                    <i class="bi bi-house-heart-fill me-1"></i>Về Trang Chủ Nguyệt Cát
                </a>
            </div>
        </div>

        <!-- DANH SÁCH CÁC ĐIỂM GIAO QUÀ & MÃ QR THIỆP CHÚC MỪNG 3D -->
        <div class="mb-4">
            <div class="text-center mb-4">
                <span class="text-uppercase small fw-bold chu-vang-dong" style="letter-spacing: 1px;">
                    Trải Nghiệm Quà Tặng Đoàn Viên Độc Bản
                </span>
                <h2 class="font-co-phong display-6 fw-bold chu-do-son-mai mb-1">
                    Mã QR Thiệp Chúc Mừng 3D Cho Từng Điểm Nhận (@Model.DanhSachDotGiaoQr.Count Điểm Giao)
                </h2>
                <p class="chu-nau-phu small mb-0">
                    Mỗi mã QR dưới đây sẽ được in ánh kim đính kèm trên nắp hộp quà tương ứng. Người nhận dùng điện thoại quét mã hoặc bạn có thể bấm nút bên dưới để mở xem thử ngay!
                </p>
            </div>

            <div class="row g-4 justify-content-center">
                @for (int i = 0; i < Model.DanhSachDotGiaoQr.Count; i++)
                {
                    var item = Model.DanhSachDotGiaoQr[i];
                    var dot = item.DotGiao;
                    <div class="col-md-6 col-lg-5">
                        <div class="card-hoang-gia p-4 h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3" style="border-color: #EADBC8 !important;">
                                    <strong class="chu-do-son-mai fs-5">
                                        <i class="bi bi-gift-fill chu-vang-dong me-1"></i>Điểm Nhận #@(i + 1): @dot.TenNguoiNhan
                                    </strong>
                                    <span class="badge rounded-pill" style="background: #F6EFE2; color: #7A1215; border: 1px solid #E6D5B8;">
                                        @dot.TrangThaiGiao
                                    </span>
                                </div>

                                <div class="small chu-nau-tram mb-3">
                                    <div class="mb-1"><i class="bi bi-telephone-fill chu-vang-dong me-2"></i>SĐT người nhận: <strong>@dot.SdtnguoiNhan</strong></div>
                                    <div class="mb-1"><i class="bi bi-geo-alt-fill chu-vang-dong me-2"></i>Địa chỉ: @dot.DiaChiGiaoChiTiet</div>
                                    <div class="mb-1"><i class="bi bi-calendar-heart-fill chu-vang-dong me-2"></i>Hẹn giao: <strong>@dot.NgayHenGiao.ToString("dd/MM/yyyy") (@dot.KhungGioGiao)</strong></div>
                                </div>
                            </div>

                            @if (dot.CoKemThiepQr && !string.IsNullOrEmpty(item.AnhQrBase64))
                            {
                                <div class="text-center khung-qr-thanh-cong">
                                    <span class="badge badge-thuong-hang mb-2">Mã Token: @dot.MaTokenThiepQr</span>
                                    <div class="bg-white d-inline-block p-2 rounded my-2 shadow-sm" style="border: 1px solid #E6D5B8;">
                                        <img src="@item.AnhQrBase64" width="175" height="175" alt="QR Code Thiệp 3D @dot.TenNguoiNhan" />
                                    </div>
                                    <p class="small chu-do-son-mai fst-italic mb-3">
                                        "@dot.LoiChucThiep"
                                    </p>
                                    <a href="/Thiep3D/Xem/@dot.MaTokenThiepQr" target="_blank" class="btn btn-do-son-mai w-100 rounded-pill py-2">
                                        ✨ Mở Xem Thử Thiệp 3D Ngay
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="text-center chu-nau-phu p-3 rounded" style="background: #FDFBF7; border: 1px dashed #E6D5B8;">
                                    Điểm giao này không đính kèm thiệp QR 3D.
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- CHI TIẾT CÁC MÓN TRONG ĐƠN HÀNG (NỀN SÁNG & BẢNG 2 CỘT Ô BÁNH) -->
        <div class="card-hoang-gia p-4">
            <h4 class="font-co-phong fs-3 fw-bold chu-do-son-mai border-bottom pb-2 mb-3" style="border-color: #EADBC8 !important;">
                <i class="bi bi-receipt-cutoff chu-vang-dong me-2"></i>Chi Tiết Sản Phẩm Đã Đặt &amp; Tổng Kết Thanh Toán
            </h4>
            <div class="table-responsive">
                <table class="table table-trung-thu align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Sản Phẩm / Thành Phần Hộp Quà</th>
                            <th class="text-center">Số Lượng</th>
                            <th class="text-end">Đơn Giá</th>
                            <th class="text-end">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ct in Model.DonHang.ChiTietDonHangs)
                        {
                            <tr>
                                <td style="min-width: 260px;">
                                    <strong class="chu-do-son-mai d-block">@ct.TenSanPhamLuuCung</strong>
                                    @if (!string.IsNullOrWhiteSpace(ct.CauHinhHopJson))
                                    {
                                        try
                                        {
                                            var mangO = Newtonsoft.Json.Linq.JArray.Parse(ct.CauHinhHopJson);
                                            if (mangO.Count > 0)
                                            {
                                                <small class="chu-nau-phu d-block mt-1" style="font-size: 0.76rem;">
                                                    Loại hộp: @mangO.Count bánh tự phối
                                                </small>
                                                <div class="bang-thanh-phan-hop-2-cot" style="max-width: 460px;">
                                                    @foreach (var o in mangO)
                                                    {
                                                        int viTri = o.Value<int?>("ViTriOTrongHop") ?? 1;
                                                        string tenBanh = o.Value<string>("TenBanh") ?? "Bánh Trung Thu";
                                                        <div class="dong-thanh-phan-hop" style="display: flex; align-items: baseline; padding: 4px 8px; border-bottom: 1px dashed #EADBC8; font-size: 0.78rem;">
                                                            <span class="cot-o-banh" style="font-weight: 700; color: #7A1215; flex: 0 0 56px;">Ô số @viTri</span>
                                                            <span class="cot-ten-banh" style="flex: 1; color: #2C1810; font-weight: 500;">@tenBanh</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                        catch
                                        {
                                            <small class="chu-nau-phu d-block">Hộp quà tự chọn Nguyệt Cát</small>
                                        }
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge rounded-pill" style="background: #F6EFE2; color: #7A1215; border: 1px solid #E6D5B8;">
                                        x @ct.SoLuong
                                    </span>
                                </td>
                                <td class="text-end chu-nau-tram">@ct.DonGiaLucMua.ToString("N0") đ</td>
                                <td class="text-end fw-bold chu-do-son-mai">@ct.ThanhTien.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot style="border-top: 2px solid #E6D5B8;">
                        <tr>
                            <td colspan="3" class="text-end chu-nau-phu">Tổng tiền hàng:</td>
                            <td class="text-end fw-semibold chu-nau-tram">@Model.DonHang.TongTienHang.ToString("N0") đ</td>
                        </tr>
                        @if (Model.DonHang.TienChietKhauB2b > 0)
                        {
                            <tr>
                                <td colspan="3" class="text-end" style="color: #9A5B13;">Chiết khấu sỉ B2B (@Model.DonHang.PhanTramCkB2b%):</td>
                                <td class="text-end fw-semibold" style="color: #9A5B13;">-@Model.DonHang.TienChietKhauB2b.ToString("N0") đ</td>
                            </tr>
                        }
                        @if (Model.DonHang.TienGiamVoucher > 0)
                        {
                            <tr>
                                <td colspan="3" class="text-end text-success">Giảm giá Voucher:</td>
                                <td class="text-end fw-semibold text-success">-@Model.DonHang.TienGiamVoucher.ToString("N0") đ</td>
                            </tr>
                        }
                        @if (Model.DonHang.PhiInLogo > 0)
                        {
                            <tr>
                                <td colspan="3" class="text-end chu-nau-phu">Phí khuôn ép kim Logo B2B:</td>
                                <td class="text-end fw-semibold chu-nau-tram">+@Model.DonHang.PhiInLogo.ToString("N0") đ</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="3" class="text-end chu-nau-phu">Phí vận chuyển (@Model.DonHang.DotGiaoHangDaDiems.Count điểm giao):</td>
                            <td class="text-end fw-semibold chu-nau-tram">+@Model.DonHang.TongPhiVanChuyen.ToString("N0") đ</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end nhan-tong-thanh-toan" style="color: #2C1810; font-size: 1.1rem; font-weight: 700;">TỔNG THANH TOÁN:</td>
                            <td class="text-end so-tien-tong-thanh-toan" style="color: #7A1215; font-size: 1.45rem; font-weight: 800;">@Model.DonHang.TongThanhToanCuoi.ToString("N0") đ</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</section>
