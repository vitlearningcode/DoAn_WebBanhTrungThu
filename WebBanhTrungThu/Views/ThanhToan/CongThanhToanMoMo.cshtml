@model WebBanhTrungThu.ViewModels.CongThanhToanMoMoViewModel
@{
  Layout = null;
  ViewData["Title"] = $"Cổng thanh toán MoMo - Đơn hàng #{Model.MaTraCuuDh}";
  int phutBanDau = Math.Max(0, Model.SoGiayConLai / 60), giayBanDau = Math.Max(0, Model.SoGiayConLai % 60);
  string noiDungCk = !string.IsNullOrWhiteSpace(Model.NoiDungChuyenKhoan) ? Model.NoiDungChuyenKhoan : $"NGUYETCAT {Model.MaTraCuuDh}";
  long soTienNguyen = (long)Math.Round(Model.TongThanhToan, 0);
  string[] nganHangs = { "Vietcombank", "Agribank", "MB Bank", "BIDV", "VPBank", "VietinBank", "ACB", "TPBank", "Techcombank", "Sacombank", "VIB", "HDBank" };
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"]</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..700&family=Lora:ital,wght@0,500..700;1,500..700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/thanh-toan.css" asp-append-version="true" />
</head>
<body class="trang-cong-momo-doc-lap">
<header class="header-cong-momo">
<div class="container cong-momo-container d-flex align-items-center justify-content-between">
  <div class="d-flex align-items-center gap-2"><span class="logo-momo-header">momo</span><span class="tieu-de-header-cong-momo">Cổng thanh toán MoMo</span></div>
  <div class="d-none d-sm-flex align-items-center gap-2 small text-muted"><i class="bi bi-shield-lock-fill icon-bao-mat-momo"></i><span>Giao dịch được bảo mật 100%</span></div>
</div>
</header>
<main id="congThanhToanMoMoRoot" class="py-4" data-ma-don-hang="@Model.MaTraCuuDh" data-tong-thanh-toan="@soTienNguyen" data-noi-dung-ck="@noiDungCk" data-han-thanh-toan-iso="@Model.HanThanhToan.ToString("O")" data-so-giay-con-lai="@Model.SoGiayConLai" data-url-vietqr="@(Model.UrlVietQr ?? "")">
<div class="container cong-momo-container">
<div class="khung-chinh-cong-momo">
  <aside class="cot-trai-cong-momo">
  <div class="the-thong-tin-don-momo">
    <h2 class="tieu-de-the-don-momo">Thông tin đơn hàng</h2>
    <div class="muc-thong-tin-momo"><span class="nhan-muc-momo">Nhà cung cấp</span><div class="d-flex align-items-center gap-2 mt-1"><span class="logo-nguyet-cat-mini">NC</span><strong class="ten-nha-cung-cap-momo">NGUYỆT CÁT</strong></div></div>
    <div class="muc-thong-tin-momo"><span class="nhan-muc-momo">SĐT MoMo</span><div class="d-flex align-items-center justify-content-between gap-2 mt-1"><span class="fw-bold sdt-momo-gia-tri">@Model.SoDienThoaiMoMo</span><button type="button" class="nut-copy-nho-momo" data-copy="@Model.SoTaiKhoanMoMo">Copy</button></div></div>
    <div class="muc-thong-tin-momo"><span class="nhan-muc-momo">Mã đơn hàng</span><div class="gia-tri-muc-momo fw-bold text-dark">@Model.MaTraCuuDh</div></div>
    <div class="muc-thong-tin-momo"><span class="nhan-muc-momo">Nội dung chuyển khoản</span><div class="d-flex align-items-center justify-content-between gap-2 mt-1"><span class="fw-semibold noi-dung-ck-momo">@noiDungCk</span><button type="button" class="nut-copy-nho-momo" data-copy="@noiDungCk">Copy</button></div></div>
    <div class="muc-thong-tin-momo border-bottom-0 pb-1"><span class="nhan-muc-momo">Số tiền</span><div class="d-flex align-items-center justify-content-between gap-2 mt-1"><span class="gia-tri-so-tien-momo">@Model.TongThanhToan.ToString("N0")đ</span><button type="button" class="nut-copy-nho-momo" data-copy="@soTienNguyen">Copy</button></div></div>
    <div class="khung-dem-nguoc-momo mt-3">
      <div class="tieu-de-dem-nguoc-momo mb-2">Đơn hàng sẽ hết hạn sau:</div>
      <div class="d-flex align-items-center justify-content-center gap-3">
        <div class="o-vuong-dong-ho-momo"><span id="phut-con-lai" class="so-dong-ho-momo">@phutBanDau.ToString("D2")</span><span class="nhan-dong-ho-momo">Phút</span></div>
        <div class="o-vuong-dong-ho-momo"><span id="giay-con-lai" class="so-dong-ho-momo">@giayBanDau.ToString("D2")</span><span class="nhan-dong-ho-momo">Giây</span></div>
      </div>
    </div>
    <div class="text-center mt-4 pt-2"><a href="/ThanhToan/ThanhCong/@Model.MaTraCuuDh" class="lien-ket-quay-ve-momo">Quay về</a></div>
  </div>
  </aside>
  <section class="cot-phai-cong-momo">
  <div class="khung-hong-qr-momo">
    @if (Model.CoCauHinhVietQrNganHang)
    {
      <div class="text-center mb-3"><div class="tab-chuyen-qr-momo"><button type="button" class="nut-tab-qr-momo active" id="btnTabQrMoMo" data-qr-mode="MOMO">QR Ví MoMo</button><button type="button" class="nut-tab-qr-momo" id="btnTabVietQr" data-qr-mode="VIETQR">VietQR Ngân hàng</button></div></div>
    }
    else
    {
      <div class="dai-huy-hieu-momo mb-4"><span class="muc-huy-hieu-momo fw-extrabold">Ví MoMo</span><span class="vach-ngan-huy-hieu">|</span><span class="muc-huy-hieu-momo">Chuyển khoản QR</span></div>
    }
    <div class="d-flex justify-content-center my-2">
      <div class="khung-trang-qr-260"><span class="goc-ngam-qr goc-tren-trai"></span><span class="goc-ngam-qr goc-tren-phai"></span><span class="goc-ngam-qr goc-duoi-trai"></span><span class="goc-ngam-qr goc-duoi-phai"></span><img id="imgQrCongMoMoChinh" src="@Model.AnhQrThanhToanBase64" width="240" height="240" alt="Mã QR MoMo @Model.MaTraCuuDh" class="anh-qr-momo-chinh" /><div id="logoTamQrMoMo" class="logo-momo-tam-qr"><span>momo</span></div></div>
    </div>
    <div class="text-center text-white mt-3">
      <div id="lblHuongDanQuetQr" class="huong-dan-quet-qr-momo fw-semibold d-flex align-items-center justify-content-center gap-2"><i class="bi bi-qr-code-scan"></i><span>Mở ứng dụng MoMo → Chọn Quét Mã để chuyển khoản tự động điền sẵn số tiền &amp; nội dung</span></div>
      <div class="thong-tin-tk-qr-momo mt-2 small">SĐT MoMo: <strong>@Model.SoDienThoaiMoMo</strong> • Chủ TK: <strong>@Model.TenChuTaiKhoan</strong></div>
    </div>
  </div>
  <div class="khung-ngan-hang-ho-tro mt-3">
    @if (Model.CoCauHinhVietQrNganHang)
    {
      <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2"><span class="small fw-semibold nhan-ngan-hang-ho-tro">Ngân hàng hỗ trợ quét mã VietQR / MoMo</span><span class="small text-muted dem-ngan-hang-ho-tro">40+ ngân hàng nội địa</span></div>
      <div class="luoi-the-ngan-hang">@foreach (var nh in nganHangs) { <span class="the-ten-ngan-hang">@nh</span> }</div>
    }
    else
    {
      <div class="small fw-semibold mb-2 nhan-ngan-hang-ho-tro">Hướng dẫn chuyển khoản nhanh bằng Ví MoMo</div>
      <div class="d-flex flex-column gap-2">
        <div class="buoc-huong-dan-momo"><span class="so-buoc-momo">1</span><span>Mở ứng dụng <strong>MoMo</strong> trên điện thoại và chọn mục <strong>Quét Mã</strong>.</span></div>
        <div class="buoc-huong-dan-momo"><span class="so-buoc-momo">2</span><span>Hướng camera vào mã QR phía trên — ứng dụng tự động điền SĐT <strong>@Model.SoDienThoaiMoMo</strong>, số tiền <strong>@Model.TongThanhToan.ToString("N0")đ</strong> và lời nhắn <strong>@noiDungCk</strong>.</span></div>
        <div class="buoc-huong-dan-momo"><span class="so-buoc-momo">3</span><span>Xác nhận chuyển tiền, hệ thống sẽ tự động cập nhật trạng thái đơn hàng trong vài giây.</span></div>
      </div>
    }
    <div class="mt-3 pt-2 border-top text-center vach-test-webhook-momo"><button type="button" id="btnTestWebhookMoMo" class="nut-gia-lap-webhook-momo">⚡ Giả lập Khách đã quét QR thành công (Test Webhook MoMo)</button></div>
  </div>
  </section>
</div>
</div>
</main>
<script src="~/js/modules/cong-thanh-toan-momo.js" asp-append-version="true"></script>
</body>
</html>
