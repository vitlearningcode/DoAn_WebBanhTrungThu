@model WebBanhTrungThu.ViewModels.LandingPageViewModel
@using WebBanhTrungThu.Services
@{
    ViewData["Title"] = "Tuyệt Tác Trăng Rằm";
    string anhHero = Model.HeroBanner?.MaAnhNenNavigation?.UrlHienThi ?? "/images/landing/hero-banner-trungthu.jpg";
}

<!-- =========================================================================
     TẦNG 2: HERO STORYTELLING BANNER & ĐẾM NGƯỢC TẾT ĐOÀN VIÊN
     ========================================================================= -->
<section id="tang-hero" class="position-relative py-5" style="background: linear-gradient(135deg, rgba(11,19,43,0.92) 40%, rgba(28,37,65,0.82) 100%), url('@anhHero') center/cover no-repeat; min-height: 82vh; display: flex; align-items: center;">
    <div class="container py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(212,175,55,0.15); border: 1px solid var(--mau-vang-anh-kim);">
                    <span class="chu-vang-kim small fw-semibold">✨ @(Model.HeroBanner?.TieuDePhu ?? "BỘ SƯU TẬP TRUNG THU NGHỆ THUẬT 2026")</span>
                    <span class="badge bg-dark text-warning border border-warning">Phiên: @Model.MaPhienHienTai</span>
                </div>

                <h1 class="font-co-phong display-4 fw-bold chu-vang-kim mb-3">
                    @(Model.HeroBanner?.TieuDeChinh ?? "Tuyệt Tác Trăng Rằm – Tự Tay Kiến Tạo Hộp Quà Độc Bản")
                </h1>

                <p class="lead text-light opacity-75 mb-4">
                    @(Model.HeroBanner?.NoiDungMoTa ?? "Kết hợp tinh hoa nhân bánh truyền thống, dòng bánh đường ăn kiêng Isomalt tốt cho sức khỏe và trình dựng hộp quà 3D thông minh.")
                </p>

                <!-- Đồng hồ đếm ngược Trung Thu -->
                <div class="d-flex gap-3 mb-4">
                    <div class="card-hoang-gia px-3 py-2 text-center">
                        <span id="cd-ngay" class="fs-3 fw-bold chu-vang-kim d-block">18</span>
                        <small class="text-secondary">Ngày</small>
                    </div>
                    <div class="card-hoang-gia px-3 py-2 text-center">
                        <span id="cd-gio" class="fs-3 fw-bold chu-vang-kim d-block">09</span>
                        <small class="text-secondary">Giờ</small>
                    </div>
                    <div class="card-hoang-gia px-3 py-2 text-center">
                        <span id="cd-phut" class="fs-3 fw-bold chu-vang-kim d-block">45</span>
                        <small class="text-secondary">Phút</small>
                    </div>
                    <div class="card-hoang-gia px-3 py-2 text-center">
                        <span id="cd-giay" class="fs-3 fw-bold chu-vang-kim d-block">30</span>
                        <small class="text-secondary">Giây</small>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3">
                    <a href="#tang-tu-chon-hop" class="btn btn-vang-kim btn-lg rounded-pill px-4">
                        <i class="bi bi-magic me-2"></i>Tự Phối Hộp Quà Ngay
                    </a>
                    <button class="btn btn-vien-vang btn-lg rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalTroLyChonBanh">
                        <i class="bi bi-robot me-2"></i>Nhờ AI Chọn Bánh Trong 30s
                    </button>
                </div>
            </div>

            <div class="col-lg-5 text-center">
                <div class="card-hoang-gia p-4 position-relative">
                    <span class="badge badge-thuong-hang position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill">
                        🔥 Đặt sớm giảm 10% (Mã: TRANGTRON2026)
                    </span>
                    <img src="@DichVuHinhAnh.LayUrl(Model.TuDienAnh, "BANH", 1, "TACH_NEN_SLOT")" class="img-fluid my-3" style="max-height: 290px;" alt="Bánh Trung Thu Chủ Đạo" />
                    <h4 class="font-co-phong chu-vang-kim mb-1">Hộp Sơn Mài Tứ Quý Đoàn Viên</h4>
                    <p class="small text-secondary mb-0">Tự do phối 4 hoặc 6 vị bánh • Tính Calo & Chỉ số GI tự động</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     TẦNG 3: TRÌNH DỰNG HỘP QUÀ THÔNG MINH 3 BƯỚC (CUSTOM BOX BUILDER STUDIO)
     ========================================================================= -->
<section id="tang-tu-chon-hop" class="py-5 border-top border-secondary" style="background: rgba(28,37,65,0.35);">
    <div class="container py-3">
        <div class="text-center mb-5">
            <span class="text-uppercase small chu-vang-kim fw-bold">Trải Nghiệm Độc Quyền</span>
            <h2 class="font-co-phong display-5 fw-bold chu-vang-kim">Studio Tự Phối Hộp Quà 3 Bước</h2>
            <p class="text-secondary">Chọn mẫu vỏ hộp sang trọng, chạm để đặt từng chiếc bánh vào ô trống và theo dõi trực tiếp tổng Calo & cảnh báo dị ứng</p>
        </div>

        <div class="row g-4">
            <!-- CỘT 1 (3 Phần): Chọn Vỏ Hộp & Bảng Thống Kê Dinh Dưỡng Hộp -->
            <div class="col-lg-3">
                <div class="card-hoang-gia p-3 h-100">
                    <h5 class="font-co-phong fs-4 chu-vang-kim border-bottom border-secondary pb-2 mb-3">
                        1. Chọn Mẫu Vỏ Hộp
                    </h5>

                    @foreach (var vh in Model.DanhSachVoHop)
                    {
                        string anhKhay = DichVuHinhAnh.LayUrl(Model.TuDienAnh, "VOHOP", vh.MaVh, "KHAY_HOP_RONG");
                        <div class="form-check p-3 mb-2 rounded border border-secondary bg-dark">
                            <input class="form-check-input ms-0 me-2" type="radio" name="chonVoHop"
                                   id="vh_@vh.MaVh" value="@vh.MaVh"
                                   data-ten="@vh.TenVoHop"
                                   data-succhua="@vh.SucChuaBanh"
                                   data-giavo="@vh.GiaVoHopRieng"
                                   data-minvip="@vh.SlbanhThuongHangToiThieu"
                                   data-luoi="@vh.KieuBoCucLuoi"
                                   data-anhkhay="@anhKhay"
                                   @(vh.MaVh == 1 ? "checked" : "")
                                   onchange="doiMauVoHop(this)">
                            <label class="form-check-label d-block" for="vh_@vh.MaVh" style="cursor:pointer;">
                                <strong class="chu-vang-kim d-block">@vh.TenVoHop</strong>
                                <span class="small text-light">Sức chứa: @vh.SucChuaBanh bánh • Vỏ: @vh.GiaVoHopRieng.ToString("N0")đ</span>
                                @if (vh.SlbanhThuongHangToiThieu > 0)
                                {
                                    <span class="badge badge-thuong-hang d-block mt-1">Yêu cầu >= @vh.SlbanhThuongHangToiThieu bánh Thượng Hạng</span>
                                }
                            </label>
                        </div>
                    }

                    <hr class="border-secondary my-3" />
                    <h6 class="chu-vang-kim fw-bold mb-2"><i class="bi bi-activity me-1"></i>Thông Số Hộp Tự Tính:</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="d-flex justify-content-between py-1">
                            <span>Số ô đã xếp:</span>
                            <strong id="lblSoODaXep" class="text-warning">0 / 4 bánh</strong>
                        </li>
                        <li class="d-flex justify-content-between py-1">
                            <span>Tổng năng lượng:</span>
                            <strong id="lblTongCalo" class="text-info">0 Kcal</strong>
                        </li>
                        <li class="d-flex justify-content-between py-1">
                            <span>Bánh Thượng Hạng:</span>
                            <strong id="lblSoBanhVip">0 bánh</strong>
                        </li>
                        <li class="py-1">
                            <span class="text-secondary d-block">Cảnh báo dị ứng tổng hợp:</span>
                            <span id="lblCanhBaoDiUng" class="text-warning fst-italic">Chưa chọn bánh</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- CỘT 2 (5 Phần): Khay Hộp Tương Tác Trực Tiếp -->
            <div class="col-lg-5">
                <div class="card-hoang-gia p-4 text-center h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-secondary" id="lblMaBamCauHinh">Mã cấu hình: #VH1_EMPTY</span>
                            <button class="btn btn-sm btn-outline-warning" onclick="lamTrongKhayHop()">
                                <i class="bi bi-arrow-counterclockwise"></i> Làm trống khay
                            </button>
                        </div>

                        <!-- Khay hộp có nền động từ KhoHinhAnh -->
                        <div id="khungKhayHop" class="khung-khay-hop my-2 d-flex align-items-center justify-content-center"
                             style="background-image: linear-gradient(rgba(11,19,43,0.65), rgba(11,19,43,0.65)), url('@DichVuHinhAnh.LayUrl(Model.TuDienAnh, "VOHOP", 1, "KHAY_HOP_RONG")');">
                            <div id="luoiOBanh" class="luoi-hop-2x2 w-100">
                                <!-- Các ô trống được render động bằng JS -->
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 text-start">
                        <div class="input-group input-group-sm mb-3">
                            <span class="input-group-text bg-dark text-warning border-secondary">Tên hộp quà:</span>
                            <input type="text" id="txtTenHopTuDat" class="form-control bg-dark text-light border-secondary" value="Hộp Quà Đoàn Viên Tự Phối" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-light">Giá trọn bộ (Đã giảm 5% giá vỏ):</span>
                            <span id="lblTongGiaHop" class="fs-4 fw-bold chu-vang-kim">80.750 đ</span>
                        </div>

                        <button id="btnThemHopVaoGio" class="btn btn-vang-kim w-100 py-2" disabled onclick="xacNhanThemHopTuChon()">
                            🔒 Vui lòng xếp đủ bánh vào các ô trống
                        </button>
                    </div>
                </div>
            </div>

            <!-- CỘT 3 (4 Phần): Danh Sách Nhân Bánh Tách Nền .PNG Để Bấm/Thả Vào Ô -->
            <div class="col-lg-4">
                <div class="card-hoang-gia p-3 h-100">
                    <h5 class="font-co-phong fs-4 chu-vang-kim border-bottom border-secondary pb-2 mb-3">
                        3. Chọn Vị Bánh Đặt Vào Khay
                    </h5>
                    <div class="overflow-auto pe-1" style="max-height: 460px;">
                        @foreach (var b in Model.DanhSachBanh)
                        {
                            string anhSlot = DichVuHinhAnh.LayUrl(Model.TuDienAnh, "BANH", b.MaBanh, "TACH_NEN_SLOT");
                            int calo = b.ThongSoDinhDuong?.NangLuongCalo ?? 400;
                            int gi = b.ThongSoDinhDuong?.ChiSoDuongHuyetGi ?? 55;
                            string diUng = b.ThongSoDinhDuong?.CanhBaoDiUng ?? "Không";

                            <div class="d-flex align-items-center gap-3 p-2 mb-2 rounded bg-dark border border-secondary">
                                <img src="@anhSlot" width="64" height="64" class="rounded-circle border border-warning p-1" alt="@b.TenBanh" />
                                <div class="flex-grow-1">
                                    <div class="d-flex align-items-center gap-1">
                                        <strong class="small text-light">@b.TenBanh</strong>
                                        @if (b.LaBanhThuongHang)
                                        {
                                            <span class="badge badge-thuong-hang" style="font-size:0.65rem;">👑 VIP</span>
                                        }
                                    </div>
                                    <div class="small chu-vang-kim fw-semibold">@b.DonGiaLe.ToString("N0") đ</div>
                                    <div class="d-flex gap-2 mt-1" style="font-size: 0.72rem;">
                                        <span class="text-info">@calo Kcal</span>
                                        <span class="text-success">• GI: @gi</span>
                                        @if (b.LaBanhChay)
                                        {
                                            <span class="text-warning">• 🌱 Chay</span>
                                        }
                                    </div>
                                </div>
                                <button class="btn btn-sm btn-vang-kim rounded-pill px-3"
                                        onclick="datBanhVaoOTrong(@b.MaBanh, '@b.TenBanh', @b.DonGiaLe, @calo, @(b.LaBanhThuongHang ? "true" : "false"), '@anhSlot', '@diUng')">
                                    + Đặt
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     TẦNG 4: BỘ SƯU TẬP BÁNH & BỘ LỌC DINH DƯỠNG THÔNG MINH (AJAX TABS)
     ========================================================================= -->
<section id="tang-bo-suu-tap" class="py-5">
    <div class="container py-3">
        <div class="text-center mb-4">
            <span class="text-uppercase small chu-vang-kim fw-bold">Minh Bạch Dinh Dưỡng & Chỉ Số Đường Huyết (GI)</span>
            <h2 class="font-co-phong display-5 fw-bold chu-vang-kim">Bộ Sưu Tập Bánh Trung Thu Tuyển Chọn</h2>
        </div>

        <!-- Thanh nút lọc nhanh không tải lại trang -->
        <div class="d-flex justify-content-center flex-wrap gap-2 mb-4">
            <button class="btn btn-vien-vang rounded-pill px-4 active" onclick="locSanPham('ALL', this)">Tất Cả (@Model.DanhSachBanh.Count)</button>
            <button class="btn btn-vien-vang rounded-pill px-4" onclick="locSanPham('ISOMALT', this)">🌿 Đường Isomalt - Tiểu Đường</button>
            <button class="btn btn-vien-vang rounded-pill px-4" onclick="locSanPham('VIP', this)">👑 Thượng Hạng Biếu Sếp</button>
            <button class="btn btn-vien-vang rounded-pill px-4" onclick="locSanPham('LAVA', this)">🔥 Nhân Chảy Lava</button>
            <button class="btn btn-vien-vang rounded-pill px-4" onclick="locSanPham('CHAY', this)">🌱 Thuần Chay 100%</button>
        </div>

        <div class="row g-4" id="luoiSanPhamBanh">
            @foreach (var b in Model.DanhSachBanh)
            {
                string anhBanh = DichVuHinhAnh.LayUrl(Model.TuDienAnh, "BANH", b.MaBanh, "TACH_NEN_SLOT");
                int calo = b.ThongSoDinhDuong?.NangLuongCalo ?? 400;
                int gi = b.ThongSoDinhDuong?.ChiSoDuongHuyetGi ?? 55;
                decimal duong = b.ThongSoDinhDuong?.LuongDuongGram ?? 15;

                <div class="col-md-6 col-lg-3 item-banh-card"
                     data-isomalt="@(b.MucDoNgot == "ISOMALT_TIEUDUONG" ? "1" : "0")"
                     data-vip="@(b.LaBanhThuongHang ? "1" : "0")"
                     data-lava="@(b.NhomHuongVi == "LAVA_CHAY" ? "1" : "0")"
                     data-chay="@(b.LaBanhChay ? "1" : "0")">
                    <div class="card-hoang-gia p-3 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                @if (b.MucDoNgot == "ISOMALT_TIEUDUONG")
                                {
                                    <span class="badge badge-isomalt rounded-pill">🌿 GI Thấp: @gi</span>
                                }
                                else if (b.LaBanhThuongHang)
                                {
                                    <span class="badge badge-thuong-hang rounded-pill">👑 Thượng Hạng</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill">@b.TrongLuongGram g</span>
                                }
                                <small class="text-secondary">Trứng: @b.SoTrungMuoi</small>
                            </div>

                            <div class="text-center my-3">
                                <img src="@anhBanh" class="img-fluid" style="max-height: 165px;" alt="@b.TenBanh" />
                            </div>

                            <h5 class="font-co-phong fs-4 chu-vang-kim mb-1">@b.TenBanh</h5>
                            <p class="small text-secondary mb-2">@b.MoTaNgan</p>
                        </div>

                        <div>
                            <div class="p-2 rounded bg-dark border border-secondary mb-3 d-flex justify-content-around text-center small">
                                <div><strong class="text-info d-block">@calo</strong><span class="text-muted" style="font-size:0.7rem;">Kcal</span></div>
                                <div class="border-start border-secondary ps-2"><strong class="text-warning d-block">@duong g</strong><span class="text-muted" style="font-size:0.7rem;">Đường</span></div>
                                <div class="border-start border-secondary ps-2"><strong class="text-success d-block">@gi</strong><span class="text-muted" style="font-size:0.7rem;">Chỉ số GI</span></div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span class="fs-5 fw-bold chu-vang-kim">@b.DonGiaLe.ToString("N0") đ</span>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-vien-vang rounded-pill px-2"
                                            onclick="themBanhLeVaoGio(@b.MaBanh, 1)" title="Mua lẻ bánh này">
                                        🛒 Mua lẻ
                                    </button>
                                    <a href="#tang-tu-chon-hop" class="btn btn-sm btn-vang-kim rounded-pill px-2"
                                       onclick="datBanhVaoOTrong(@b.MaBanh, '@b.TenBanh', @b.DonGiaLe, @calo, @(b.LaBanhThuongHang ? "true" : "false"), '@anhBanh', '@(b.ThongSoDinhDuong?.CanhBaoDiUng)')">
                                        Đưa vào hộp ↑
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- =========================================================================
     TẦNG 5: TRÌNH TÍNH CHIẾT KHẤU SỈ B2B ĐỘNG (B2B INTERACTIVE CALCULATOR)
     ========================================================================= -->
<section id="tang-b2b" class="py-5 border-top border-secondary" style="background: rgba(28,37,65,0.4);">
    <div class="container py-3">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="text-uppercase small chu-vang-kim fw-bold">Giải Pháp Quà Tặng Doanh Nghiệp</span>
                <h2 class="font-co-phong display-5 fw-bold chu-vang-kim mb-3">Tính Giá Sỉ B2B & Ép Kim Logo Riêng</h2>
                <p class="text-secondary mb-4">Kéo thanh trượt bên dưới để xem mức chiết khấu tự động theo số lượng hộp và chính sách miễn phí khuôn in Logo công ty lên nắp hộp.</p>

                <div class="card-hoang-gia p-4">
                    <label class="form-label d-flex justify-content-between">
                        <span>Số lượng hộp dự kiến đặt:</span>
                        <strong id="lblSoHopB2B" class="fs-4 chu-vang-kim">35 Hộp</strong>
                    </label>
                    <input type="range" class="form-range" id="sliderSoHopB2B" min="10" max="200" step="5" value="35" oninput="tinhGiaSiB2B(this.value)">

                    <div class="row g-3 mt-2 text-center">
                        <div class="col-4">
                            <div class="p-2 rounded bg-dark border border-secondary">
                                <small class="text-secondary d-block">Chiết khấu</small>
                                <strong id="lblPhanTramB2B" class="fs-4 text-warning">15%</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 rounded bg-dark border border-secondary">
                                <small class="text-secondary d-block">Khuôn Logo</small>
                                <strong id="lblLogoB2B" class="fs-6 text-success">MIỄN PHÍ</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 rounded bg-dark border border-secondary">
                                <small class="text-secondary d-block">Tiết kiệm ước tính</small>
                                <strong id="lblTietKiemB2B" class="fs-6 chu-vang-kim">3.150.000đ</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card-hoang-gia p-4">
                    <h5 class="font-co-phong fs-3 chu-vang-kim mb-3">Bảng Định Mức Chiết Khấu B2B Chính Thức</h5>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0">
                            <thead>
                                <tr class="chu-vang-kim">
                                    <th>Hạng Mức</th>
                                    <th>Số Lượng Hộp</th>
                                    <th>Chiết Khấu</th>
                                    <th>In Logo Công Ty</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var moc in Model.BangGiaSiB2B)
                                {
                                    <tr>
                                        <td class="fw-semibold">@moc.TenMocB2b</td>
                                        <td>@moc.SlhopToiThieu – @moc.SlhopToiDa hộp</td>
                                        <td><span class="badge bg-warning text-dark fw-bold">-@moc.PhanTramChietKhau%</span></td>
                                        <td>
                                            @if (moc.MienPhiInLogo)
                                            {
                                                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Miễn phí khuôn</span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary">Phụ phí @moc.PhiKhuonInLogo.ToString("N0")đ</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     TẦNG 6: TRẢI NGHIỆM THIỆP ĐIỆN TỬ QR 3D ĐA ĐIỂM NHẬN
     ========================================================================= -->
<section id="tang-thiep-qr" class="py-5">
    <div class="container py-3 text-center">
        <span class="text-uppercase small chu-vang-kim fw-bold">Gửi Trọn Tâm Giao Qua Công Nghệ</span>
        <h2 class="font-co-phong display-5 fw-bold chu-vang-kim mb-3">Thiệp Chúc Mừng QR 3D Cho Từng Điểm Nhận</h2>
        <p class="text-secondary mx-auto mb-4" style="max-width: 720px;">
            Một đơn hàng có thể chia thành nhiều đợt giao tới Ông Bà, Sếp, Đối tác. Mỗi hộp quà sẽ đính kèm một mã QR riêng biệt mở ra tấm thiệp 3D mang tên người nhận.
        </p>

        <div class="card-hoang-gia p-4 mx-auto" style="max-width: 680px;">
            <span class="badge badge-thuong-hang mb-2">Bản Xem Trước Thiệp Điện Tử Cổ Phong</span>
            <h4 class="font-co-phong fs-2 chu-vang-kim">"Kính chúc Gia đình mùa Trăng Rằm Đoàn Viên & An Khang"</h4>
            <p class="small text-light opacity-75 fst-italic mb-3">— Người gửi: Lê Minh Đức (Quét mã QR trên nắp hộp để mở hiệu ứng lật thiệp 3D) —</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="#tang-tu-chon-hop" class="btn btn-vang-kim rounded-pill px-4">Tạo Hộp Quà Kèm Thiệp QR Ngay</a>
            </div>
        </div>
    </div>
</section>

<!-- =========================================================================
     NGĂN KÉO GIỎ HÀNG KÉP (OFF-CANVAS CART DRAWER: GUEST & MEMBER)
     ========================================================================= -->
<div class="offcanvas offcanvas-end bg-dark text-light border-start border-warning" tabindex="-1" id="nganKeoGioHang">
    <div class="offcanvas-header border-bottom border-secondary">
        <div>
            <h5 class="offcanvas-title font-co-phong fs-3 chu-vang-kim">Giỏ Quà Trung Thu</h5>
            <small class="text-warning"><i class="bi bi-person-badge me-1"></i>Chế độ: @Model.HoTenHienThi (@Model.MaPhienHienTai)</small>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column justify-content-between">
        <div id="danhSachMonTrongGio" class="overflow-auto pe-1" style="max-height: 62vh;">
            @if (Model.GioHangHienTai != null && Model.GioHangHienTai.ChiTietGioHangs.Any())
            {
                foreach (var item in Model.GioHangHienTai.ChiTietGioHangs.OrderByDescending(c => c.NgayThem))
                {
                    string tenMon = item.LoaiSanPham == 3
                        ? (item.MaHopTcNavigation?.TenHopKhachDat ?? "Hộp Tự Phối")
                        : item.LoaiSanPham == 2
                            ? (item.MaCbNavigation?.TenCombo ?? "Combo Trung Thu")
                            : (item.MaBanhNavigation?.TenBanh ?? "Bánh Trung Thu");

                    <div class="p-3 mb-2 rounded card-hoang-gia">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <strong class="chu-vang-kim">@tenMon</strong>
                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2"
                                    onclick="xoaMonKhoiGio(@item.MaCtgh)" title="Xóa món này">
                                🗑️
                            </button>
                        </div>
                        @if (item.LoaiSanPham == 3 && item.MaHopTcNavigation != null)
                        {
                            <small class="text-info d-block mt-1">Mã cấu hình: @item.MaHopTcNavigation.MaBamCauHinh (@item.MaHopTcNavigation.TongCaloHop Kcal)</small>
                            if (item.MaHopTcNavigation.ChiTietHopTuChons != null && item.MaHopTcNavigation.ChiTietHopTuChons.Any())
                            {
                                <div class="small text-secondary mt-1" style="font-size: 0.75rem;">
                                    @string.Join(" • ", item.MaHopTcNavigation.ChiTietHopTuChons.OrderBy(x => x.ViTriOtrongHop).Select(x => $"Ô {x.ViTriOtrongHop}: {x.MaBanhNavigation?.TenBanh}"))
                                </div>
                            }
                        }
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-outline-warning px-2 py-0"
                                        onclick="capNhatSoLuongMon(@item.MaCtgh, @(item.SoLuong - 1))">
                                    -
                                </button>
                                <span class="btn btn-dark border-warning text-light px-3 py-0 disabled">@item.SoLuong</span>
                                <button type="button" class="btn btn-outline-warning px-2 py-0"
                                        onclick="capNhatSoLuongMon(@item.MaCtgh, @(item.SoLuong + 1))">
                                    +
                                </button>
                            </div>
                            <div class="fw-bold text-warning">@((item.SoLuong * item.DonGiaTamTinh).ToString("N0")) đ</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-secondary py-5">Giỏ quà đang trống. Hãy tự phối hộp bánh ở Tầng 3!</div>
            }
        </div>

        <div class="border-top border-secondary pt-3">
            @if (!Model.DaDangNhap)
            {
                <div class="alert alert-warning py-2 small mb-2 d-flex justify-content-between align-items-center gap-2">
                    <span><i class="bi bi-info-circle-fill me-1"></i>Chế độ <strong>Khách vãng lai</strong>. Đăng nhập để gộp giỏ & tích điểm!</span>
                    <button type="button" class="btn btn-sm btn-dark text-warning border-warning text-nowrap"
                            data-bs-toggle="modal" data-bs-target="#modalTaiKhoan">
                        Gộp Giỏ Ngay
                    </button>
                </div>
            }

            <!-- Khu vực nhập Mã Giảm Giá / Voucher -->
            <div class="p-2 mb-3 rounded bg-dark border border-secondary">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <small class="text-warning fw-semibold"><i class="bi bi-ticket-perforated-fill me-1"></i>Mã Khuyến Mãi:</small>
                    <button type="button" class="badge bg-warning text-dark border-0" style="cursor:pointer;"
                            onclick="chonNhanhVoucher('TRANGTRON2026')">
                        ⚡ Dùng mã TRANGTRON2026 (-10%)
                    </button>
                </div>
                <div class="input-group input-group-sm">
                    <input type="text" id="txtMaVoucherGioHang" class="form-control bg-dark text-light border-secondary text-uppercase"
                           placeholder="Nhập mã (VD: TRANGTRON2026)" value="@(Model.GioHangHienTai?.CodeKmdangApDung ?? "")" />
                    <button class="btn btn-vien-vang px-3" type="button" onclick="apDungVoucherGioHang()">
                        Áp Dụng
                    </button>
                </div>
                <small id="lblThongBaoVoucher" class="d-block mt-1 text-info" style="font-size: 0.75rem;"></small>
            </div>

            <div class="d-flex justify-content-between small text-light mb-1">
                <span>Tạm tính:</span>
                <span id="lblTamTinhOffcanvas" class="fw-semibold">@Model.TongTamTinhGioHang.ToString("N0") đ</span>
            </div>
            <div class="d-flex justify-content-between small text-success mb-2">
                <span>Giảm giá Voucher:</span>
                <span id="lblTienGiamVoucherOffcanvas" class="fw-semibold">-0 đ</span>
            </div>
            <div class="d-flex justify-content-between fs-5 fw-bold mb-3 pt-2 border-top border-secondary">
                <span>Tổng thanh toán:</span>
                <span id="lblTongThanhToanSauGiam" class="chu-vang-kim">@Model.TongTamTinhGioHang.ToString("N0") đ</span>
            </div>
            <button class="btn btn-vang-kim w-100 py-2 rounded-pill">
                Tiến Hành Thanh Toán (Guest / Member)
            </button>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL TRỢ LÝ CHỌN BÁNH 30 GIÂY (WEIGHTED SCORING QUIZ)
     ========================================================================= -->
<div class="modal fade" id="modalTroLyChonBanh" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content card-hoang-gia text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title font-co-phong fs-2 chu-vang-kim">
                    🤖 Trợ Lý Chấm Điểm Trọng Số Chọn Quà Trung Thu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small text-warning">1. Bạn muốn biếu tặng ai?</label>
                        <select id="quizDoiTuong" class="form-select bg-dark text-light border-secondary">
                            <option value="ONG_BA">Ông Bà / Cha Mẹ (Người lớn tuổi)</option>
                            <option value="SEP_VIP">Sếp / Đối tác VIP</option>
                            <option value="BAN_BE">Bạn bè / Đồng nghiệp trẻ</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-warning">2. Ưu tiên chế độ sức khỏe?</label>
                        <select id="quizSucKhoe" class="form-select bg-dark text-light border-secondary">
                            <option value="TIEU_DUONG">Ăn kiêng / Tiểu đường (Ưu tiên đường Isomalt GI thấp)</option>
                            <option value="AN_CHAY">Thuần chay 100%</option>
                            <option value="BINH_THUONG">Bình thường</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-warning">3. Gu thưởng thức yêu thích?</label>
                        <select id="quizHuongVi" class="form-select bg-dark text-light border-secondary">
                            <option value="NGOT_HIENDAI">Ngọt thanh hạt sen / Đậu xanh</option>
                            <option value="THUONG_HANG">Mặn thượng hạng (Bào ngư, Hải sản)</option>
                            <option value="LAVA_CHAY">Nhân chảy Kim sa Lava</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-warning">4. Ngân sách dự kiến cho hộp 4 bánh?</label>
                        <select id="quizNganSach" class="form-select bg-dark text-light border-secondary">
                            <option value="500000">Dưới 500.000 đ</option>
                            <option value="800000" selected>Khoảng 500.000đ – 800.000 đ</option>
                            <option value="1500000">Cao cấp trên 800.000 đ</option>
                        </select>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <button class="btn btn-vang-kim px-5 rounded-pill" onclick="chayThuatToanGoiY()">
                        <i class="bi bi-cpu-fill me-1"></i> Chấm Điểm & Đề Xuất Top 3 Vị Bánh
                    </button>
                </div>

                <div id="ketQuaQuizContainer" class="row g-3 mt-3"></div>
            </div>
        </div>
    </div>
</div>