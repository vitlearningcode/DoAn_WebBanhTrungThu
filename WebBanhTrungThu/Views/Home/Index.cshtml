</section>

    </div>
</div>

<!-- =========================================================================
     NGĂN KÉO GIỎ QUÀ TRUNG THU (OFF-CANVAS CART DRAWER)
     ========================================================================= -->
<div class="offcanvas offcanvas-end" style="background: var(--mau-nen-giay-do); color: var(--mau-chu-nau-tram); border-left: 2px solid var(--mau-vang-dong-co);" tabindex="-1" id="nganKeoGioHang">
    <div class="offcanvas-header nen-le-hoi-son-mai border-bottom" style="border-color: rgba(212, 175, 55, 0.4) !important;">
        <div>
            <h5 class="offcanvas-title font-co-phong fs-3 fw-bold chu-vang-kim">🏮 Giỏ Quà Trung Thu</h5>
            <small class="chu-kem-vang"><i class="bi bi-person-heart me-1"></i>Khách hàng: @Model.HoTenHienThi</small>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column justify-content-between">
        <div id="danhSachMonTrongGio" class="overflow-auto pe-1" style="max-height: 62vh;">
            @if (Model.GioHangHienTai != null && Model.GioHangHienTai.ChiTietGioHangs.Any())
            {
                foreach (var item in Model.GioHangHienTai.ChiTietGioHangs.OrderByDescending(c => c.NgayThem))
                {
                    string tenMon = item.LoaiSanPham == 3
                        ? (item.MaHopTcNavigation?.TenHopKhachDat ?? "Hộp Tự Phối")
                        : item.LoaiSanPham == 2
                            ? (item.MaCbNavigation?.TenCombo ?? "Combo Trung Thu")
                            : (item.MaBanhNavigation?.TenBanh ?? "Bánh Trung Thu");

                    <div class="p-3 mb-2 rounded card-hoang-gia">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <strong class="chu-do-son-mai">@tenMon</strong>
                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2"
                                    onclick="xoaMonKhoiGio(@item.MaCtgh)" title="Xóa món này">
                                🗑️
                            </button>
                        </div>
                        @if (item.LoaiSanPham == 3 && item.MaHopTcNavigation != null)
                        {
                            <small class="chu-nau-phu d-block mt-1">Ký hiệu hộp lễ: @item.MaHopTcNavigation.MaBamCauHinh (@item.MaHopTcNavigation.TongCaloHop Kcal)</small>
                            if (item.MaHopTcNavigation.ChiTietHopTuChons != null && item.MaHopTcNavigation.ChiTietHopTuChons.Any())
                            {
                                <div class="small chu-nau-phu mt-1" style="font-size: 0.75rem;">
                                    @string.Join(" • ", item.MaHopTcNavigation.ChiTietHopTuChons.OrderBy(x => x.ViTriOtrongHop).Select(x => $"Ô {x.ViTriOtrongHop}: {x.MaBanhNavigation?.TenBanh}"))
                                </div>
                            }
                        }
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top" style="border-color: var(--mau-vien-vang-dong) !important;">
                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-vien-vang px-2 py-0"
                                        onclick="capNhatSoLuongMon(@item.MaCtgh, @(item.SoLuong - 1))">
                                    -
                                </button>
                                <span class="btn px-3 py-0 disabled fw-bold" style="background: var(--mau-nen-ngoc-trai); color: var(--mau-chu-nau-tram); border-color: var(--mau-vang-dong-co);">@item.SoLuong</span>
                                <button type="button" class="btn btn-vien-vang px-2 py-0"
                                        onclick="capNhatSoLuongMon(@item.MaCtgh, @(item.SoLuong + 1))">
                                    +
                                </button>
                            </div>
                            <div class="fw-bold chu-do-son-mai">@((item.SoLuong * item.DonGiaTamTinh).ToString("N0")) đ</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center chu-nau-phu py-5">Giỏ quà đang trống. Mời bạn chọn bánh hoặc tự phối lễ hộp!</div>
            }
        </div>

        <div class="border-top pt-3" style="border-color: var(--mau-vien-vang-dong) !important;">
            @if (!Model.DaDangNhap)
            {
                <div class="p-2 rounded small mb-2 d-flex justify-content-between align-items-center gap-2" style="background: var(--mau-nen-ngoc-trai); border: 1px solid var(--mau-vang-dong-co);">
                    <span class="chu-nau-tram"><i class="bi bi-gift-fill chu-do-son-mai me-1"></i>Đăng nhập hội viên để lưu giỏ quà &amp; tích điểm thưởng!</span>
                    <button type="button" class="btn btn-sm btn-do-son-mai rounded-pill text-nowrap"
                            data-bs-toggle="modal" data-bs-target="#modalTaiKhoan">
                        Đăng Nhập
                    </button>
                </div>
            }

            <!-- Khu vực nhập Mã Giảm Giá / Voucher -->
            <div class="p-2 mb-3 rounded" style="background: #FFFFFF; border: 1px solid var(--mau-vien-vang-dong);">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <small class="chu-do-son-mai fw-bold"><i class="bi bi-ticket-perforated-fill me-1"></i>Mã Ưu Đãi Lễ Hội:</small>
                    <button type="button" class="badge badge-thuong-hang border-0" style="cursor:pointer;"
                            onclick="chonNhanhVoucher('TRANGTRON2026')">
                        ⚡ Áp mã TRANGTRON2026 (-10%)
                    </button>
                </div>
                <div class="input-group input-group-sm">
                    <input type="text" id="txtMaVoucherGioHang" class="form-control text-uppercase" style="border-color: var(--mau-vien-vang-dong);"
                           placeholder="Nhập mã (VD: TRANGTRON2026)" value="@(Model.GioHangHienTai?.CodeKmdangApDung ?? "")" />
                    <button class="btn btn-do-son-mai px-3" type="button" onclick="apDungVoucherGioHang()">
                        Áp Dụng
                    </button>
                </div>
                <small id="lblThongBaoVoucher" class="d-block mt-1 text-success" style="font-size: 0.75rem;"></small>
            </div>

            <div class="d-flex justify-content-between small chu-nau-phu mb-1">
                <span>Tạm tính:</span>
                <span id="lblTamTinhOffcanvas" class="fw-semibold chu-nau-tram">@Model.TongTamTinhGioHang.ToString("N0") đ</span>
            </div>
            <div class="d-flex justify-content-between small text-success mb-2">
                <span>Ưu đãi Voucher:</span>
                <span id="lblTienGiamVoucherOffcanvas" class="fw-semibold">-0 đ</span>
            </div>
            <div class="d-flex justify-content-between fs-5 fw-bold mb-3 pt-2 border-top" style="border-color: var(--mau-vien-vang-dong) !important;">
                <span class="chu-nau-tram">Tổng thanh toán:</span>
                <span id="lblTongThanhToanSauGiam" class="chu-do-son-mai">@Model.TongTamTinhGioHang.ToString("N0") đ</span>
            </div>
            <a href="/ThanhToan/Index" id="btnTienHanhThanhToanOffcanvas"
               class="btn btn-do-son-mai w-100 py-2 rounded-pill text-decoration-none d-block text-center"
               onclick="return chuyenDenTrangThanhToan(event)">
                <i class="bi bi-shield-check me-1"></i>Tiến Hành Đặt Quà &amp; Ghi Thiệp
            </a>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL NGHỆ NHÂN TƯ VẤN CHỌN VỊ BÁNH THEO GU THƯỞNG THỨC
     ========================================================================= -->
<div class="modal fade" id="modalTroLyChonBanh" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content card-hoang-gia">
            <div class="modal-header nen-le-hoi-son-mai border-bottom" style="border-color: var(--mau-vang-dong-co) !important; border-radius: 15px 15px 0 0;">
                <h5 class="modal-title font-co-phong fs-2 fw-bold chu-vang-kim">
                    ✨ Nghệ Nhân Tư Vấn Chọn Vị Bánh Theo Gu Thưởng Thức
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold chu-do-son-mai">1. Bạn muốn biếu tặng ai?</label>
