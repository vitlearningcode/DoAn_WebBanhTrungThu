@model WebBanhTrungThu.ViewModels.LandingPageViewModel
@using WebBanhTrungThu.Services
@using System.Text.Json
@{
    string anhHero = !string.IsNullOrWhiteSpace(Model.HeroBanner?.MaAnhNenNavigation?.UrlHienThi)
        ? Model.HeroBanner.MaAnhNenNavigation.UrlHienThi
        : "/images/landing/hero-banner-trungthu.jpg";

    string tieuDePhuHero = !string.IsNullOrWhiteSpace(Model.HeroBanner?.TieuDePhu)
        ? Model.HeroBanner.TieuDePhu
        : "BỘ SƯU TẬP LỄ HỘP TRUNG THU CỔ TRUYỀN 2026";
    string tieuDeChinhHero = !string.IsNullOrWhiteSpace(Model.HeroBanner?.TieuDeChinh)
        ? Model.HeroBanner.TieuDeChinh
        : "Tuyệt Tác Trăng Rằm – Tự Tay Kiến Tạo Lễ Hộp Độc Bản";
    string moTaHero = !string.IsNullOrWhiteSpace(Model.HeroBanner?.NoiDungMoTa)
        ? Model.HeroBanner.NoiDungMoTa
        : "Hội tụ tinh hoa bánh nướng, bánh dẻo cổ truyền từ Kinh Đô, Đồng Khánh, Như Lan, Brodard cùng dòng bánh thực dưỡng đường Isomalt thanh tao cho mùa Trăng Đoàn Viên trọn vẹn.";
    string chuNutCtaHero = !string.IsNullOrWhiteSpace(Model.HeroBanner?.ChuNutBamCta)
        ? Model.HeroBanner.ChuNutBamCta
        : "Tự Phối Hộp Quà Ngay";
    string duongDanCtaHero = !string.IsNullOrWhiteSpace(Model.HeroBanner?.DuongDanCta)
        ? Model.HeroBanner.DuongDanCta
        : "#tang-tu-chon-hop";
    DateTime? mocDemNguocSql = Model.HeroBanner?.MocThoiGianDemNguoc;
    string mocDemNguocIso = mocDemNguocSql?.ToString("yyyy-MM-ddTHH:mm:ss") ?? string.Empty;

    var banhVip = Model.DanhSachBanh.FirstOrDefault(b => b.LaBanhThuongHang);
    string anhVip = banhVip != null
        ? DichVuHinhAnh.LayUrl(Model.TuDienAnh, "BANH", banhVip.MaBanh, "TACH_NEN_SLOT")
        : "/images/banh/slot-bao-ngu.png";
    if (string.IsNullOrWhiteSpace(anhVip) || anhVip == anhHero)
    {
        anhVip = "/images/banh/slot-bao-ngu.png";
    }

    var banhIsomalt = Model.DanhSachBanh.FirstOrDefault(b => b.MucDoNgot == "ISOMALT_TIEUDUONG" || b.MucDoNgot == "DUONG_ISOMALT");
    string anhIsomalt = banhIsomalt != null
        ? DichVuHinhAnh.LayUrl(Model.TuDienAnh, "BANH", banhIsomalt.MaBanh, "TACH_NEN_SLOT")
        : "/images/banh/slot-sua-dua-chay.png";
    if (string.IsNullOrWhiteSpace(anhIsomalt) || anhIsomalt == anhVip || anhIsomalt.Contains("banh-mac-dinh", StringComparison.OrdinalIgnoreCase))
    {
        anhIsomalt = "/images/banh/slot-sua-dua-chay.png";
    }

    string anhB2B = DichVuHinhAnh.LayUrl(Model.TuDienAnh, "VOHOP", 2, "KHAY_HOP_RONG");
    if (string.IsNullOrWhiteSpace(anhB2B) || anhB2B.Contains("vohop-mac-dinh"))
    {
        anhB2B = "/images/vohop/khay-6-o-rong.png";
    }

    var danhSachSlideHero = new[]
    {
        new
        {
            tieuDe = "Lễ Hộp Sơn Mài Tứ Quý Đoàn Viên",
            moTa = "Tự do phối 4 hoặc 6 vị bánh danh tiếng • Cân đối năng lượng & độ ngọt thanh",
            nhan = "Ưu đãi đặt sớm -10% (Mã: TRANGTRON2026)",
            anh = anhHero,
            fit = anhHero.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "contain" : "cover"
        },
        new
        {
            tieuDe = "Lễ Hộp Hoàng Gia Ngự Phẩm 6 Bánh",
            moTa = "Tráp sơn mài 6 ô tuyển chọn nhân thượng hạng • Quà biếu đối tác trọng thị",
            nhan = "Phiên bản Ngự Phẩm 6 Ô",
            anh = anhVip,
            fit = anhVip.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "contain" : "cover"
        },
        new
        {
            tieuDe = "Bộ Sưu Tập Bánh Đường Ăn Kiêng Isomalt",
            moTa = "Chỉ số đường huyết GI thấp • Vị ngọt thanh tao cho người lớn tuổi & thực dưỡng",
            nhan = "Thực dưỡng Đường Isomalt",
            anh = anhIsomalt,
            fit = anhIsomalt.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "contain" : "cover"
        },
        new
        {
            tieuDe = "Quà Biếu Doanh Nghiệp Ép Kim Logo",
            moTa = "Chiết khấu số lượng lớn đến 22% • Miễn phí khuôn ép kim Logo từ 20 hộp",
            nhan = "Ưu đãi Chiết khấu Số Lượng Lớn",
            anh = anhB2B,
            fit = anhB2B.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "contain" : "cover"
        }
    };

    string slidesJson = JsonSerializer.Serialize(danhSachSlideHero);
}

<!-- =========================================================================
     TẦNG 1 (01): HERO BANNER LỄ HỘI TRUNG THU TRUYỀN THỐNG & ĐẾM NGƯỢC ĐOÀN VIÊN
     ========================================================================= -->
<section id="tang-hero" class="tang-phan-khu nen-le-hoi-son-mai" style="background: linear-gradient(135deg, rgba(110, 13, 16, 0.94) 0%, rgba(74, 7, 9, 0.90) 100%), url('@anhHero') center/cover no-repeat;">
    <div class="container py-3 section-reveal active">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(212, 175, 55, 0.16); border: 1px solid var(--mau-vang-anh-kim);">
                    <span class="chu-vang-kim small fw-semibold">🏮 @tieuDePhuHero</span>
                </div>

                <h1 class="font-co-phong display-4 fw-bold chu-vang-kim mb-3">
                    @tieuDeChinhHero
                </h1>

                <p class="lead chu-kem-vang opacity-90 mb-4">
                    @moTaHero
                </p>

                <!-- Đồng hồ đếm ngược Đêm Rằm Trung Thu -->
                <div class="mb-2">
                    <span class="d-inline-block small fw-bold text-uppercase chu-vang-kim" style="letter-spacing: 0.85px; font-size: 0.78rem;">
                        ⏳ ĐẾM NGƯỢC ĐẾN ĐÊM HỘI TRĂNG RẰM @(mocDemNguocSql.HasValue ? $"({mocDemNguocSql.Value:dd/MM/yyyy HH:mm})" : "(15/08 ÂM LỊCH)"):
                    </span>
                </div>
                <div id="khungDemNguocHero" class="d-flex flex-wrap gap-3 mb-4" data-moc-dem-nguoc="@mocDemNguocIso">
                    <div class="card-son-mai-noi px-3 py-2 text-center" style="min-width: 78px;">
                        <span id="cd-ngay" class="fs-3 fw-bold chu-vang-kim d-block">--</span>
                        <small class="chu-kem-vang opacity-75">Ngày</small>
                    </div>
                    <div class="card-son-mai-noi px-3 py-2 text-center" style="min-width: 78px;">
                        <span id="cd-gio" class="fs-3 fw-bold chu-vang-kim d-block">--</span>
                        <small class="chu-kem-vang opacity-75">Giờ</small>
                    </div>
                    <div class="card-son-mai-noi px-3 py-2 text-center" style="min-width: 78px;">
                        <span id="cd-phut" class="fs-3 fw-bold chu-vang-kim d-block">--</span>
                        <small class="chu-kem-vang opacity-75">Phút</small>
                    </div>
                    <div class="card-son-mai-noi px-3 py-2 text-center" style="min-width: 78px;">
                        <span id="cd-giay" class="fs-3 fw-bold chu-vang-kim d-block">--</span>
                        <small class="chu-kem-vang opacity-75">Giây</small>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-3">
                    <a href="@duongDanCtaHero"
                       @if (duongDanCtaHero.StartsWith("#")) { <text>onclick="return cuonDenPhanKhu('@duongDanCtaHero', event)"</text> }
                       class="btn btn-vang-kim btn-lg rounded-pill px-4">
                        <i class="bi bi-box2-heart-fill me-2"></i>@chuNutCtaHero
                    </a>
                    <button class="btn btn-vien-vang btn-lg rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalTroLyChonBanh">
                        ✨ Tư Vấn Chọn Hộp Quà Hợp Ý
                    </button>
                </div>
            </div>

            <div class="col-lg-5 text-center">
                <div class="card-hoang-gia p-3 p-md-4 position-relative">
                    <!-- Lucian UX/UI Prompt #258 · MIT License (c) 2026 Seokwoooo · https://lucianlabs.dev/uxui-prompt/#258 -->
                    <div id="heroBannerSlider258" class="u258" data-slides="@slidesJson">
                        <div class="d-flex justify-content-center align-items-center mb-2">
                            <span id="heroSlideBadge258" class="badge badge-thuong-hang px-3 py-2 rounded-pill text-truncate" style="max-width: 100%;">
                                Ưu đãi đặt sớm -10% (Mã: TRANGTRON2026)
                            </span>
                        </div>

                        <div class="u258-stage">
                            <div id="u258Progress" class="u258-pg" aria-hidden="true"></div>
                            <img id="u258Image"
                                 src="@anhHero"
                                 class="u258-img"
                                 data-fit="@(anhHero.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? "contain" : "cover")"
                                 alt="Lễ Hộp Sơn Mài Tứ Quý Đoàn Viên" />
                            <div id="u258Caption" class="u258-cp">
                                <span id="u258CaptionIndex" class="u258-cp-index">01 / 04</span>
                                <h4 id="u258CaptionTitle" class="font-co-phong u258-cp-title mb-0">Lễ Hộp Sơn Mài Tứ Quý Đoàn Viên</h4>
                            </div>
                            <button type="button" id="btnPrevSlide258" class="u258-arrow u258-arrow-prev" aria-label="Banner trước">‹</button>
                            <button type="button" id="btnNextSlide258" class="u258-arrow u258-arrow-next" aria-label="Banner tiếp theo">›</button>
                        </div>

                        <p id="u258SlideDesc" class="small chu-nau-phu mt-2 mb-2 px-1" style="min-height: 2.6em; line-height: 1.35;">
                            Tự do phối 4 hoặc 6 vị bánh danh tiếng • Cân đối năng lượng &amp; độ ngọt thanh
                        </p>

                        <div id="u258Dots" class="u258-dots" role="tablist" aria-label="Chọn bộ sưu tập lễ hộp">
                            <button type="button" class="u258-dot active" data-index="0" aria-label="Slide 1"></button>
                            <button type="button" class="u258-dot" data-index="1" aria-label="Slide 2"></button>
                            <button type="button" class="u258-dot" data-index="2" aria-label="Slide 3"></button>
                            <button type="button" class="u258-dot" data-index="3" aria-label="Slide 4"></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
