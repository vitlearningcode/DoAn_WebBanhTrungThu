@model WebBanhTrungThu.ViewModels.HoSoThanhVienViewModel
@{
    string tabMacDinh = Model.TabMacDinh;
}

<div class="pane-ho-so @(tabMacDinh == "DIA_CHI" ? "dang-hien" : "")" id="tab-so-dia-chi" role="tabpanel" aria-labelledby="nut-tab-so-dia-chi">
    <div class="dau-pane-ho-so dau-pane-co-nut">
        <div>
            <h2 class="tieu-de-pane-ho-so">Sổ địa chỉ nhận quà</h2>
            <p class="mo-ta-pane-ho-so">Lưu sẵn địa chỉ người thân, đối tác để chọn nhanh khi đặt quà.</p>
        </div>
        <button type="button" class="btn btn-do-son-mai rounded-pill px-3 nut-khong-ep"
                data-bs-toggle="collapse" data-bs-target="#khungFormThemDiaChi"
                aria-expanded="@(Model.TongSoDiaChi == 0 ? "true" : "false")" aria-controls="khungFormThemDiaChi">
            + Thêm địa chỉ nhận quà mới
        </button>
    </div>

    <div class="collapse @(Model.TongSoDiaChi == 0 ? "show" : "")" id="khungFormThemDiaChi">
        <div class="khung-form-dia-chi-ho-so">
            <form asp-controller="TaiKhoan" asp-action="ThemDiaChiMoi" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-12">
                        <label class="nhan-input-ho-so" for="txtNhanDiaChi">Nhãn gợi nhớ</label>
                        <input type="text" id="txtNhanDiaChi" name="nhanDiaChi" class="form-control input-ho-so"
                               placeholder="VD: Nhà riêng, Công ty, Biếu Ông Bà Nội" required />
                    </div>
                    <div class="col-md-7">
                        <label class="nhan-input-ho-so" for="txtTenNguoiNhan">Họ tên người nhận</label>
                        <input type="text" id="txtTenNguoiNhan" name="tenNguoiNhan" class="form-control input-ho-so"
                               placeholder="Nhập tên người nhận" required />
                    </div>
                    <div class="col-md-5">
                        <label class="nhan-input-ho-so" for="txtSdtNguoiNhan">Số điện thoại</label>
                        <input type="tel" id="txtSdtNguoiNhan" name="sdtNguoiNhan" class="form-control input-ho-so"
                               placeholder="09xx xxx xxx" required />
                    </div>
                    <div class="col-md-4">
                        <label class="nhan-input-ho-so" for="txtTinhThanh">Tỉnh / Thành</label>
                        <input type="text" id="txtTinhThanh" name="tinhThanh" class="form-control input-ho-so"
                               value="TP. Hồ Chí Minh" required />
                    </div>
                    <div class="col-md-4">
                        <label class="nhan-input-ho-so" for="txtQuanHuyen">Quận / Huyện</label>
                        <input type="text" id="txtQuanHuyen" name="quanHuyen" class="form-control input-ho-so"
                               placeholder="Quận 1" required />
                    </div>
                    <div class="col-md-4">
                        <label class="nhan-input-ho-so" for="txtPhuongXa">Phường / Xã</label>
                        <input type="text" id="txtPhuongXa" name="phuongXa" class="form-control input-ho-so"
                               placeholder="Phường Bến Nghé" required />
                    </div>
                    <div class="col-12">
                        <label class="nhan-input-ho-so" for="txtDiaChiCuThe">Số nhà, tên đường</label>
                        <input type="text" id="txtDiaChiCuThe" name="diaChiCuThe" class="form-control input-ho-so"
                               placeholder="VD: 128 Nguyễn Huệ" required />
                    </div>
                </div>

                <div class="dong-cuoi-form-dia-chi">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" name="laMacDinh" value="true" id="chkDiaChiMacDinh" />
                        <label class="form-check-label" for="chkDiaChiMacDinh">Đặt làm địa chỉ mặc định</label>
                    </div>
                    <button type="submit" class="btn btn-do-son-mai rounded-pill px-4 nut-khong-ep">
                        Lưu vào sổ địa chỉ
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.DanhSachSoDiaChi.Any())
    {
        <div class="khung-trong-ho-so khung-trong-gon">
            <i class="bi bi-geo-alt" aria-hidden="true"></i>
            <h3>Sổ địa chỉ đang trống</h3>
            <p>Thêm địa chỉ đầu tiên ở biểu mẫu phía trên để chọn nhanh khi thanh toán.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var dc in Model.DanhSachSoDiaChi)
            {
                <div class="col-md-6">
                    <div class="the-dia-chi-ho-so @(dc.LaMacDinh ? "la-mac-dinh" : "")">
                        <div class="dau-the-dia-chi">
                            <div class="nhom-nhan-dia-chi">
                                <span class="nhan-goi-nho-dia-chi">@(dc.NhanDiaChi ?? "Địa chỉ biếu tặng")</span>
                                @if (dc.LaMacDinh)
                                {
                                    <span class="huy-hieu-mac-dinh">Mặc định</span>
                                }
                            </div>
                            <form asp-controller="TaiKhoan" asp-action="XoaDiaChi" method="post"
                                  onsubmit="return confirm('Xóa địa chỉ này khỏi Sổ địa chỉ?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maDc" value="@dc.MaDc" />
                                <button type="submit" class="nut-xoa-dia-chi" aria-label="Xóa địa chỉ @dc.TenNguoiNhan">
                                    Xóa
                                </button>
                            </form>
                        </div>
                        <div class="ten-sdt-dia-chi">
                            <strong>@dc.TenNguoiNhan</strong>
                            <span>@dc.SdtnguoiNhan</span>
                        </div>
                        <div class="dia-chi-chi-tiet-ho-so">
                            @dc.DiaChiCuThe, @dc.PhuongXa, @dc.QuanHuyen, @dc.TinhThanh
                        </div>

                        <div class="chan-the-dia-chi">
                            <button type="button"
                                    class="nut-sua-dia-chi"
                                    data-madc="@dc.MaDc"
                                    data-nhan="@(dc.NhanDiaChi ?? "")"
                                    data-ten="@dc.TenNguoiNhan"
                                    data-sdt="@dc.SdtnguoiNhan"
                                    data-tinhthanh="@dc.TinhThanh"
                                    data-quanhuyen="@dc.QuanHuyen"
                                    data-phuongxa="@dc.PhuongXa"
                                    data-diachi="@dc.DiaChiCuThe"
                                    data-macdinh="@(dc.LaMacDinh ? "true" : "false")"
                                    onclick="moModalSuaDiaChi(this)">
                                <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Chỉnh sửa
                            </button>

                            @if (!dc.LaMacDinh)
                            {
                                <form asp-controller="TaiKhoan" asp-action="DatDiaChiMacDinh" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="maDiaChi" value="@dc.MaDc" />
                                    <button type="submit" class="nut-mac-dinh-dia-chi">
                                        Đặt mặc định
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<div class="modal fade" id="modalSuaDiaChi" tabindex="-1" aria-labelledby="tieuDeModalSuaDiaChi" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 16px; background: #FFFDF9;">
            <form asp-controller="TaiKhoan" asp-action="SuaDiaChi" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="suaMaDiaChi" name="maDiaChi" value="0" />
                <div class="modal-header border-bottom" style="border-color: #EADBC8 !important;">
                    <h5 class="modal-title font-co-phong fs-4 fw-bold chu-do-son-mai" id="tieuDeModalSuaDiaChi">
                        Chỉnh sửa địa chỉ nhận quà
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="nhan-input-ho-so" for="suaNhanGoiNho">Nhãn gợi nhớ</label>
                            <input type="text" id="suaNhanGoiNho" name="nhanGoiNho" class="form-control input-ho-so"
                                   placeholder="VD: Nhà riêng, Công ty, Biếu Ông Bà" required />
                        </div>
                        <div class="col-md-7">
                            <label class="nhan-input-ho-so" for="suaNguoiNhan">Họ tên người nhận</label>
                            <input type="text" id="suaNguoiNhan" name="nguoiNhan" class="form-control input-ho-so" required />
                        </div>
                        <div class="col-md-5">
                            <label class="nhan-input-ho-so" for="suaSdtNhan">Số điện thoại</label>
                            <input type="tel" id="suaSdtNhan" name="sdtNhan" class="form-control input-ho-so" required />
                        </div>
                        <div class="col-md-4">
                            <label class="nhan-input-ho-so" for="suaTinhThanh">Tỉnh / Thành</label>
                            <input type="text" id="suaTinhThanh" name="tinhThanh" class="form-control input-ho-so" required />
                        </div>
                        <div class="col-md-4">
                            <label class="nhan-input-ho-so" for="suaQuanHuyen">Quận / Huyện</label>
                            <input type="text" id="suaQuanHuyen" name="quanHuyen" class="form-control input-ho-so" required />
                        </div>
                        <div class="col-md-4">
                            <label class="nhan-input-ho-so" for="suaPhuongXa">Phường / Xã</label>
                            <input type="text" id="suaPhuongXa" name="phuongXa" class="form-control input-ho-so" required />
                        </div>
                        <div class="col-12">
                            <label class="nhan-input-ho-so" for="suaDiaChiChiTiet">Số nhà, tên đường</label>
                            <input type="text" id="suaDiaChiChiTiet" name="diaChiChiTiet" class="form-control input-ho-so" required />
                        </div>
                        <div class="col-12">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="suaLaMacDinh" name="laMacDinh" value="true" />
                                <label class="form-check-label" for="suaLaMacDinh">Đặt làm địa chỉ mặc định</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top" style="border-color: #EADBC8 !important;">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-do-son-mai rounded-pill px-4">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    window.moModalSuaDiaChi = function (btn) {
        if (!btn) return;
        const modalEl = document.getElementById("modalSuaDiaChi");
        if (!modalEl) return;

        if (modalEl.parentElement !== document.body) {
            document.body.appendChild(modalEl);
        }

        document.getElementById("suaMaDiaChi").value = btn.dataset.madc || "0";
        document.getElementById("suaNhanGoiNho").value = btn.dataset.nhan || "";
        document.getElementById("suaNguoiNhan").value = btn.dataset.ten || "";
        document.getElementById("suaSdtNhan").value = btn.dataset.sdt || "";
        document.getElementById("suaTinhThanh").value = btn.dataset.tinhthanh || "";
        document.getElementById("suaQuanHuyen").value = btn.dataset.quanhuyen || "";
        document.getElementById("suaPhuongXa").value = btn.dataset.phuongxa || "";
        document.getElementById("suaDiaChiChiTiet").value = btn.dataset.diachi || "";
        document.getElementById("suaLaMacDinh").checked = btn.dataset.macdinh === "true";

        bootstrap.Modal.getOrCreateInstance(modalEl).show();
    };
</script>
