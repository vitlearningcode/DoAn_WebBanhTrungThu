<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nguyệt Cát Nghệ Thuật Trung Thu 2026</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- TẦNG 1: STICKY GLASSMORPHISM NAVBAR -->
    <header class="sticky-top navbar-kinh-mo">
        <nav class="navbar navbar-expand-lg navbar-dark container py-2">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <span class="fs-3">🌕</span>
                <div>
                    <span class="font-co-phong fs-3 fw-bold chu-vang-kim d-block lh-1">NGUYỆT CÁT</span>
                    <small class="text-light opacity-75" style="font-size: 0.7rem; letter-spacing: 2px;">TINH HOA TRĂNG RẰM</small>
                </div>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuChinh">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuChinh">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-3">
                    <li class="nav-item">
                        <a class="nav-link text-light fw-medium" href="#tang-hero">Câu Chuyện</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link chu-vang-kim fw-bold" href="#tang-tu-chon-hop">
                            <i class="bi bi-box2-heart-fill me-1"></i>Tự Phối Hộp 3D
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light fw-medium" href="#tang-bo-suu-tap">Bộ Sưu Tập & Dinh Dưỡng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light fw-medium" href="#tang-b2b">Chiết Khấu B2B</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light fw-medium" href="#tang-thiep-qr">Thiệp QR 3D</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <!-- Nút Tra cứu đơn dành cho cả Guest & Member -->
                    <button class="btn btn-sm btn-vien-vang rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalTraCuuDon">
                        <i class="bi bi-search me-1"></i>Tra Đơn Guest
                    </button>

                    <!-- Nút mở Ngăn kéo Giỏ hàng Kép -->
                    <button class="btn btn-sm btn-vang-kim rounded-pill px-3 position-relative" data-bs-toggle="offcanvas" data-bs-target="#nganKeoGioHang">
                        <i class="bi bi-bag-heart-fill me-1"></i>Giỏ Quà
                        <span id="badgeSoLuongGio" class="badge bg-danger rounded-pill ms-1">2</span>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <!-- NÚT NỔI KÍCH HOẠT TRỢ LÝ CHỌN QUÀ 30 GIÂY -->
    <button class="floating-quiz-btn" data-bs-toggle="modal" data-bs-target="#modalTroLyChonBanh">
        <i class="bi bi-stars me-1"></i> Trợ Lý Chọn Bánh 30s
    </button>

    <!-- MODAL TRA CỨU ĐƠN HÀNG NHANH CHO KHÁCH VÃNG LAI -->
    <div class="modal fade" id="modalTraCuuDon" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content card-hoang-gia text-light p-2">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title font-co-phong fs-3 chu-vang-kim">
                        <i class="bi bi-box-seam me-2"></i>Tra Cứu Đơn Hàng (Không Cần Đăng Nhập)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-secondary mb-3">Dành cho khách mua nhanh: Nhập mã đơn hàng và số điện thoại người mua để kiểm tra tiến độ giao đa điểm & mã QR thiệp.</p>
                    <div class="mb-3">
                        <label class="form-label small">Mã tra cứu đơn hàng (VD: TT2026-8891)</label>
                        <input type="text" id="txtMaTraCuu" class="form-control bg-dark text-light border-secondary" placeholder="Nhập mã đơn..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">Số điện thoại đặt mua</label>
                        <input type="text" id="txtSdtTraCuu" class="form-control bg-dark text-light border-secondary" placeholder="0909..." />
                    </div>
                    <button type="button" class="btn btn-vang-kim w-100" onclick="traCuuDonHangGuest()">Kiểm Tra Ngay</button>
                    <div id="ketQuaTraCuuBox" class="mt-3 d-none p-3 rounded bg-dark border border-warning"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER CỔ PHONG -->
    <footer class="border-top border-secondary py-5 mt-5" style="background: #060B19;">
        <div class="container text-center">
            <h4 class="font-co-phong chu-vang-kim fs-2 mb-2">NGUYỆT CÁT – TINH HOA BÁNH TRUNG THU VIỆT</h4>
            <p class="text-secondary small mb-3">Đồ án ASP.NET Core MVC Chuyên Nghiệp • Kiến trúc 25 Bảng • Hỗ trợ Mua hàng Kép (Guest & Member)</p>
            <div class="small text-muted">&copy; 2026 Nguyệt Cát Mooncake. All rights reserved.</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>