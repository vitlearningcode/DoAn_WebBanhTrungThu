<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nguyệt Cát Nghệ Thuật Trung Thu 2026</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400..700;1,14..32,400..700&family=Lora:ital,wght@0,500..700;1,500..700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hieu-ung-ux.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- 1. THANH MENU ĐẦU TRANG & HOVER DROPDOWN MENU -->
    @await Html.PartialAsync("~/Views/Shared/ThanhPhan/_ThanhMenuDauTrang.cshtml")

    <!-- 2. NỘI DUNG TRANG CHÍNH -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- 3. VÙNG HIỂN THỊ THÔNG BÁO TOAST & NÚT NỔI TƯ VẤN QUÀ -->
    <div class="toast-container position-fixed bottom-0 start-0 p-0" style="z-index: 1090; bottom: 20px; left: 20px;" id="khungThongBaoToast"></div>

    <button type="button" id="nutNoiTuVanQua" class="floating-quiz-btn" data-bs-toggle="modal" data-bs-target="#modalTroLyChonBanh" aria-label="Tư Vấn Chọn Hộp Quà Hợp Ý">
        <span class="icon-trang-ram-tu-van" aria-hidden="true">🌕</span>
        <span class="chu-nut-tu-van">Tư Vấn Chọn Hộp Quà Hợp Ý</span>
    </button>

    <!-- 4. NGĂN KÉO GIỎ QUÀ TRUNG THU (OFFCANVAS 2 CỘT) -->
    @await Html.PartialAsync("~/Views/Shared/ThanhPhan/_NganKeoGioHang.cshtml")

    <!-- 5. CÁC MODAL DÙNG CHUNG (TÀI KHOẢN, TRA CỨU ĐƠN, TƯ VẤN CHỌN BÁNH) -->
    @await Html.PartialAsync("~/Views/Shared/ThanhPhan/_ModalTuVanVaTraCuu.cshtml")

    <!-- 6. FOOTER ĐỎ SƠN MÀI TRẦM TRUYỀN THỐNG -->
    <footer class="nen-le-hoi-son-mai border-top py-5 mt-0" style="border-color: rgba(212, 175, 55, 0.45) !important;">
        <div class="container">
            <div class="row g-4 align-items-center text-center text-md-start">
                <div class="col-md-7">
                    <h4 class="font-co-phong chu-vang-kim fs-2 fw-bold mb-2">
                        🏮 Nguyệt Cát – Đại Lý Phân Phối Bánh Trung Thu Chính Hãng (Kinh Đô • Đồng Khánh • Như Lan • Brodard)
                    </h4>
                    <p class="chu-kem-vang opacity-75 small mb-2">
                        Tinh hoa quà biếu Tết Đoàn Viên cổ truyền • Tự tay phối lễ hộp sơn mài độc bản • Dịch vụ ép kim logo doanh nghiệp &amp; giao quà biếu tặng kèm thiệp QR 3D.
                    </p>
                </div>
                <div class="col-md-5 text-md-end">
                    <div class="small chu-kem-vang mb-1">
                        <i class="bi bi-geo-alt-fill chu-vang-kim me-1"></i><strong>Địa chỉ:</strong> 128 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh
                    </div>
                    <div class="small chu-kem-vang mb-1">
                        <i class="bi bi-telephone-fill chu-vang-kim me-1"></i><strong>Hotline tư vấn &amp; đặt số lượng lớn:</strong> 1900 6886 – 0909 123 456
                    </div>
                    <div class="small chu-kem-vang">
                        <i class="bi bi-clock-fill chu-vang-kim me-1"></i><strong>Giờ mở cửa:</strong> 07:30 – 22:00 (Tất cả các ngày trong tuần)
                    </div>
                </div>
            </div>
            <hr class="my-3" style="border-color: rgba(212, 175, 55, 0.3);" />
            <div class="text-center small chu-kem-vang opacity-75">
                &copy; 2026 Nguyệt Cát – Nghệ Thuật Quà Tặng Trung Thu Truyền Thống Việt Nam.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/modules/cuon-fullpage.js" asp-append-version="true"></script>
    <script src="~/js/modules/studio-phoi-hop.js" asp-append-version="true"></script>
    <script src="~/js/modules/gio-hang-ajax.js" asp-append-version="true"></script>
    <script src="~/js/modules/tu-van-va-tien-ich.js" asp-append-version="true"></script>
    <script src="~/js/modules/kiem-tra-email-ux.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
